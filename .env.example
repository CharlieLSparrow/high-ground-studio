# Database
# Keep this local for Studio persistence smoke tests. The smoke script refuses
# non-local database hosts so it cannot accidentally write to remote Neon.
# Matches the local Postgres service in compose.studio.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/high_ground_studio"

# Google OAuth / NextAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_SECRET="replace-with-a-long-random-secret"
# Legacy fallback only. Current code prefers AUTH_SECRET and only checks this if AUTH_SECRET is unset.
# NEXTAUTH_SECRET="replace-with-the-same-long-random-secret"

# Role bootstrap email lists
# Comma-separated email lists. Leave blank if you do not want bootstrap role assignment.
HGO_OWNER_EMAILS="owner@example.com"
HGO_TEAM_SCHEDULER_EMAILS="scheduler@example.com"
HGO_COACH_EMAILS="coach@example.com"
PRIVATE_FICTION_OWNER_EMAILS="charlielsparrow@gmail.com"

# Admin control-plane allowlist (for /admin/* and bypass gates)
QUIPSLY_ADMIN_EMAILS="charlie@highgroundodyssey.com"
# HMAC key for short-lived release-smoke receipts. Use at least 32 random bytes,
# mount the same private value in Quipsly and the release operator environment,
# and never expose it through a NEXT_PUBLIC_* variable or command output.
QUIPSLY_RELEASE_SMOKE_SECRET=""

# Studio live MVP auth
# Use "database" locally when exercising Prisma-backed identity. Use
# "allowlist" for the first private Cloud Run MVP before Studio has a live
# database dependency.
STUDIO_AUTH_MODE="database"
STUDIO_ALLOWED_EMAILS="owner@example.com"

HGO_COACHING_DONATION_URL="https://buy.stripe.com/your-payment-link"
HGO_COMPANY_FAMILY_SUPPORT_URL="https://example.com/family-support"

# WorldHub provider readiness
# These are optional until you intentionally enable the corresponding adapter.
# The team WorldHub page stores only env-name readiness, never secret values.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_COACHING_PRICE_ID=""
STRIPE_SUPPORTER_PRICE_ID=""
STRIPE_SUCCESS_URL="http://localhost:3000/coaching/success"
STRIPE_CANCEL_URL="http://localhost:3000/coaching/cancel"

PATREON_CLIENT_ID=""
PATREON_CLIENT_SECRET=""
PATREON_WEBHOOK_SECRET=""
PATREON_CAMPAIGN_ID=""
PATREON_CREATOR_ACCESS_TOKEN=""

GOOGLE_CALENDAR_ID="primary"
COACHING_DEFAULT_TIMEZONE="America/Los_Angeles"
# Use either server-side service-account auth or an explicit calendar refresh token.
# Do not reuse sign-in OAuth secrets as calendar sync credentials.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_IMPERSONATION_EMAIL=""
GOOGLE_CALENDAR_SYNC_CLIENT_ID=""
GOOGLE_CALENDAR_SYNC_CLIENT_SECRET=""
# Optional: none, externalOnly, or all. Defaults to none.
GOOGLE_CALENDAR_SEND_UPDATES="none"
# Optional: set true only when you intentionally want Google to email attendees.
GOOGLE_CALENDAR_INCLUDE_ATTENDEES="false"
# Optional: local/dev credential path. Requires `gcloud auth application-default login`
# with Calendar scopes before read/write verification can work.
GOOGLE_CALENDAR_ALLOW_APPLICATION_DEFAULT="false"
# Optional: set false to prevent Cloud Run metadata-token fallback during calendar sync checks.
GOOGLE_CALENDAR_ALLOW_METADATA_TOKEN="true"

# LiveKit / Quipsly-owned in-app rooms
# These let Nest mint short-lived room join tokens. They do not mean native iOS
# media joining is ready until the LiveKit Swift SDK artifacts are repeatably
# available and linked into HighGroundCapture.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Server-side provider recording/egress is operator-gated. Set true only when
# explicit consent, visible recording state, and receipt handling are ready.
LIVEKIT_EGRESS_ENABLED="false"
LIVEKIT_EGRESS_GCS_BUCKET="high-ground-odyssey-media"
LIVEKIT_EGRESS_GCS_PREFIX="media-vault/recordings/livekit"

# Reef Ball visual research image bridge (used by /nests/marine-biology-research/visual-research)
REEFBALL_WORKBENCH_URL=""
REEFBALL_PUBLIC_MEDIA_BASE_URL=""

# Growth, SEO, analytics, ads, and affiliates
HGO_GA_MEASUREMENT_ID=""
GOOGLE_ANALYTICS_PROPERTY_ID=""
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=""
GOOGLE_ANALYTICS_REFRESH_TOKEN=""
GOOGLE_ANALYTICS_SYNC_CLIENT_ID=""
GOOGLE_ANALYTICS_SYNC_CLIENT_SECRET=""
GOOGLE_SEARCH_CONSOLE_SITE_URL=""
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=""
GOOGLE_SEARCH_CONSOLE_SYNC_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_SYNC_CLIENT_SECRET=""
GOOGLE_ADSENSE_CLIENT=""
GOOGLE_ADSENSE_ADS_TXT_ACCOUNT=""
GOOGLE_ADSENSE_ADS_TXT_AUTHORITY="f08c47fec0942fa0"
GOOGLE_ADSENSE_ADS_TXT_RELATIONSHIP="DIRECT"
HGO_ADSENSE_AUTO_ADS_ENABLED="0"
AMAZON_ASSOCIATES_TAG=""
BOOKSHOP_AFFILIATE_ID=""
HGO_AFFILIATE_DISCLOSURE_TEXT=""
HGO_SPONSOR_INQUIRY_URL=""
HGO_SPONSOR_MEDIA_KIT_URL=""

HGO_MERCH_PROVIDER=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN=""
FOURTHWALL_API_KEY=""
FOURTHWALL_SHOP_URL=""
PRINTFUL_API_KEY=""
PRINTFUL_STORE_ID=""
PRINTIFY_API_KEY=""
PRINTIFY_SHOP_ID=""
GELATO_API_KEY=""
GELATO_STORE_ID=""

# Email notifications
RESEND_API_KEY="re_placeholder"
HGO_EMAIL_FROM="High Ground Odyssey <support@example.com>"
RESEND_WEBHOOK_SECRET=""
HGO_SITE_URL="http://localhost:3000"

# Quipsly media vault / source recordings
# Production recording ingest requires this bucket to exist and the Cloud Run
# service account to have object create/read access. Current production policy
# uses one product media vault bucket plus prefixes:
#   media-vault/raw/...
#   media-vault/proxy/...
#   media-vault/thumb/...
#   media-vault/recordings/livekit/...
#   media-vault/recordings/mobile/...
#   media-vault/exports/...
# For High Ground production, use high-ground-odyssey-media.
QUIPSLY_MEDIA_BUCKET="high-ground-odyssey-media"
# Optional path-delimited allowlist for local-development ffmpeg extraction.
# Leave empty in production; released private-GCS media is the production path.
QUIPSLY_AUDIO_EXTRACTION_LOCAL_ROOTS=""
QUIPSLY_LOCAL_MEDIA_ROOTS=""

# Explicit development-only immutable Capture vault. Both values are required;
# production, a non-loopback DATABASE_URL, a non-loopback HTTP origin, or a root
# outside a dedicated OS-temporary subdirectory is rejected. Never configure
# these as a production storage substitute.
QUIPSLY_LOCAL_CAPTURE_VAULT_ROOT=""
QUIPSLY_LOCAL_CAPTURE_UPLOAD_ORIGIN=""
QUIPSLY_LOCAL_CAPTURE_VAULT_MAX_BYTES="268435456"
QUIPSLY_TRANSCRIPT_ASSIST_LOCAL_ROOTS=""
# Provider recording START is production-interlocked. This second flag is for
# explicit local integration tests only and must never be set in production.
LIVEKIT_EGRESS_UNSAFE_LOCAL_DEV="false"
# Local-only escape hatch for old upload UI experiments. Keep false/unset in
# shared, preview, and production environments so failed signed URLs fail loudly.
QUIPSLY_ALLOW_MOCK_UPLOADS="false"
# Legacy aliases still read by parts of the repo while the media stack converges.
HIGH_GROUND_MEDIA_BUCKET=""
GCS_BUCKET_NAME=""
NEXT_PUBLIC_GCS_BUCKET=""

# Content pipeline
# Optional transitional flag. Leave unset for the current guarded episodes-loader default.
# Set to 1 only when explicitly testing the Fumadocs-backed episodes source.
# ENABLE_EPISODES_FUMADOCS="1"

# Antigravity Data Ingestion API
ANTIGRAVITY_API_KEY="your-secure-random-string-here"
