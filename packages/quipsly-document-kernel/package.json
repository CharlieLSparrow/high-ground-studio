{
  "name": "@high-ground/quipsly-document-kernel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --experimental-strip-types --import ../../scripts/register-ts-extension-loader.mjs --test src/*.test.ts"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "25.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
