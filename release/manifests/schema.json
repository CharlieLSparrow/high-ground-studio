{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quipsly.com/schemas/release-manifest-v1.json",
  "title": "Quipsly release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "displayName",
    "ownerSurface",
    "status",
    "applicationRoot",
    "changeDetection",
    "artifact",
    "proofs",
    "delivery"
  ],
  "properties": {
    "$schema": {
      "const": "./schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "enum": ["capture", "nest", "hgo-web", "quipsly-studio", "quipsly-media-verifier"]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "ownerSurface": {
      "enum": ["capture", "nest", "hgo-web", "quipsly-studio", "quipsly-media-verifier"]
    },
    "status": {
      "enum": ["active", "operator-only"]
    },
    "applicationRoot": {
      "$ref": "#/$defs/repositoryPath"
    },
    "changeDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy", "validation", "schema"],
      "properties": {
        "deploy": {
          "$ref": "#/$defs/pathSet"
        },
        "validation": {
          "$ref": "#/$defs/pathSet"
        },
        "schema": {
          "$ref": "#/$defs/pathSet"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "sourceRevision",
        "materializer",
        "provenanceReceipt"
      ],
      "properties": {
        "kind": {
          "enum": ["ios-ipa", "cloud-run-image", "cloud-run-job-image", "macos-application"]
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "const": "git-commit-sha"
        },
        "materializer": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenanceReceipt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "deterministic",
        "localRuntime",
        "credentialedRuntime",
        "deliveryReadback"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/proofList"
        },
        "deterministic": {
          "$ref": "#/$defs/proofList"
        },
        "localRuntime": {
          "$ref": "#/$defs/proofList"
        },
        "credentialedRuntime": {
          "$ref": "#/$defs/proofList"
        },
        "deliveryReadback": {
          "$ref": "#/$defs/proofList"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "target", "promotion"],
      "properties": {
        "channel": {
          "enum": ["app-store-connect", "cloud-run", "cloud-run-job", "operator"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "promotion": {
          "enum": ["manual", "operator"]
        }
      }
    },
    "releaseContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMiB", "requiredPaths", "optionalPaths"],
      "properties": {
        "maxMiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requiredPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "optionalPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\*?\\[\\]{}]).+$"
    },
    "pathSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes", "files"],
      "properties": {
        "prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        }
      }
    },
    "proofList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
