{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "id": "quipsly-media-processor",
  "displayName": "Quipsly Capture Proxy Processor",
  "ownerSurface": "quipsly-media-processor",
  "status": "active",
  "applicationRoot": "apps/quipsly-media-processor",
  "changeDetection": {
    "deploy": {
      "prefixes": [
        "apps/quipsly-media-processor/",
        "packages/quipsly-media-processing/"
      ],
      "files": [
        ".dockerignore",
        ".gcloudignore",
        ".npmrc",
        "cloudbuild.quipsly-media-processor.yaml",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "release/manifests/quipsly-media-processor.json"
      ]
    },
    "validation": {
      "prefixes": [
        "scripts/quipsly-capture-proxy",
        "scripts/release/quipsly-media-processor"
      ],
      "files": []
    },
    "schema": {
      "prefixes": [],
      "files": []
    }
  },
  "artifact": {
    "kind": "cloud-run-job-image",
    "identifier": "us-central1-docker.pkg.dev/high-ground-odyssey/high-ground-studio/quipsly-media-processor",
    "sourceRevision": "git-commit-sha",
    "materializer": "scripts/release/materialize-release-context.sh",
    "provenanceReceipt": "quipsly-media-processor-source.json"
  },
  "proofs": {
    "source": [
      "scripts/release/quipsly-media-processor-context.test.sh"
    ],
    "deterministic": [
      "pnpm --filter quipsly-media-processor build",
      "pnpm quipsly:media-processor:test",
      "pnpm quipsly:media-processor:acceptance"
    ],
    "localRuntime": [
      "Run the real FFmpeg portrait-video acceptance and fault-injected immutable-storage worker tests."
    ],
    "credentialedRuntime": [
      "Run scripts/release/quipsly-media-processor-cloud-fixture.mjs against the exact deployed build and verify its generation-pinned source, queue, manifest, output, result, and create-once retry evidence.",
      "Verify one released video through the authorized Nest finalization and reconciliation boundary.",
      "Apply and read back managed-folder IAM plus no-override Cloud Run Jobs execution authority."
    ],
    "deliveryReadback": [
      "Read back job image digest, service account, resources, timeout, retries, environment, IAM, execution logs, and exact proxy evidence."
    ]
  },
  "delivery": {
    "channel": "cloud-run-job",
    "target": "high-ground-odyssey/us-central1/quipsly-media-processor",
    "promotion": "manual"
  },
  "releaseContext": {
    "maxMiB": 25,
    "requiredPaths": [
      ".dockerignore",
      ".gcloudignore",
      ".npmrc",
      "apps/quipsly-media-processor",
      "cloudbuild.quipsly-media-processor.yaml",
      "package.json",
      "packages/quipsly-media-processing",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "release/manifests/quipsly-media-processor.json",
      "release/manifests/schema.json"
    ],
    "optionalPaths": []
  }
}
