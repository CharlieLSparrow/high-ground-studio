// The canonical human/app identity record.
//
// Source of truth:
// This is the main "person in our system" row. It is not a provider-specific
// account table, and it is not a newsletter-only contact ledger. It is the
// app's primary human record.
//
// Best practice (the "textbook" version):
// One canonical person record, with adjacent tables for concerns that have
// different lifecycles.
//
// What we are doing instead (and why):
// Precisely that, but in a still-compact way. User is the human. UserEmail and
// UserRole absorb the first obvious splits. More identity siblings can arrive
// later when they earn their keep.
//
// Why the related tables exist:
// - aliases let one human have multiple emails without duplicate users
// - roles let one human carry multiple badges
// - clientProfile separates coaching/client metadata from core identity
//
// Future complexity wearing a fake mustache:
// "I am sure User can also directly be newsletter contact, auth method store,
// and machine principal if we just add enough columns." That way lies a very
// tired table and many haunted nulls.
//
// Signal to evolve it:
// When the same email address must exist as a human account, newsletter-only
// contact, or service-account owner with different lifecycle rules, the schema
// wants adjacent models, not a larger bucket.
//
// If ignored:
// The User table turns into a wagon piled with nullable flags, and one morning
// everyone discovers they have built a very advanced machine for being vaguely
// wrong.
//
// If you poke this with a stick:
// Changing primary email rules or collapsing aliases/roles into columns looks
// simple for about six minutes, after which the family tree catches fire.
model User {
  id                 String    @id @default(cuid())
  primaryEmail       String    @unique
  name               String?
  image              String?
  firebaseUid        String?   @unique
  newsletterOptIn    Boolean   @default(false)
  announcementsOptIn Boolean   @default(false)
  welcomeCompletedAt DateTime?
  isActive           Boolean   @default(true)
  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  quipslyNotes QuipslyNote[]

  aliases               UserEmail[]
  authIdentities        UserAuthIdentity[]
  roles                 UserRole[]
  clientProfile         ClientProfile?
  coachProfile          CoachProfile?          @relation("CoachProfileUser")
  memberships           Membership[]           @relation("MembershipUser")
  coachingFeatureGrants CoachingFeatureGrant[] @relation("CoachingFeatureGrantUser")
  weeklyCommitments     WeeklyCommitment[]     @relation("WeeklyCommitmentClient")

  clientAppointments                    Appointment[]                               @relation("AppointmentClient")
  coachAppointments                     Appointment[]                               @relation("AppointmentCoach")
  appointmentsCreated                   Appointment[]                               @relation("AppointmentCreatedBy")
  appointmentsUpdated                   Appointment[]                               @relation("AppointmentUpdatedBy")
  coachingRequests                      CoachingRequest[]                           @relation("CoachingRequestClient")
  assignedCoachingRequests              CoachingRequest[]                           @relation("CoachingRequestCoach")
  bookingHolds                          BookingHold[]                               @relation("BookingHoldClient")
  coachingBookingsAsClient              CoachingBooking[]                           @relation("CoachingBookingClient")
  coachingBookingsAsCoach               CoachingBooking[]                           @relation("CoachingBookingCoach")
  coachingBookingSeriesAsClient         CoachingBookingSeries[]                     @relation("CoachingBookingSeriesClient")
  coachingBookingSeriesAsCoach          CoachingBookingSeries[]                     @relation("CoachingBookingSeriesCoach")
  coachingBookingSeriesCreated          CoachingBookingSeries[]                     @relation("CoachingBookingSeriesCreatedBy")
  coachingSessionPreparationsAsClient   CoachingSessionPreparation[]                @relation("CoachingSessionPreparationClient")
  coachingSessionPreparationsAsCoach    CoachingSessionPreparation[]                @relation("CoachingSessionPreparationCoach")
  coachingSessionPreparationRevisions   CoachingSessionPreparationRevision[]        @relation("CoachingSessionPreparationRevisionActor")
  coachingFormTemplatesOwned            CoachingFormTemplate[]                      @relation("CoachingFormTemplateOwner")
  coachingFormTemplateVersionsCreated   CoachingFormTemplateVersion[]               @relation("CoachingFormTemplateVersionCreatedBy")
  coachingFormAssignmentsCreated        CoachingFormAssignment[]                    @relation("CoachingFormAssignmentAssignedBy")
  coachingFormAssignmentsReceived       CoachingFormAssignment[]                    @relation("CoachingFormAssignmentAssignedTo")
  coachingFormResponseRevisions         CoachingFormResponseRevision[]              @relation("CoachingFormResponseRevisionActor")
  coachingFormAutomationPoliciesOwned   CoachingFormAutomationPolicy[]              @relation("CoachingFormAutomationPolicyOwner")
  coachingFormAutomationPolicyRevisions CoachingFormAutomationPolicyRevision[]      @relation("CoachingFormAutomationPolicyRevisionActor")
  coachingFormAutomationOverrides       CoachingFormAutomationOverride[]            @relation("CoachingFormAutomationOverrideActor")
  coachingFormOutcomePromotions         CoachingFormOutcomePromotionReceipt[]       @relation("CoachingFormOutcomePromotionActor")
  coachingEngagementsCreated            CoachingEngagement[]                        @relation("CoachingEngagementCreatedBy")
  coachingEngagementsAsClient           CoachingEngagement[]                        @relation("CoachingEngagementPrimaryClient")
  coachingEngagementsAsCoach            CoachingEngagement[]                        @relation("CoachingEngagementPrimaryCoach")
  coachingEngagementMemberships         CoachingEngagementMember[]                  @relation("CoachingEngagementMemberUser")
  coachingEngagementMembersAdded        CoachingEngagementMember[]                  @relation("CoachingEngagementMemberAddedBy")
  coachingEngagementMembersRemoved      CoachingEngagementMember[]                  @relation("CoachingEngagementMemberRemovedBy")
  coachingEngagementAccessChanges       CoachingEngagementMember[]                  @relation("CoachingEngagementMemberAccessChangedBy")
  coachingEngagementInvitations         CoachingEngagementInvitation[]              @relation("CoachingEngagementInvitationUser")
  coachingEngagementInvitesCreated      CoachingEngagementInvitation[]              @relation("CoachingEngagementInvitationCreatedBy")
  coachingEngagementInvitesAccepted     CoachingEngagementInvitation[]              @relation("CoachingEngagementInvitationAcceptedBy")
