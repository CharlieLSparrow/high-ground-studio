// program. It records measurements and listen-required suggestions only; it
// never authorizes timeline edits, gain automation, or derivative promotion.
model StudioEpisodeAudioAnalysisReceipt {
  id                       String   @id @default(cuid())
  projectId                String
  episodeProductionId      String
  supersedesAnalysisId     String?
  actorUserId              String?
  actorEmail               String
  clientRequestId          String
  programFingerprintSha256 String
  algorithm                String
  configurationSha256      String
  inputSha256              String
  requestSha256            String
  inputJson                Json
  analysisJson             Json
  analyzedAt               DateTime
  createdAt                DateTime @default(now())

  project            StudioProject                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeProduction  StudioEpisodeProduction             @relation(fields: [episodeProductionId], references: [id], onDelete: Cascade)
  supersedesAnalysis StudioEpisodeAudioAnalysisReceipt?  @relation("StudioEpisodeAudioAnalysisSupersession", fields: [supersedesAnalysisId], references: [id], onDelete: Restrict)
  supersededBy       StudioEpisodeAudioAnalysisReceipt[] @relation("StudioEpisodeAudioAnalysisSupersession")
