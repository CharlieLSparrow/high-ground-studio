  annotation StudioSourceAnnotation @relation(fields: [annotationId], references: [id], onDelete: Restrict)
  project    StudioProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   StudioDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  block      StudioDocumentBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation("StudioSourceAnnotationUseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([annotationId, blockId, useKind])
  @@unique([createdByUserId, clientRequestId])
  @@index([documentId, createdAt])
  @@index([projectId, useKind, createdAt])
}

