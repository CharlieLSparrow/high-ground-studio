  ownerUserId String?
  title      String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User?                    @relation("StudioAssistantSessionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages StudioAssistantMessage[]
  actions  StudioAssistantAction[]

  @@index([projectId, ownerUserId, status])
