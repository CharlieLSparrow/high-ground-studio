  annotation StudioSourceAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  tag        StudioTag              @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([annotationId, tagId])
  @@index([tagId, createdAt])
