model CoachingBooking {
  id              String                @id @default(cuid())
  requestId       String?
  appointmentId   String?               @unique
  offeringId      String?
  clientUserId    String
  coachUserId     String?
  engagementId    String?
  seriesId        String?
  seriesSequence  Int?
  status          CoachingBookingStatus @default(REQUESTED)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  timezone        String                @default("America/Los_Angeles")
  paymentPolicy   CoachingPaymentPolicy @default(DONATION_SUPPORTED)
  paymentRecordId String?               @unique
  calendarEventId String?
  notes           String?
  metadataJson    Json                  @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  request                         CoachingRequest?                 @relation(fields: [requestId], references: [id], onDelete: SetNull)
  appointment                     Appointment?                     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  offering                        ServiceOffering?                 @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  clientUser                      User                             @relation("CoachingBookingClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  coachUser                       User?                            @relation("CoachingBookingCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  engagement                      CoachingEngagement?              @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  series                          CoachingBookingSeries?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  paymentRecord                   PaymentRecord?                   @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  hold                            BookingHold?
  callRoom                        CallRoom?
  notesLog                        CoachingNote[]
  actionItems                     ActionItem[]
  goals                           Goal[]
  checkoutSessionLedgers          StripeCheckoutSessionLedger[]
  calendarLinks                   CalendarEventLink[]
  sessionPreparation              CoachingSessionPreparation?
  coachingFormAssignments         CoachingFormAssignment[]
  coachingFormAutomationReceipts  CoachingFormAutomationReceipt[]
  coachingFormAutomationOverrides CoachingFormAutomationOverride[]

  @@unique([seriesId, seriesSequence])
  @@index([clientUserId, scheduledStart])
  @@index([coachUserId, scheduledStart])
  @@index([engagementId, scheduledStart])
  @@index([seriesId, scheduledStart])
  @@index([status, scheduledStart])
  @@index([requestId])
  @@index([offeringId])
}

// A finite coaching series is a scheduling promise, not a hidden recurrence
// rule. Every occurrence is still a normal CoachingBooking + CallRoom with its
// own consent, recording, transcript, edit, and follow-up state. The series
// records how those independently operable Sessions were created together.
model CoachingBookingSeries {
  id                  String                         @id @default(cuid())
  requestId           String                         @unique @db.Uuid
  clientUserId        String
  coachUserId         String
  engagementId        String
  offeringId          String?
  createdByUserId     String
  title               String
  timezone            String
  frequency           CoachingBookingSeriesFrequency
  intervalCount       Int                            @default(1)
  occurrenceCount     Int
  durationMinutes     Int
  firstScheduledStart DateTime
  lastScheduledStart  DateTime
  status              CoachingBookingSeriesStatus    @default(ACTIVE)
  metadataJson        Json                           @default("{}")
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  client     User               @relation("CoachingBookingSeriesClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  coach      User               @relation("CoachingBookingSeriesCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  engagement CoachingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  offering   ServiceOffering?   @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdBy  User               @relation("CoachingBookingSeriesCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bookings   CoachingBooking[]

  @@index([coachUserId, status, firstScheduledStart], map: "CoachBookingSeries_coach_status_start_idx")
  @@index([clientUserId, status, firstScheduledStart], map: "CoachBookingSeries_client_status_start_idx")
  @@index([engagementId, status, firstScheduledStart], map: "CoachBookingSeries_engagement_status_start_idx")
}

// One calm preparation surface belongs to one independently operable coaching
// Session. Client-shared answers and the assigned coach's private preparation
// live in separate mutation lanes so simultaneous edits cannot overwrite one
// another. Every save appends an intent-bound revision receipt.
model CoachingSessionPreparation {
  id                   String    @id @default(cuid())
  bookingId            String    @unique
  clientUserId         String
  coachUserId          String?
  revision             Int       @default(0)
  clientFocus          String?   @db.Text
  clientDesiredOutcome String?   @db.Text
  clientSuccessMeasure String?   @db.Text
  clientProgressScore  Int?
  clientUpdate         String?   @db.Text
  clientSubmittedAt    DateTime?
  coachPrivateNote     String?   @db.Text
  coachPreparedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  booking   CoachingBooking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client    User                                 @relation("CoachingSessionPreparationClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  coach     User?                                @relation("CoachingSessionPreparationCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  revisions CoachingSessionPreparationRevision[]

  @@index([clientUserId, updatedAt], map: "CoachSessionPrep_client_updated_idx")
  @@index([coachUserId, updatedAt], map: "CoachSessionPrep_coach_updated_idx")
}

model CoachingSessionPreparationRevision {
  id            String                         @id @default(cuid())
  requestId     String                         @unique @db.Uuid
  preparationId String
  actorUserId   String
  lane          CoachingSessionPreparationLane
  revision      Int
  inputSha256   String
  snapshotJson  Json
  createdAt     DateTime                       @default(now())

  preparation CoachingSessionPreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  actor       User                       @relation("CoachingSessionPreparationRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([preparationId, revision], map: "CoachSessionPrepRevision_prep_revision_key")
  @@index([actorUserId, createdAt], map: "CoachSessionPrepRevision_actor_created_idx")
}

// Reusable coaching forms are owned by one coach and published as immutable
// versions. An assignment always points at the exact published definition that
// the client received, so later template improvements never rewrite history.
model CoachingFormTemplate {
  id                String                     @id @default(cuid())
  ownerCoachUserId  String
  title             String
  description       String?                    @db.Text
  purpose           CoachingFormPurpose
  status            CoachingFormTemplateStatus @default(DRAFT)
  publishedRevision Int?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  owner              User                           @relation("CoachingFormTemplateOwner", fields: [ownerCoachUserId], references: [id], onDelete: Cascade)
  versions           CoachingFormTemplateVersion[]
  assignments        CoachingFormAssignment[]
  automationPolicies CoachingFormAutomationPolicy[]

  @@index([ownerCoachUserId, status, updatedAt], map: "CoachFormTemplate_owner_status_updated_idx")
  @@index([ownerCoachUserId, purpose, updatedAt], map: "CoachFormTemplate_owner_purpose_updated_idx")
}

model CoachingFormTemplateVersion {
  id               String   @id @default(cuid())
  requestId        String   @unique @db.Uuid
  templateId       String
  revision         Int
  definitionSha256 String
  inputSha256      String
  definitionJson   Json
  createdByUserId  String
  createdAt        DateTime @default(now())

  template                 CoachingFormTemplate            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy                User                            @relation("CoachingFormTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments              CoachingFormAssignment[]
  pinnedAutomationPolicies CoachingFormAutomationPolicy[]  @relation("CoachingFormAutomationPinnedVersion")
  automationReceipts       CoachingFormAutomationReceipt[]

  @@unique([templateId, revision], map: "CoachFormTemplateVersion_template_revision_key")
  @@unique([id, templateId], map: "CoachFormTemplateVersion_id_template_key")
  @@index([createdByUserId, createdAt], map: "CoachFormTemplateVersion_creator_created_idx")
}

// A form assignment is a private coaching artifact. It can belong to the
// durable relationship, one booking, and one Session, but none of those links
// broadens access beyond the assigned client and exact relationship coach.
model CoachingFormAssignment {
  id                      String                       @id @default(cuid())
  requestId               String                       @unique @db.Uuid
  inputSha256             String
  templateId              String
  templateVersionId       String
  engagementId            String
  bookingId               String?
  callRoomId              String?
  assignedByUserId        String
  assignedToUserId        String
  timing                  CoachingFormAssignmentTiming @default(ON_DEMAND)
  status                  CoachingFormAssignmentStatus @default(ASSIGNED)
  dueAt                   DateTime?
  startedAt               DateTime?
  submittedAt             DateTime?
  canceledAt              DateTime?
  currentResponseRevision Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  template          CoachingFormTemplate                  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   CoachingFormTemplateVersion           @relation(fields: [templateVersionId, templateId], references: [id, templateId], onDelete: Restrict)
  engagement        CoachingEngagement                    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  booking           CoachingBooking?                      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  callRoom          CallRoom?                             @relation(fields: [callRoomId], references: [id], onDelete: SetNull)
  assignedBy        User                                  @relation("CoachingFormAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedTo        User                                  @relation("CoachingFormAssignmentAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  responseRevisions CoachingFormResponseRevision[]
  automationReceipt CoachingFormAutomationReceipt?
  outcomePromotions CoachingFormOutcomePromotionReceipt[]

  @@index([assignedToUserId, status, dueAt], map: "CoachFormAssignment_recipient_status_due_idx")
  @@index([assignedByUserId, status, dueAt], map: "CoachFormAssignment_coach_status_due_idx")
  @@index([engagementId, status, updatedAt], map: "CoachFormAssignment_engagement_status_updated_idx")
  @@index([bookingId, status], map: "CoachFormAssignment_booking_status_idx")
  @@index([callRoomId, status], map: "CoachFormAssignment_room_status_idx")
}

// Every client save is an immutable, intent-bound revision. Draft saves and the
// final submission share one ledger, making offline retries and uncertain
// network outcomes observable without creating duplicate answers.
model CoachingFormResponseRevision {
  id           String                    @id @default(cuid())
  requestId    String                    @unique @db.Uuid
  assignmentId String
  actorUserId  String
  revision     Int
  state        CoachingFormResponseState
  inputSha256  String
  answersJson  Json
  submittedAt  DateTime?
  createdAt    DateTime                  @default(now())

  assignment        CoachingFormAssignment                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actor             User                                  @relation("CoachingFormResponseRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  outcomePromotions CoachingFormOutcomePromotionReceipt[]

  @@unique([assignmentId, revision], map: "CoachFormResponse_assignment_revision_key")
  @@index([actorUserId, createdAt], map: "CoachFormResponse_actor_created_idx")
}

// A coach opts one exact relationship into one understandable form rule. The
// current row is a fast projection; every change is retained as an immutable
// revision so pause/resume and timing edits remain explainable.
model CoachingFormAutomationPolicy {
  id                      String                             @id @default(cuid())
  ownerCoachUserId        String
  templateId              String
  pinnedTemplateVersionId String?
  engagementId            String
  trigger                 CoachingFormAutomationTrigger
  status                  CoachingFormAutomationPolicyStatus @default(ACTIVE)
  versionMode             CoachingFormAutomationVersionMode  @default(LATEST_PUBLISHED)
  releaseOffsetMinutes    Int
  dueOffsetMinutes        Int
  revision                Int                                @default(1)
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt

  owner                 User                                   @relation("CoachingFormAutomationPolicyOwner", fields: [ownerCoachUserId], references: [id], onDelete: Cascade)
  template              CoachingFormTemplate                   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pinnedTemplateVersion CoachingFormTemplateVersion?           @relation("CoachingFormAutomationPinnedVersion", fields: [pinnedTemplateVersionId, templateId], references: [id, templateId], onDelete: Restrict)
  engagement            CoachingEngagement                     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  revisions             CoachingFormAutomationPolicyRevision[]
  receipts              CoachingFormAutomationReceipt[]
  overrides             CoachingFormAutomationOverride[]

  @@unique([templateId, engagementId, trigger], map: "CoachFormAutomationPolicy_template_engagement_trigger_key")
  @@index([ownerCoachUserId, status, updatedAt], map: "CoachFormAutomationPolicy_owner_status_updated_idx")
  @@index([engagementId, status, trigger], map: "CoachFormAutomationPolicy_engagement_status_trigger_idx")
}

model CoachingFormAutomationPolicyRevision {
  id           String   @id @default(cuid())
  requestId    String   @unique @db.Uuid
  policyId     String
  revision     Int
  actorUserId  String
  inputSha256  String
  snapshotJson Json
  createdAt    DateTime @default(now())

  policy CoachingFormAutomationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actor  User                         @relation("CoachingFormAutomationPolicyRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([policyId, revision], map: "CoachFormAutomationPolicyRevision_policy_revision_key")
  @@index([actorUserId, createdAt], map: "CoachFormAutomationPolicyRevision_actor_created_idx")
}

// A receipt exists only after an assignment commits. The unique event key is
// the exactly-once boundary for concurrent page, worker, and retry execution.
model CoachingFormAutomationReceipt {
  id                String                        @id @default(cuid())
  policyId          String
  bookingId         String
  callRoomId        String?
  templateVersionId String
  assignmentId      String                        @unique
  trigger           CoachingFormAutomationTrigger
  eventKey          String
  eventAt           DateTime
  eligibleAt        DateTime
  dueAt             DateTime
  manualOverride    Boolean                       @default(false)
  createdAt         DateTime                      @default(now())

  policy          CoachingFormAutomationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  booking         CoachingBooking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  callRoom        CallRoom?                    @relation(fields: [callRoomId], references: [id], onDelete: SetNull)
  templateVersion CoachingFormTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignment      CoachingFormAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([policyId, eventKey], map: "CoachFormAutomationReceipt_policy_event_key")
  @@index([bookingId, trigger, createdAt], map: "CoachFormAutomationReceipt_booking_trigger_idx")
  @@index([policyId, createdAt], map: "CoachFormAutomationReceipt_policy_created_idx")
}

// Overrides are append-only. Reconciliation applies the latest request for a
// policy + booking; CLEAR intentionally restores ordinary policy behavior.
model CoachingFormAutomationOverride {
  id          String                               @id @default(cuid())
  requestId   String                               @unique @db.Uuid
  policyId    String
  bookingId   String
  actorUserId String
  action      CoachingFormAutomationOverrideAction
  inputSha256 String
  reason      String?                              @db.Text
  revision    Int
  createdAt   DateTime                             @default(now())

  policy  CoachingFormAutomationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  booking CoachingBooking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User                         @relation("CoachingFormAutomationOverrideActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([policyId, bookingId, revision], map: "CoachFormAutomationOverride_policy_booking_revision_key")
  @@index([policyId, bookingId, createdAt], map: "CoachFormAutomationOverride_policy_booking_created_idx")
  @@index([actorUserId, createdAt], map: "CoachFormAutomationOverride_actor_created_idx")
}

// Records where a note, task, or goal came from so people can understand and
// change AI- or human-created work without adding an approval workflow.
model CoachingFormOutcomePromotionReceipt {
  id                   String                  @id @default(cuid())
  requestId            String                  @unique @db.Uuid
  assignmentId         String
  responseRevisionId   String
  actorUserId          String
  kind                 CoachingFormOutcomeKind
  targetId             String
  inputSha256          String
  sourceSha256         String
  selectedFieldIdsJson Json                    @default("[]")
  sourceSnapshotJson   Json                    @default("{}")
  reviewedPayloadJson  Json                    @default("{}")
  removedAt            DateTime?
  removedByUserId      String?
  restoredAt           DateTime?
  createdAt            DateTime                @default(now())

  assignment       CoachingFormAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  responseRevision CoachingFormResponseRevision @relation(fields: [responseRevisionId], references: [id], onDelete: Cascade)
  actor            User                         @relation("CoachingFormOutcomePromotionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([kind, targetId], map: "CoachFormOutcomePromotion_kind_target_key")
  @@index([assignmentId, createdAt], map: "CoachFormOutcomePromotion_assignment_created_idx")
  @@index([responseRevisionId, createdAt], map: "CoachFormOutcomePromotion_response_created_idx")
  @@index([actorUserId, createdAt], map: "CoachFormOutcomePromotion_actor_created_idx")
  @@index([removedAt, createdAt], map: "CoachFormOutcomePromotion_removed_created_idx")
}

// A Coaching Engagement is the durable, private collaboration boundary for a
// coach/client relationship. It can use a Nest for shared tools and storage,
// but membership here never grants access to that surrounding Nest.
model CoachingEngagement {
  id                  String                   @id @default(cuid())
  projectId           String
  createdByUserId     String?
  primaryClientUserId String?
  primaryCoachUserId  String?
  title               String
  status              CoachingEngagementStatus @default(ACTIVE)
  metadataJson        Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  project                StudioProject                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy              User?                             @relation("CoachingEngagementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  primaryClient          User?                             @relation("CoachingEngagementPrimaryClient", fields: [primaryClientUserId], references: [id], onDelete: SetNull)
  primaryCoach           User?                             @relation("CoachingEngagementPrimaryCoach", fields: [primaryCoachUserId], references: [id], onDelete: SetNull)
  members                CoachingEngagementMember[]
  invitations            CoachingEngagementInvitation[]
  memberReceipts         CoachingEngagementMemberReceipt[]
  bookings               CoachingBooking[]
  bookingSeries          CoachingBookingSeries[]
  callRooms              CallRoom[]
  notes                  CoachingNote[]
  actionItems            ActionItem[]
  goals                  Goal[]
  formAssignments        CoachingFormAssignment[]
  formAutomationPolicies CoachingFormAutomationPolicy[]

  @@index([projectId, status, updatedAt])
  @@index([primaryClientUserId, status, updatedAt])
  @@index([primaryCoachUserId, status, updatedAt])
}

model CoachingEngagementMember {
  id                    String                         @id @default(cuid())
  engagementId          String
  userId                String
  role                  CoachingEngagementMemberRole
  status                CoachingEngagementMemberStatus @default(ACTIVE)
  addedByUserId         String?
  removedByUserId       String?
  joinedAt              DateTime                       @default(now())
  removedAt             DateTime?
  accessRevision        Int                            @default(0)
  accessChangedAt       DateTime?
  accessChangedByUserId String?
  metadataJson          Json                           @default("{}")
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  engagement      CoachingEngagement                @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user            User                              @relation("CoachingEngagementMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy         User?                             @relation("CoachingEngagementMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  removedBy       User?                             @relation("CoachingEngagementMemberRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)
  accessChangedBy User?                             @relation("CoachingEngagementMemberAccessChangedBy", fields: [accessChangedByUserId], references: [id], onDelete: SetNull)
  receipts        CoachingEngagementMemberReceipt[]

  @@unique([engagementId, userId])
  @@index([userId, status, updatedAt])
  @@index([engagementId, role, status])
}

model CoachingEngagementInvitation {
  id               String                             @id @default(cuid())
  engagementId     String
  invitedUserId    String
  invitedEmail     String
  role             CoachingEngagementMemberRole
  status           CoachingEngagementInvitationStatus @default(PENDING)
  tokenHash        String                             @unique
  expiresAt        DateTime
  invitedByUserId  String?
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  metadataJson     Json                               @default("{}")
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  engagement  CoachingEngagement                @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  invitedUser User                              @relation("CoachingEngagementInvitationUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User?                             @relation("CoachingEngagementInvitationCreatedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy  User?                             @relation("CoachingEngagementInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  receipts    CoachingEngagementMemberReceipt[]

  @@index([engagementId, status, createdAt])
  @@index([invitedUserId, status, expiresAt])
  @@index([invitedEmail, status, expiresAt])
}

model CoachingEngagementMemberReceipt {
  id             String                          @id @default(cuid())
  requestId      String                          @unique @db.Uuid
  engagementId   String
  memberId       String?
  invitationId   String?
  subjectUserId  String
  actorUserId    String?
  action         CoachingEngagementMemberAction
  roleBefore     CoachingEngagementMemberRole?
  roleAfter      CoachingEngagementMemberRole?
  statusBefore   CoachingEngagementMemberStatus?
  statusAfter    CoachingEngagementMemberStatus?
  accessRevision Int?
  reason         String?
  outcomeJson    Json                            @default("{}")
  createdAt      DateTime                        @default(now())

  engagement CoachingEngagement            @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  member     CoachingEngagementMember?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  invitation CoachingEngagementInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  subject    User                          @relation("CoachingEngagementMemberReceiptSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  actor      User?                         @relation("CoachingEngagementMemberReceiptActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([memberId, accessRevision])
  @@index([engagementId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([invitationId, createdAt])
}

model StripeCustomerLink {
  id               String   @id @default(cuid())
  userId           String
  stripeCustomerId String   @unique
  livemode         Boolean  @default(false)
  metadataJson     Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation("StripeCustomerLinkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([livemode, updatedAt])
}

model CalendarEventLink {
  id                 String    @id @default(cuid())
  bookingId          String?
  roomId             String?
  provider           String    @default("google")
  providerCalendarId String?
  providerEventId    String?
  status             String    @default("planned")
  title              String?
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  timezone           String    @default("America/Los_Angeles")
  htmlLink           String?
  conferenceDataJson Json      @default("{}")
  rawJson            Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  booking CoachingBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  room    CallRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([roomId, createdAt])
  @@index([provider, providerEventId])
  @@index([status, scheduledStart])
}

model CalendarConnection {
  id                 String                   @id @default(cuid())
  workspaceId        String?
  nestId             String?
  userId             String?
  provider           CalendarProvider
  connectionKind     CalendarConnectionKind
  providerAccountKey String?
  credentialRef      String?
  grantedScopes      String[]                 @default([])
  status             CalendarConnectionStatus @default(PENDING)
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  revokedAt          DateTime?
  metadataJson       Json                     @default("{}")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  workspace       StudioWorkspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nest            StudioProject?           @relation(fields: [nestId], references: [id], onDelete: Cascade)
  user            User?                    @relation("CalendarConnectionUser", fields: [userId], references: [id], onDelete: Cascade)
  collections     CalendarCollection[]
  receipts        CalendarSyncReceipt[]
  oauthCredential CalendarOAuthCredential?

  @@unique([provider, providerAccountKey])
  @@index([workspaceId, provider, status])
  @@index([nestId, provider, status])
  @@index([userId, provider, status])
  @@index([status, updatedAt])
}

model CalendarOAuthCredential {
  id                String   @id @default(cuid())
  connectionId      String   @unique
  encryptedPayload  String
  encryptionVersion String   @default("aes-256-gcm-v1")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model CalendarCollection {
  id                 String                       @id @default(cuid())
  connectionId       String?
  workspaceId        String?
  nestId             String?
  ownerUserId        String?
  purpose            CalendarCollectionPurpose
  displayName        String
  timezone           String                       @default("UTC")
  providerCalendarId String?
  visibility         CalendarCollectionVisibility @default(PRIVATE)
  isDefault          Boolean                      @default(false)
  status             CalendarCollectionStatus     @default(ACTIVE)
  liveUpdatesEnabled Boolean                      @default(false)
  metadataJson       Json                         @default("{}")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  connection           CalendarConnection?           @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  workspace            StudioWorkspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nest                 StudioProject?                @relation(fields: [nestId], references: [id], onDelete: Cascade)
  owner                User?                         @relation("CalendarCollectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  projections          CalendarProjection[]
  cursor               CalendarSyncCursor?
  receipts             CalendarSyncReceipt[]
  feeds                CalendarFeed[]
  notificationChannels CalendarNotificationChannel[]
  reconciliationWakes  CalendarReconciliationWake[]

  @@unique([connectionId, providerCalendarId])
  @@index([workspaceId, purpose, status])
  @@index([nestId, purpose, status])
  @@index([ownerUserId, purpose, status])
  @@index([connectionId, status])
  @@index([purpose, isDefault])
}

model CalendarNotificationChannel {
  id                 String                            @id @default(cuid())
  collectionId       String
  channelId          String                            @unique
  resourceId         String?
  tokenDigest        String
  status             CalendarNotificationChannelStatus @default(STARTING)
  expiresAt          DateTime?
  lastMessageNumber  String?
  lastResourceState  String?
  lastNotificationAt DateTime?
  stoppedAt          DateTime?
  metadataJson       Json                              @default("{}")
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  collection CalendarCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, status, expiresAt])
  @@index([status, expiresAt])
}

model CalendarReconciliationWake {
  id            String                           @id @default(cuid())
  collectionId  String
  activeKey     String?                          @unique
  status        CalendarReconciliationWakeStatus @default(QUEUED)
  reason        String
  attemptCount  Int                              @default(0)
  availableAt   DateTime                         @default(now())
  claimedAt     DateTime?
  completedAt   DateTime?
  lastErrorCode String?
  metadataJson  Json                             @default("{}")
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  collection CalendarCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([collectionId, createdAt])
}

model CalendarProjection {
  id                String                   @id @default(cuid())
  collectionId      String
  sourceType        String
  sourceId          String
  sourceRevision    String
  providerEventId   String?
  providerEtag      String?
  providerUpdatedAt DateTime?
  uid               String                   @unique
  sequence          Int                      @default(0)
  status            CalendarProjectionStatus @default(PLANNED)
  conflictState     CalendarConflictState    @default(NONE)
  lastSyncedAt      DateTime?
  metadataJson      Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  collection CalendarCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
