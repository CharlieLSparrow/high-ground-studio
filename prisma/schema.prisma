model BookingHold {
  id                 String            @id @default(cuid())
  offeringId         String?
  coachProfileId     String?
  clientUserId       String?
  contactEmail       String?
  scheduledStart     DateTime
  scheduledEnd       DateTime
  timezone           String            @default("America/Los_Angeles")
  status             BookingHoldStatus @default(ACTIVE)
