// The canonical human/app identity record.
//
// Source of truth:
// This is the main "person in our system" row. It is not a provider-specific
// account table, and it is not a newsletter-only contact ledger. It is the
// app's primary human record.
//
// Best practice (the "textbook" version):
// One canonical person record, with adjacent tables for concerns that have
// different lifecycles.
//
// What we are doing instead (and why):
// Precisely that, but in a still-compact way. User is the human. UserEmail and
// UserRole absorb the first obvious splits. More identity siblings can arrive
// later when they earn their keep.
//
// Why the related tables exist:
// - aliases let one human have multiple emails without duplicate users
// - roles let one human carry multiple badges
// - clientProfile separates coaching/client metadata from core identity
//
// Future complexity wearing a fake mustache:
// "I am sure User can also directly be newsletter contact, auth method store,
// and machine principal if we just add enough columns." That way lies a very
// tired table and many haunted nulls.
//
// Signal to evolve it:
// When the same email address must exist as a human account, newsletter-only
// contact, or service-account owner with different lifecycle rules, the schema
// wants adjacent models, not a larger bucket.
//
// If ignored:
// The User table turns into a wagon piled with nullable flags, and one morning
// everyone discovers they have built a very advanced machine for being vaguely
// wrong.
//
// If you poke this with a stick:
// Changing primary email rules or collapsing aliases/roles into columns looks
// simple for about six minutes, after which the family tree catches fire.
model User {
  id                 String    @id @default(cuid())
  primaryEmail       String    @unique
  name               String?
  image              String?
  firebaseUid        String?   @unique
  newsletterOptIn    Boolean   @default(false)
  announcementsOptIn Boolean   @default(false)
  welcomeCompletedAt DateTime?
  isActive           Boolean   @default(true)
  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  quipslyNotes QuipslyNote[]

  aliases               UserEmail[]
  authIdentities        UserAuthIdentity[]
  roles                 UserRole[]
  clientProfile         ClientProfile?
  coachProfile          CoachProfile?          @relation("CoachProfileUser")
  memberships           Membership[]           @relation("MembershipUser")
  coachingFeatureGrants CoachingFeatureGrant[] @relation("CoachingFeatureGrantUser")
  weeklyCommitments     WeeklyCommitment[]     @relation("WeeklyCommitmentClient")

  clientAppointments               Appointment[]                               @relation("AppointmentClient")
  coachAppointments                Appointment[]                               @relation("AppointmentCoach")
  appointmentsCreated              Appointment[]                               @relation("AppointmentCreatedBy")
  appointmentsUpdated              Appointment[]                               @relation("AppointmentUpdatedBy")
  coachingRequests                 CoachingRequest[]                           @relation("CoachingRequestClient")
  assignedCoachingRequests         CoachingRequest[]                           @relation("CoachingRequestCoach")
  bookingHolds                     BookingHold[]                               @relation("BookingHoldClient")
  coachingBookingsAsClient         CoachingBooking[]                           @relation("CoachingBookingClient")
  coachingBookingsAsCoach          CoachingBooking[]                           @relation("CoachingBookingCoach")
  coachingEngagementsCreated       CoachingEngagement[]                        @relation("CoachingEngagementCreatedBy")
  coachingEngagementsAsClient      CoachingEngagement[]                        @relation("CoachingEngagementPrimaryClient")
  coachingEngagementsAsCoach       CoachingEngagement[]                        @relation("CoachingEngagementPrimaryCoach")
  coachingEngagementMemberships    CoachingEngagementMember[]                  @relation("CoachingEngagementMemberUser")
  coachingEngagementMembersAdded   CoachingEngagementMember[]                  @relation("CoachingEngagementMemberAddedBy")
  coachingEngagementMembersRemoved CoachingEngagementMember[]                  @relation("CoachingEngagementMemberRemovedBy")
  stripeCustomerLinks              StripeCustomerLink[]                        @relation("StripeCustomerLinkUser")
  paymentRecords                   PaymentRecord[]                             @relation("PaymentRecordUser")
  callRoomsCreated                 CallRoom[]                                  @relation("CallRoomCreatedBy")
  callParticipants                 CallParticipant[]                           @relation("CallParticipantUser")
  callParticipantAccessChanges     CallParticipant[]                           @relation("CallParticipantAccessChangedBy")
  callParticipantAccessReceipts    CallParticipantAccessReceipt[]              @relation("CallParticipantAccessReceiptActor")
  callRoomInvitationsCreated       CallRoomInvitation[]                        @relation("CallRoomInvitationCreatedBy")
  callRoomInvitationsAccepted      CallRoomInvitation[]                        @relation("CallRoomInvitationAcceptedBy")
  recordingConsents                RecordingConsent[]                          @relation("RecordingConsentUser")
  coachingNotesAuthored            CoachingNote[]                              @relation("CoachingNoteAuthor")
  coachingNoteRevisionsAuthored    CoachingNoteRevision[]                      @relation("CoachingNoteRevisionActor")
  coachingNoteTagsCreated          CoachingNoteTagLink[]                       @relation("CoachingNoteTagCreatedBy")
  sessionOutputsCreated            SessionOutput[]                             @relation("SessionOutputCreatedBy")
  sessionOutputsReceived           SessionOutput[]                             @relation("SessionOutputRecipient")
  sessionOutputRevisions           SessionOutputRevision[]                     @relation("SessionOutputRevisionActor")
  deliveryEventsActed              DeliveryEvent[]                             @relation("DeliveryEventActor")
  deliveryEventsReceived           DeliveryEvent[]                             @relation("DeliveryEventRecipient")
  documentTagsCreated              StudioDocumentTagLink[]                     @relation("StudioDocumentTagCreatedBy")
  personalWritingDocuments         StudioDocument[]                            @relation("StudioDocumentPersonalOwner")
  actionItemsAssigned              ActionItem[]                                @relation("ActionItemAssignedTo")
  taskEvidenceAuthored             ActionItemEvidenceReceipt[]                 @relation("ActionItemEvidenceActor")
  taskReminders                    TaskReminder[]                              @relation("TaskReminderOwner")
  taskReminderRevisionsAuthored    TaskReminderRevision[]                      @relation("TaskReminderRevisionActor")
  calendarConnections              CalendarConnection[]                        @relation("CalendarConnectionUser")
  calendarCollectionsOwned         CalendarCollection[]                        @relation("CalendarCollectionOwner")
  calendarSyncReceiptsActed        CalendarSyncReceipt[]                       @relation("CalendarSyncReceiptActor")
  calendarFeedsOwned               CalendarFeed[]                              @relation("CalendarFeedOwner")
  goalsOwned                       Goal[]                                      @relation("GoalOwner")
  goalTaskLinksCreated             GoalTaskLink[]                              @relation("GoalTaskLinkCreatedBy")
  goalProgressAuthored             GoalProgressReceipt[]                       @relation("GoalProgressActor")
  actionItemTagsCreated            ActionItemTagLink[]                         @relation("ActionItemTagCreatedBy")
  goalTagsCreated                  GoalTagLink[]                               @relation("GoalTagCreatedBy")
  callRoomTagsCreated              CallRoomTagLink[]                           @relation("CallRoomTagCreatedBy")
  workPlanBlocks                   WorkPlanBlock[]                             @relation("WorkPlanBlockOwner")
  taskRecurrenceSeries             TaskRecurrenceSeries[]                      @relation("TaskRecurrenceOwner")
  episodeMilestonesAssigned        StudioEpisodeMilestone[]                    @relation("StudioEpisodeMilestoneAssignee")
  episodeMilestonesCreated         StudioEpisodeMilestone[]                    @relation("StudioEpisodeMilestoneCreatedBy")
  episodeMilestoneRevisions        StudioEpisodeMilestoneRevision[]            @relation("StudioEpisodeMilestoneRevisionActor")
  sourceAnnotationsCreated         StudioSourceAnnotation[]                    @relation("StudioSourceAnnotationCreatedBy")
  sourceAnnotationRevisions        StudioSourceAnnotationRevision[]            @relation("StudioSourceAnnotationRevisionActor")
  sourceAnnotationUsesCreated      StudioSourceAnnotationUse[]                 @relation("StudioSourceAnnotationUseCreatedBy")
  personalSourceCapturesCreated    StudioPersonalSourceCaptureReceipt[]        @relation("StudioPersonalSourceCaptureCreatedBy")
  personalSourceFilingsCreated     StudioPersonalSourceFiling[]                @relation("StudioPersonalSourceFilingCreatedBy")
  transcriptCorrectionsCreated     TranscriptCorrection[]                      @relation("TranscriptCorrectionCreatedBy")
  transcriptCorrectionsReviewed    TranscriptCorrection[]                      @relation("TranscriptCorrectionReviewedBy")
  transcriptCorrectionRevisions    TranscriptCorrectionRevision[]              @relation("TranscriptCorrectionRevisionActor")
  transcriptSegmentsVerified       TranscriptSegmentVerification[]             @relation("TranscriptSegmentVerificationReviewer")
  transcriptSpeakerAttributions    TranscriptSpeakerAttribution[]              @relation("TranscriptSpeakerAttributionReviewer")
  transcriptEvaluationWindows      TranscriptEvaluationWindow[]                @relation("TranscriptEvaluationWindowApprover")
  transcriptEvaluationCandidates   TranscriptEvaluationCandidate[]             @relation("TranscriptEvaluationCandidateSubmitter")
  transcriptProviderPolicies       TranscriptProviderPolicyReceipt[]           @relation("TranscriptProviderPolicyCapturer")
  transcriptEvaluationCorrections  TranscriptEvaluationCorrectionObservation[] @relation("TranscriptEvaluationCorrectionReviewer")
  companySupportRequests           CompanySupportRequest[]
  storyDraftsCreated               StoryDraft[]                                @relation("StoryDraftCreatedBy")
  storyDraftsUpdated               StoryDraft[]                                @relation("StoryDraftUpdatedBy")
  storyDraftsReviewed              StoryDraft[]                                @relation("StoryDraftReviewedBy")

  membershipsGranted           Membership[]           @relation("MembershipGrantedBy")
  coachingFeatureGrantsGranted CoachingFeatureGrant[] @relation("CoachingFeatureGrantGrantedBy")
  weeklyCommitmentsReviewed    WeeklyCommitment[]     @relation("WeeklyCommitmentReviewedBy")

  collections                      Collection[]
  snippets                         Snippet[]
  bookmarks                        Bookmark[]
  quipStreamSessions               QuipStreamSession[]
  socialAccounts                   SocialAccount[]
  marketingFunnels                 MarketingFunnel[]
  marketingPersonas                MarketingPersona[]
  landingPages                     LandingPage[]
  emailSequences                   EmailSequence[]
  marketingLeads                   MarketingLead[]
  marketingCampaigns               MarketingCampaign[]
  organizationMemberships          OrganizationMember[]
  studioProjectAccessGrantsCreated StudioProjectAccessGrant[]   @relation("StudioProjectAccessGrantCreatedBy")
  nativeAuthCodes                  StudioNativeAuthCode[]
  nativeDeviceSessions             StudioNativeDeviceSession[]
  feedbackTickets                  FeedbackTicket[]
  userEvents                       UserEvent[]
  accountDeletionRequests          UserAccountDeletionRequest[] @relation("UserAccountDeletionRequestUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserAccountDeletionRequest {
  id                   String                           @id @default(cuid())
  userId               String?
  emailSnapshot        String?
  status               UserAccountDeletionRequestStatus @default(REQUESTED)
  reason               String?
  source               String                           @default("unknown")
  requestedAt          DateTime                         @default(now())
  reviewedAt           DateTime?
  executionStartedAt   DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  canceledAt           DateTime?
  executionReceiptJson Json?
  lastFailureJson      Json?
  metadataJson         Json                             @default("{}")
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  user       User?                          @relation("UserAccountDeletionRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  executions UserAccountDeletionExecution[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model UserAccountDeletionExecution {
  id              String                             @id @default(cuid())
  requestId       String
  idempotencyKey  String                             @unique
  status          UserAccountDeletionExecutionStatus @default(RUNNING)
  executorVersion String
  policyVersion   String
  inventoryJson   Json
  planJson        Json
  progressJson    Json                               @default("{}")
  receiptJson     Json?
  failureJson     Json?
  startedAt       DateTime                           @default(now())
  finishedAt      DateTime?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  request UserAccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, startedAt])
  @@index([status, startedAt])
}

// Alternate or secondary email addresses linked to the same human.
// This keeps "same person, different address" from turning into "two users who
// now require a summit meeting."
model UserEmail {
  id        String   @id @default(cuid())
  userId    String
  email     String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Authentication subjects are credentials, not people. One Quipsly person can
// deliberately prove several Google, Apple, or recovery identities without
// duplicating their notes, Nests, tasks, or projects. `authority` identifies
// the issuer boundary and `subject` is the immutable identifier asserted by
// that authority (for Firebase, the UID).
model UserAuthIdentity {
  id              String    @id @default(cuid())
  userId          String
  authority       String
  subject         String
  provider        String?
  emailAtLink     String?
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([authority, subject])
  @@index([userId])
  @@index([emailAtLink])
}

// Separate role rows mean a user can hold several badges at once without
// encoding that fact into brittle booleans like `isCoachAndMaybeScheduler`.
//
// Best practice (the "textbook" version):
// Model many-to-many-ish grants as rows, not boolean confetti.
// Signal to evolve it:
// If roles start needing scopes, grant reasons, expirations, or audit history,
// the disguise comes off and this simple join table grows into a richer grant
// model.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      AppRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model StudioNativeAuthCode {
  id             String    @id @default(cuid())
  codeHash       String    @unique
  userId         String
  callbackScheme String
  state          String?
  deviceLabel    String?
  metadataJson   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StudioNativeDeviceSession {
  id               String    @id @default(cuid())
  userId           String
  deviceLabel      String?
  refreshTokenHash String    @unique
  metadataJson     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Client-specific domain data hangs off User rather than bloating the base
// identity record. Not every human in the system is necessarily a client.
model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MembershipPlan is the product catalog layer: what kinds of memberships exist
// in principle, independent of which user currently has one.
//
// Right now, this is a small internal product catalog.
// In a more mature system, plans might gain external billing identifiers,
// archival states, or country/currency rules.
// We are NOT doing that yet because memberships are still manual/internal and
// Stripe is intentionally quarantined.
model MembershipPlan {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String?
  priceCents            Int?
  billingIntervalMonths Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  memberships Membership[]
}

// Membership is the actual grant of a plan to a user.
//
// Why separate plan vs membership:
// One table describes the offer. The other records who has it, when it starts,
// when it ends, and who granted it. Catalog vs instance. Menu vs meal.
//
// Best practice (the "textbook" version):
// Separate product definition from user entitlement. Always.
//
// Future complexity wearing a fake mustache:
// "I am just a status field." Later someone wants pause reasons, billing
// handoff state, change history, and entitlement windows. That is where you
// decide whether membership state deserves a richer event trail.
model Membership {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  status          MembershipStatus @default(ACTIVE)
  startsAt        DateTime         @default(now())
  endsAt          DateTime?
  grantedByUserId String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user      User                @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  plan      MembershipPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  grantedBy User?               @relation("MembershipGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  ledgers   EntitlementLedger[]

  @@index([userId, status])
  @@index([planId])
}

