enum StudioAudibleEventTruthVerdict {
  POSITIVE
  ABSENT
}

enum StudioAudibleEventTruthWorkload {
  PODCAST
  COACHING
}

enum StudioAudibleEventTruthSplit {
  CALIBRATION
  VALIDATION
  RETAINED_CHALLENGE
}

// Independent playback-reviewed ground truth for detector qualification.
// A positive identifies an exact audible event inside a fully reviewed window;
// an absent receipt asserts only that one named classification is absent from
// that exact window. Unlabeled time is never negative evidence.
model StudioAudibleEventTruthReceipt {
  id                          String                          @id @default(cuid())
  projectId                   String
  assetId                     String
  sourceId                    String
  actorUserId                 String?
  actorEmail                  String
  clientRequestId             String
  supersedesReceiptId         String?                         @unique(map: "StudioAudibleEventTruth_supersedes_key")
  verdict                     StudioAudibleEventTruthVerdict
  workload                    StudioAudibleEventTruthWorkload
  split                       StudioAudibleEventTruthSplit
  classificationIdentifier    String
  displayLabel                String
  family                      String
  detectorAnalysisId          String
  detectorAlgorithm           String
  classifierIdentifier        String
  detectorConfigurationSha256 String
  sourceSha256                String
  sourceGeneration            String
  sourceDurationSeconds       Float
  reviewStartSeconds          Float
  reviewEndSeconds            Float
  eventStartSeconds           Float?
  eventEndSeconds             Float?
  requestSha256               String
  analysisJson                Json
  evidenceJson                Json
  note                        String
  occurredAt                  DateTime                        @default(now())
  createdAt                   DateTime                        @default(now())

  project StudioProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   StudioMediaAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source  StudioVideoSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([projectId, actorEmail, clientRequestId], map: "StudioAudibleEventTruth_project_actor_request_key")
  @@index([projectId, classificationIdentifier, occurredAt], map: "StudioAudibleEventTruth_project_class_idx")
  @@index([sourceId, classificationIdentifier, occurredAt], map: "StudioAudibleEventTruth_source_class_idx")
  @@index([detectorAnalysisId, occurredAt], map: "StudioAudibleEventTruth_analysis_idx")
}

model StudioSourceUnit {
  id             String    @id @default(cuid())
  projectId      String
  documentId     String?
  assetId        String?
  slug           String
  kind           String
  title          String
  sourceUrl      String?
  sourcePath     String?
  author         String?
  capturedAt     DateTime?
  immutableText  String?
  editableNotes  String?
  metadataJson   Json      @default("{}")
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project                   StudioProject                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document                  StudioDocument?                  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  asset                     StudioMediaAsset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  annotations               StudioSourceAnnotation[]
  personalSourceFiling      StudioPersonalSourceFiling?
  externalMediaReferences   StudioExternalMediaReference[]
  mediaSourceRevisions      StudioMediaSourceRevision[]
  externalMediaLibraryItems StudioExternalMediaLibraryItem[]

  @@unique([projectId, slug])
  @@index([projectId, kind])
  @@index([documentId])
  @@index([assetId])
}

// A creator-owned connection to an external media vault. Provider credentials
// are isolated in the one-to-one credential row; this projection contains only
// account identity, granted capability, and health metadata safe for server
// authorization decisions.
model StudioMediaProviderConnection {
  id                 String    @id @default(cuid())
  userId             String
  provider           String
  providerAccountKey String
  accountLabel       String?
  connectionKind     String    @default("user-oauth")
  grantedScopes      String[]  @default([])
  status             String    @default("pending")
  revision           Int       @default(1)
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  revokedAt          DateTime?
  metadataJson       Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User                                     @relation("StudioMediaProviderConnectionUser", fields: [userId], references: [id], onDelete: Cascade)
  credential         StudioMediaProviderCredential?
  externalReferences StudioExternalMediaReference[]
  externalLibraries  StudioExternalMediaLibrary[]
  operations         StudioMediaProviderConnectionOperation[]

  @@unique([provider, providerAccountKey])
  @@index([userId, provider, status])
  @@index([status, updatedAt])
}

model StudioMediaProviderCredential {
  id                String   @id @default(cuid())
  connectionId      String   @unique
  encryptedPayload  String
  encryptionVersion String   @default("aes-256-gcm-v1")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection StudioMediaProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

// Connection changes are append-only so reconnect, revocation, and scope
// changes remain explainable without retaining any token in the receipt.
model StudioMediaProviderConnectionOperation {
  id               String   @id @default(cuid())
  connectionId     String
  revision         Int
  previousRevision Int
  operation        String
  outcome          String
  actorUserId      String
  clientRequestId  String
  requestSha256    String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  connection StudioMediaProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  actor      User                          @relation("StudioMediaProviderConnectionOperationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([connectionId, revision])
  @@unique([connectionId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// A provider-neutral pointer to media that remains in a creator-controlled
// vault. Provider locator details are server-only; shared clients receive the
// capability state and durable Quipsly identity, never a bearer credential.
model StudioExternalMediaReference {
  id                     String    @id @default(cuid())
  projectId              String
  sourceUnitId           String?
  connectionId           String?
  provider               String
  connectionKey          String?
  externalFileId         String
  sharedDriveId          String?
  fileName               String
  mimeType               String?
  sizeBytes              BigInt?
  headRevisionKey        String?
  checksumSha256         String?
  providerCreatedAt      DateTime?
  providerModifiedAt     DateTime?
  accessState            String    @default("unverified")
  capabilityState        String    @default("unknown")
  providerLocatorJson    Json      @default("{}")
  capabilitySnapshotJson Json      @default("{}")
  lastVerifiedAt         DateTime?
  importedByUserId       String
  importedByEmail        String
  clientRequestId        String
  revision               Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project         StudioProject                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUnit      StudioSourceUnit?                       @relation(fields: [sourceUnitId], references: [id], onDelete: SetNull)
  connection      StudioMediaProviderConnection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  importedBy      User                                    @relation("StudioExternalMediaReferenceImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict)
  revisions       StudioMediaSourceRevision[]
  operations      StudioExternalMediaReferenceOperation[]
  collectionItems StudioSourceCollectionItem[]
  libraryItems    StudioExternalMediaLibraryItem[]

  @@unique([projectId, provider, externalFileId])
  @@unique([projectId, importedByUserId, clientRequestId])
  @@index([projectId, accessState, updatedAt])
  @@index([sourceUnitId])
  @@index([connectionId])
  @@index([connectionKey, provider])
}

// A followed folder is a durable, provider-neutral intake boundary. Its
// provider locator remains server-only; shared clients receive a safe inventory
// summary and can reason about new, incomplete, or no-longer-observed media
// without treating one provider listing as authority to delete source history.
model StudioExternalMediaLibrary {
  id                         String   @id @default(cuid())
  projectId                  String
  connectionId               String?
  provider                   String
  externalRootId             String
  sharedDriveId              String?
  name                       String
  status                     String   @default("ready")
  revision                   Int      @default(1)
  inventoryFingerprintSha256 String
  totalFileCount             Int      @default(0)
  totalSizeBytes             BigInt   @default(0)
  readySegmentCount          Int      @default(0)
  heldSegmentCount           Int      @default(0)
  providerLocatorJson        Json     @default("{}")
  healthJson                 Json     @default("{}")
  lastCheckedAt              DateTime
  lastSuccessfulRefreshAt    DateTime
  clientRequestId            String
  createdByUserId            String
  createdByEmail             String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project    StudioProject                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection StudioMediaProviderConnection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdBy  User                                  @relation("StudioExternalMediaLibraryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items      StudioExternalMediaLibraryItem[]
  operations StudioExternalMediaLibraryOperation[]

  @@unique([projectId, provider, externalRootId])
  @@unique([projectId, createdByUserId, clientRequestId], map: "StudioExternalMediaLibrary_project_actor_request_key")
  @@index([projectId, status, updatedAt])
  @@index([connectionId, status, updatedAt])
}

// Current observation projection for every object visible beneath a followed
// library root, including unrecognized files. `not-observed` is deliberately
// reversible and never deletes the canonical reference, revision, card, or
// board history associated with an earlier observation.
model StudioExternalMediaLibraryItem {
  id                      String   @id @default(cuid())
  libraryId               String
  externalFileId          String
  sourceUnitId            String?
  externalReferenceId     String?
  fileName                String
  observedRevisionKey     String?
  sizeBytes               BigInt?
  state                   String   @default("present")
  missingObservationCount Int      @default(0)
  firstObservedAt         DateTime @default(now())
  lastObservedAt          DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  library           StudioExternalMediaLibrary    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  sourceUnit        StudioSourceUnit?             @relation(fields: [sourceUnitId], references: [id], onDelete: SetNull)
  externalReference StudioExternalMediaReference? @relation(fields: [externalReferenceId], references: [id], onDelete: SetNull)

  @@unique([libraryId, externalFileId])
  @@index([libraryId, state, updatedAt])
  @@index([sourceUnitId])
  @@index([externalReferenceId])
}

// Attach and refresh receipts contain safe counts and fingerprints rather than
// provider object IDs. They make inventory changes explainable and replayable
// without leaking Drive locators into collaborative API responses.
model StudioExternalMediaLibraryOperation {
  id                         String   @id @default(cuid())
  libraryId                  String
  revision                   Int
  previousRevision           Int
  operation                  String
  outcome                    String
  actorUserId                String
  clientRequestId            String
  requestSha256              String
  inventoryFingerprintSha256 String
  snapshotJson               Json
  createdAt                  DateTime @default(now())

  library StudioExternalMediaLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  actor   User                       @relation("StudioExternalMediaLibraryOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([libraryId, revision])
  @@unique([libraryId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// Append-only provider inspection and attachment receipts. The reference row
// is the current capability projection; this ledger preserves how it changed.
model StudioExternalMediaReferenceOperation {
  id               String   @id @default(cuid())
  referenceId      String
  revision         Int
  previousRevision Int
  operation        String
  actorUserId      String
  clientRequestId  String
  requestSha256    String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  reference StudioExternalMediaReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  actor     User                         @relation("StudioExternalMediaReferenceOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([referenceId, actorUserId, clientRequestId])
  @@index([referenceId, revision])
  @@index([actorUserId, createdAt])
}

// Immutable byte/revision identity used by ranges and render manifests. A
// revision may resolve to an external vault object, an existing Quipsly media
// asset, or both; changing provider metadata creates another revision row.
model StudioMediaSourceRevision {
  id                  String    @id @default(cuid())
  projectId           String
  externalReferenceId String?
  mediaAssetId        String?
  sourceUnitId        String?
  revisionKey         String
  identitySha256      String
  contentSha256       String?
  sizeBytes           BigInt?
  durationSeconds     Float?
  widthPixels         Int?
  heightPixels        Int?
  framesPerSecond     Float?
  mediaProjection     String    @default("flat")
  projectionJson      Json      @default("{}")
  sourceState         String    @default("available")
  providerModifiedAt  DateTime?
  verifiedAt          DateTime?
  verificationJson    Json      @default("{}")
  provenanceJson      Json      @default("{}")
  createdByUserId     String
  createdAt           DateTime  @default(now())

  project            StudioProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalReference  StudioExternalMediaReference? @relation(fields: [externalReferenceId], references: [id], onDelete: Restrict)
  mediaAsset         StudioMediaAsset?             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sourceUnit         StudioSourceUnit?             @relation(fields: [sourceUnitId], references: [id], onDelete: SetNull)
  createdBy          User                          @relation("StudioMediaSourceRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  ranges             StudioSourceRange[]
  derivatives        StudioMediaDerivative[]
  replicas           StudioMediaSourceReplica[]
  sourceSetMembers   StudioMediaSourceSetMember[]  @relation("StudioMediaSourceSetMemberRevision")
  clockForSourceSets StudioMediaSourceSet[]        @relation("StudioMediaSourceSetClockRevision")

  @@unique([projectId, identitySha256])
  @@unique([externalReferenceId, revisionKey])
  @@index([projectId, sourceState, createdAt])
  @@index([mediaAssetId, createdAt])
  @@index([sourceUnitId])
}

// One immutable logical camera take may require several exact files. An
// Insta360 take, for example, can include paired lens originals and one or more
// low-resolution browse files. The set binds those revisions without turning
// a proxy into an original or requiring the browser to decode proprietary
// camera media.
model StudioMediaSourceSet {
  id                    String   @id @default(cuid())
  projectId             String
  kind                  String
  captureKey            String
  displayName           String
  identitySha256        String
  sourceClockRevisionId String
  completeness          String   @default("complete")
  metadataJson          Json     @default("{}")
  clientRequestId       String
  createdByUserId       String
  createdAt             DateTime @default(now())

  project             StudioProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceClockRevision StudioMediaSourceRevision    @relation("StudioMediaSourceSetClockRevision", fields: [sourceClockRevisionId], references: [id], onDelete: Restrict)
  createdBy           User                         @relation("StudioMediaSourceSetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members             StudioMediaSourceSetMember[]
  ranges              StudioSourceRange[]
  collectionItems     StudioSourceCollectionItem[]

  @@unique([projectId, identitySha256])
  @@unique([projectId, createdByUserId, clientRequestId])
  @@index([projectId, captureKey, createdAt])
  @@index([sourceClockRevisionId])
}

// Membership is immutable and role-bearing. Every member still resolves to an
// exact source revision with its own checksum and provider provenance.
model StudioMediaSourceSetMember {
  id                   String   @id @default(cuid())
  sourceSetId          String
  sourceRevisionId     String
  role                 String
  ordinal              Int      @default(0)
  requiredForRender    Boolean  @default(true)
  memberIdentitySha256 String
  metadataJson         Json     @default("{}")
  createdAt            DateTime @default(now())

  sourceSet      StudioMediaSourceSet      @relation(fields: [sourceSetId], references: [id], onDelete: Cascade)
  sourceRevision StudioMediaSourceRevision @relation("StudioMediaSourceSetMemberRevision", fields: [sourceRevisionId], references: [id], onDelete: Restrict)

  @@unique([sourceSetId, sourceRevisionId])
  @@unique([sourceSetId, role, ordinal])
  @@index([sourceRevisionId])
}

// A retained derivative is append-only evidence produced from one exact source
// revision. It is never the original and never replaces the source identity.
model StudioMediaDerivative {
  id                    String    @id
  projectId             String
  sourceRevisionId      String
  workflowJobId         String    @unique
  custodianNodeId       String?
  storageScopeId        String?
  kind                  String
  profile               String
  storageProvider       String
  locator               String    @db.Text
  generation            String
  contentSha256         String
  sizeBytes             BigInt
  mimeType              String
  durationSeconds       Float?
  widthPixels           Int?
  heightPixels          Int?
  framesPerSecond       Float?
  status                String    @default("ready")
  availabilityCheckedAt DateTime?
  contentVerifiedAt     DateTime?
  unavailableAt         DateTime?
  verificationJson      Json      @default("{}")
  provenanceJson        Json      @default("{}")
  createdByUserId       String
  createdAt             DateTime  @default(now())

  project        StudioProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRevision StudioMediaSourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  workflowJob    StudioWorkflowJob         @relation(fields: [workflowJobId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("StudioMediaDerivativeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  custodianNode  AgentNode?                @relation("StudioMediaDerivativeCustodian", fields: [custodianNodeId], references: [id], onDelete: Restrict)

  @@unique([sourceRevisionId, kind, profile, storageScopeId, generation], map: "StudioMediaDerivative_source_scope_generation_key")
  @@index([projectId, kind, createdAt])
  @@index([sourceRevisionId, status, createdAt])
  @@index([custodianNodeId, storageScopeId, status], map: "StudioMediaDerivative_custody_status_idx")
  @@index([status, availabilityCheckedAt])
}

// An exact, checksum-verified byte replica of one immutable external source
// revision. This is intentionally separate from a derivative: an LRV copied
// from Drive remains the same provider bytes, while a collaboration proxy is a
// new encoded artifact. Locators are server-only and never projected directly.
model StudioMediaSourceReplica {
  id                    String    @id
  projectId             String
  sourceRevisionId      String
  workflowJobId         String    @unique
  custodianNodeId       String?
  storageScopeId        String?
  storageProvider       String
  locator               String    @db.Text
  generation            String
  contentSha256         String
  checksumMd5           String?
  sizeBytes             BigInt
  mimeType              String
  status                String    @default("ready")
  availabilityCheckedAt DateTime?
  contentVerifiedAt     DateTime?
  unavailableAt         DateTime?
  verificationJson      Json      @default("{}")
  provenanceJson        Json      @default("{}")
  createdByUserId       String
  createdAt             DateTime  @default(now())

  project        StudioProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRevision StudioMediaSourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  workflowJob    StudioWorkflowJob         @relation(fields: [workflowJobId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("StudioMediaSourceReplicaCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  custodianNode  AgentNode?                @relation("StudioMediaSourceReplicaCustodian", fields: [custodianNodeId], references: [id], onDelete: SetNull)

  @@unique([sourceRevisionId, storageProvider, storageScopeId, generation])
  @@index([projectId, status, createdAt])
  @@index([sourceRevisionId, status, createdAt])
  @@index([custodianNodeId, storageScopeId, status])
  @@index([status, availabilityCheckedAt])
}

// A stable, immutable selection of one exact source revision. Reframing is a
// recipe over source time, never a rewrite of camera bytes.
model StudioSourceRange {
  id                String   @id @default(cuid())
  projectId         String
  sourceRevisionId  String
  sourceSetId       String?
  selectorSha256    String
  startSeconds      Float
  endSeconds        Float
  selectorJson      Json     @default("{}")
  reframeRecipeJson Json?
  createdByUserId   String
  createdAt         DateTime @default(now())

  project            StudioProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRevision     StudioMediaSourceRevision      @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  sourceSet          StudioMediaSourceSet?          @relation(fields: [sourceSetId], references: [id], onDelete: Restrict)
  createdBy          User                           @relation("StudioSourceRangeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  storyCards         StudioStoryCard[]
  timelinePlacements StudioStoryTimelinePlacement[]

  @@unique([sourceRevisionId, selectorSha256])
  @@index([projectId, createdAt])
  @@index([sourceSetId])
}

// The source-backed index card is Quipsly's reusable unit of story intent.
// Text and status may evolve through explicit revisions while its source range
// remains immutable and independently resolvable.
model StudioStoryCard {
  id              String    @id @default(cuid())
  projectId       String
  sourceRangeId   String?
  stableId        String    @unique
  title           String
  synopsis        String    @default("") @db.Text
  notes           String    @default("") @db.Text
  purpose         String    @default("select")
  status          String    @default("candidate")
  visibility      String    @default("project")
  revision        Int       @default(1)
  clientRequestId String
  createdByUserId String
  updatedByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project            StudioProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRange        StudioSourceRange?             @relation(fields: [sourceRangeId], references: [id], onDelete: Restrict)
  createdBy          User                           @relation("StudioStoryCardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy          User?                          @relation("StudioStoryCardUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  revisions          StudioStoryCardRevision[]
  tags               StudioStoryCardTagLink[]
  placements         StudioStoryBoardPlacement[]
  timelinePlacements StudioStoryTimelinePlacement[]

  @@unique([projectId, createdByUserId, clientRequestId])
  @@index([projectId, status, updatedAt])
  @@index([sourceRangeId])
  @@index([archivedAt, updatedAt])
}

// Append-only card history makes edits, source preservation, and rollback
// inspectable without turning the current row into an event-store query.
model StudioStoryCardRevision {
  id              String   @id @default(cuid())
  cardId          String
  revision        Int
  operation       String
  actorUserId     String
  clientRequestId String
  snapshotJson    Json
  createdAt       DateTime @default(now())

  card  StudioStoryCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User            @relation("StudioStoryCardRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([cardId, revision])
  @@unique([cardId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

model StudioStoryCardTagLink {
  cardId          String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  card      StudioStoryCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag       StudioTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("StudioStoryCardTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([cardId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

model StudioStoryBoard {
  id                  String    @id @default(cuid())
  projectId           String
  episodeProductionId String?
  clientRequestId     String
  slug                String
  title               String
  description         String?   @db.Text
  kind                String    @default("story")
  layout              String    @default("board")
  revision            Int       @default(0)
  createdByUserId     String
  updatedByUserId     String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project            StudioProject                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeProduction  StudioEpisodeProduction?       @relation(fields: [episodeProductionId], references: [id], onDelete: SetNull)
  createdBy          User                           @relation("StudioStoryBoardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy          User?                          @relation("StudioStoryBoardUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  placements         StudioStoryBoardPlacement[]
  sections           StudioStoryBoardSection[]
  operations         StudioStoryBoardOperation[]
  timelinePlacements StudioStoryTimelinePlacement[]

  @@unique([projectId, slug])
  @@unique([projectId, createdByUserId, clientRequestId], map: "StudioStoryBoard_project_actor_request_key")
  @@index([projectId, archivedAt, updatedAt])
  @@index([episodeProductionId])
}

// A section is the durable binder item behind a board beat. Placements refer
// to it by the board-scoped key, while prose remains in an optional canonical
// StudioDocument. Empty sections therefore survive card moves and can keep
// their writing without turning placement metadata into manuscript storage.
model StudioStoryBoardSection {
  id              String    @id @default(cuid())
  boardId         String
  key             String
  title           String
  synopsis        String    @default("") @db.Text
  sortOrder       Int       @default(0)
  documentId      String?   @unique
  revision        Int       @default(1)
  createdByUserId String
  updatedByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  board      StudioStoryBoard                   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  document   StudioDocument?                    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy  User                               @relation("StudioStoryBoardSectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy  User?                              @relation("StudioStoryBoardSectionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  placements StudioStoryBoardPlacement[]
  operations StudioStoryBoardSectionOperation[]

  @@unique([boardId, key])
  @@index([boardId, archivedAt, sortOrder])
  @@index([documentId])
}

// Section mutations carry their own idempotent history so opening or later
// renaming a binder item does not manufacture a board-order conflict.
model StudioStoryBoardSectionOperation {
  id               String   @id @default(cuid())
  sectionId        String
  revision         Int
  previousRevision Int
  operation        String
  actorUserId      String
  clientRequestId  String
  requestSha256    String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  section StudioStoryBoardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  actor   User                    @relation("StudioStoryBoardSectionOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([sectionId, revision])
  @@unique([sectionId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// Placement owns only composition context. Reordering or grouping a card does
// not alter its source range, prose, tags, or use on another board.
model StudioStoryBoardPlacement {
  id              String   @id @default(cuid())
  boardId         String
  cardId          String
  groupKey        String   @default("unassigned")
  laneKey         String   @default("story")
  sortOrder       Int      @default(0)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  board              StudioStoryBoard               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  section            StudioStoryBoardSection        @relation(fields: [boardId, groupKey], references: [boardId, key], onDelete: Restrict, onUpdate: Cascade)
  card               StudioStoryCard                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdBy          User                           @relation("StudioStoryBoardPlacementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  timelinePlacements StudioStoryTimelinePlacement[]

  @@unique([boardId, cardId])
  @@index([boardId, groupKey, sortOrder])
  @@index([cardId])
}

// Every board mutation is one revisioned, idempotent operation. The current
// board and placements are the read model; the receipt preserves authorship,
// prior revision, and the exact resulting arrangement for compare/rollback.
model StudioStoryBoardOperation {
  id               String   @id @default(cuid())
  boardId          String
  revision         Int
  previousRevision Int
  operation        String
  actorUserId      String
  clientRequestId  String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  board StudioStoryBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor User             @relation("StudioStoryBoardOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([boardId, revision])
  @@unique([boardId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// Current projection of one deliberate Source Story card placement in an
// Episode timeline. The canonical Episode artifact owns edit playback; this
// row preserves the exact card/range/package origin and reversible lifecycle.
model StudioStoryTimelinePlacement {
  id                              String    @id @default(cuid())
  projectId                       String
  episodeProductionId             String
  cardId                          String
  sourceRangeId                   String
  originBoardId                   String?
  originBoardPlacementId          String?
  clipId                          String
  trackId                         String
  episodeStartSeconds             Float
  durationSeconds                 Float
  status                          String    @default("active")
  revision                        Int       @default(1)
  timelineFingerprintBeforeSha256 String
  timelineFingerprintAfterSha256  String
  sourceSnapshotJson              Json
  timelineClipJson                Json
  clientRequestId                 String
  createdByUserId                 String
  createdByEmail                  String
  updatedByUserId                 String?
  withdrawnAt                     DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  project              StudioProject                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeProduction    StudioEpisodeProduction                 @relation(fields: [episodeProductionId], references: [id], onDelete: Cascade)
  card                 StudioStoryCard                         @relation(fields: [cardId], references: [id], onDelete: Restrict)
  sourceRange          StudioSourceRange                       @relation(fields: [sourceRangeId], references: [id], onDelete: Restrict)
  originBoard          StudioStoryBoard?                       @relation(fields: [originBoardId], references: [id], onDelete: SetNull)
  originBoardPlacement StudioStoryBoardPlacement?              @relation(fields: [originBoardPlacementId], references: [id], onDelete: SetNull)
  createdBy            User                                    @relation("StudioStoryTimelinePlacementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User?                                   @relation("StudioStoryTimelinePlacementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  operations           StudioStoryTimelinePlacementOperation[]

  @@unique([episodeProductionId, clipId])
  @@unique([episodeProductionId, createdByUserId, clientRequestId], map: "StudioStoryTimelinePlacement_episode_actor_request_key")
  @@index([projectId, status, updatedAt])
  @@index([episodeProductionId, status, episodeStartSeconds])
  @@index([cardId, status, updatedAt])
  @@index([sourceRangeId])
  @@index([originBoardId])
  @@index([originBoardPlacementId])
}

// Append-only promotion, reposition, withdrawal, and reconciliation ledger.
// Every operation binds exact before/after timeline fingerprints and the
// normalized request hash.
model StudioStoryTimelinePlacementOperation {
  id               String   @id @default(cuid())
  placementId      String
  revision         Int
  previousRevision Int
  operation        String
  actorUserId      String
  clientRequestId  String
  requestSha256    String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  placement StudioStoryTimelinePlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  actor     User                         @relation("StudioStoryTimelinePlacementOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([placementId, revision])
  @@unique([placementId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// A source collection is a filing surface over canonical media identities. It
// never copies bytes, changes a tag, creates a story card, or mutates a board.
// Personal collections are visible only to their owner; project collections
// are shared with people who already have access to the Nest.
model StudioSourceCollection {
  id              String    @id @default(cuid())
  projectId       String
  ownerUserId     String
  scope           String    @default("personal")
  slug            String
  title           String
  description     String    @default("") @db.Text
  color           String?
  revision        Int       @default(1)
  clientRequestId String
  createdByUserId String
  updatedByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    StudioProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      User                              @relation("StudioSourceCollectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy  User                              @relation("StudioSourceCollectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy  User?                             @relation("StudioSourceCollectionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  items      StudioSourceCollectionItem[]
  operations StudioSourceCollectionOperation[]

  @@unique([projectId, ownerUserId, slug])
  @@unique([projectId, createdByUserId, clientRequestId], map: "StudioSourceCollection_project_actor_request_key")
  @@index([projectId, scope, archivedAt, updatedAt])
  @@index([ownerUserId, archivedAt, updatedAt])
}

// Exactly one target is set. targetKey is the stable client-facing identity
// (`source-set:…`, `external:…`, or `asset:…`) and is independently checked by
// the database migration against the populated foreign key.
model StudioSourceCollectionItem {
  id                  String   @id @default(cuid())
  collectionId        String
  targetKey           String
  sourceSetId         String?
  externalReferenceId String?
  mediaAssetId        String?
  sortOrder           Int      @default(0)
  note                String   @default("") @db.Text
  addedByUserId       String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  collection        StudioSourceCollection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceSet         StudioMediaSourceSet?         @relation(fields: [sourceSetId], references: [id], onDelete: Restrict)
  externalReference StudioExternalMediaReference? @relation(fields: [externalReferenceId], references: [id], onDelete: Restrict)
  mediaAsset        StudioMediaAsset?             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  addedBy           User                          @relation("StudioSourceCollectionItemAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([collectionId, targetKey])
  @@index([sourceSetId])
  @@index([externalReferenceId])
  @@index([mediaAssetId])
  @@index([collectionId, sortOrder])
}

// Every collection mutation is idempotent and revisioned. snapshotJson keeps
// the resulting ordered filing state inspectable without making the current
// collection an event-store query.
model StudioSourceCollectionOperation {
  id               String   @id @default(cuid())
  collectionId     String
  revision         Int
  previousRevision Int
  operation        String
  actorUserId      String
  clientRequestId  String
  requestSha256    String
  snapshotJson     Json
  createdAt        DateTime @default(now())

  collection StudioSourceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  actor      User                   @relation("StudioSourceCollectionOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([collectionId, revision])
  @@unique([collectionId, actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
}

// Explicit promotion receipt from an actor-owned personal capture into one
// shared Nest research source. The personal Snippet/Bookmark remains unchanged;
// the receipt pins the immutable capture snapshot used to create the source.
model StudioPersonalSourceFiling {
  id                     String   @id @default(cuid())
  projectId              String
  sourceUnitId           String   @unique
  createdByUserId        String?
  createdByEmailSnapshot String?
  captureType            String
  snippetId              String?
  bookmarkId             String?
  clientRequestId        String
  captureSnapshotJson    Json
  createdAt              DateTime @default(now())

  project    StudioProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUnit StudioSourceUnit @relation(fields: [sourceUnitId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation("StudioPersonalSourceFilingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  snippet    Snippet?         @relation(fields: [snippetId], references: [id], onDelete: SetNull)
  bookmark   Bookmark?        @relation(fields: [bookmarkId], references: [id], onDelete: SetNull)

  @@unique([createdByUserId, clientRequestId])
  @@unique([projectId, snippetId])
  @@unique([projectId, bookmarkId])
  @@index([createdByUserId, createdAt])
  @@index([projectId, createdAt])
}

// One immutable receipt per deliberate iPhone/Share Sheet capture request.
// Multiple receipts may point to the same deduplicated personal source identity.
model StudioPersonalSourceCaptureReceipt {
  id                     String   @id @default(cuid())
  createdByUserId        String
  createdByEmailSnapshot String?
  clientRequestId        String
  captureType            String
  snippetId              String?
  bookmarkId             String?
  sourceFingerprint      String
  capturedAt             DateTime
  captureSnapshotJson    Json
  createdAt              DateTime @default(now())

  createdBy User      @relation("StudioPersonalSourceCaptureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  snippet   Snippet?  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  bookmark  Bookmark? @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@unique([createdByUserId, clientRequestId])
  @@index([snippetId, capturedAt])
  @@index([bookmarkId, capturedAt])
  @@index([createdByUserId, capturedAt])
}

// Durable overlays around immutable source material. The source bytes/text stay
// untouched; selectors retain both positions and quote context so anchors can be
// verified, exported, and repaired without silently moving a person's note.
model StudioSourceAnnotation {
  id                     String    @id @default(cuid())
  projectId              String
  sourceUnitId           String
  documentId             String?
  blockId                String?
  createdByUserId        String?
  createdByEmailSnapshot String?
  kind                   String    @default("note")
  status                 String    @default("active")
  visibility             String    @default("private")
