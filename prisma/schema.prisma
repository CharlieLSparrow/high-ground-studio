  @@unique([projectId, actorEmail, clientRequestId], map: "StudioEpisodeAudioAnalysis_project_actor_request_key")
  @@unique([episodeProductionId, inputSha256], map: "StudioEpisodeAudioAnalysis_episode_input_key")
  @@index([episodeProductionId, analyzedAt], map: "StudioEpisodeAudioAnalysis_episode_time_idx")
  @@index([programFingerprintSha256], map: "StudioEpisodeAudioAnalysis_program_fingerprint_idx")
  @@index([supersedesAnalysisId], map: "StudioEpisodeAudioAnalysis_supersedes_idx")
}

