// -----------------------------------------------------------------------------
// GOVERNED ACTION RUNTIME
// -----------------------------------------------------------------------------

model GovernedActionRun {
  id                String                       @id @default(cuid())
  projectId         String?
  roomId            String?
  requestedByUserId String
  requestedByEmail  String
  principalKind     GovernedPrincipalKind
  principalId       String
  sourceSurface     String
  intent            String
  decisionPolicy    GovernedActionDecisionPolicy
  riskLevel         GovernedActionRiskLevel
  status            GovernedActionRunStatus
  authorityJson     Json                         @default("{}")
  budgetJson        Json                         @default("{}")
  readSetJson       Json                         @default("[]")
  consequenceJson   Json                         @default("{}")
  progressJson      Json                         @default("{}")
  summaryJson       Json                         @default("{}")
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  project StudioProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  room    CallRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  actions GovernedAction[]

  @@index([projectId, status, createdAt])
  @@index([roomId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([principalKind, principalId, createdAt])
}

model GovernedAction {
  id                String                       @id @default(cuid())
  runId             String
  requestId         String                       @unique @db.Uuid
  capabilityId      String
  capabilityVersion Int
  actionKind        String
  targetObjectType  String?
  targetObjectId    String?
  label             String
  explanation       String?
  payloadJson       Json
  payloadSha256     String
  requestSha256     String
  idempotencyKey    String
  decisionPolicy    GovernedActionDecisionPolicy
  decisionStatus    GovernedActionDecisionStatus
  riskLevel         GovernedActionRiskLevel
  status            GovernedActionStatus
  consequenceJson   Json                         @default("{}")
  recoveryJson      Json                         @default("{}")
  resultJson        Json                         @default("{}")
  approvedByUserId  String?
  approvedByEmail   String?
  approvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  run              GovernedActionRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts         GovernedActionAttempt[]
  receipts         GovernedActionReceipt[]
  assistantAction  StudioAssistantAction?           @relation("StudioAssistantGovernedAction")
  preflightReceipt CallParticipantPreflightReceipt? @relation("SessionPreflightGovernedAction")

  @@unique([runId, idempotencyKey])
  @@index([capabilityId, status, createdAt])
  @@index([targetObjectType, targetObjectId, createdAt])
  @@index([runId, createdAt])
  @@index([payloadSha256])
}

model GovernedActionAttempt {
  id            String                      @id @default(cuid())
  actionId      String
  attemptNumber Int
  executorKind  String
  status        GovernedActionAttemptStatus
  errorCode     String?
  errorMessage  String?
  evidenceJson  Json                        @default("{}")
  startedAt     DateTime                    @default(now())
  completedAt   DateTime?
  createdAt     DateTime                    @default(now())

  action   GovernedAction          @relation(fields: [actionId], references: [id], onDelete: Cascade)
  receipts GovernedActionReceipt[]

  @@unique([actionId, attemptNumber])
  @@index([status, startedAt])
}

model GovernedActionReceipt {
  id             String                    @id @default(cuid())
  actionId       String
  attemptId      String?
  kind           GovernedActionReceiptKind
  previousStatus GovernedActionStatus?
  newStatus      GovernedActionStatus
  actorUserId    String?
  actorEmail     String?
  evidenceJson   Json                      @default("{}")
  createdAt      DateTime                  @default(now())

  action  GovernedAction         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  attempt GovernedActionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([actionId, createdAt])
  @@index([attemptId, createdAt])
  @@index([kind, createdAt])
}

// -----------------------------------------------------------------------------
// SCROLL-NATIVE EXPERIENCES (BETA)
// -----------------------------------------------------------------------------

model ScrollInteraction {
  id              String   @id @default(cuid())
  experienceId    String // Maps to StudioStoryboard.id or StudioDocument.id
  panelId         String? // Maps to StudioStoryboardFrame.id or StudioDocumentBlock.id
  userId          String? // Nullable for guest/client review links
  interactionType String // 'COMMENT', 'RATING', 'FAVORITE', 'SELECTION', 'COMPLETION'
  payloadJson     Json // e.g. { rating: 5 }, { text: "Fix this color" }
  createdAt       DateTime @default(now())

  @@index([experienceId, panelId])
  @@index([interactionType])
}

model StudioScrollExperience {
  id           String   @id @default(cuid())
  projectId    String
  storyboardId String?
  slug         String
  title        String
  layout       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    StudioProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboard StudioStoryboard?     @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  sections   StudioScrollSection[]

  @@index([projectId])
  @@index([storyboardId])
}

model StudioScrollSection {
  id           String   @id @default(cuid())
  experienceId String
  sortOrder    Int
  label        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience StudioScrollExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  panelRefs  StudioScrollPanelRef[]

  @@index([experienceId, sortOrder])
}

model StudioScrollPanelRef {
  id         String   @id @default(cuid())
  sectionId  String
  frameId    String? // Links to StudioStoryboardFrame if it exists
  externalId String? // E.g., 'panel-001' from JSON if no strict relation
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section StudioScrollSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  frame   StudioStoryboardFrame? @relation(fields: [frameId], references: [id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@index([frameId])
}

// -----------------------------------------------------------------------------
// QUIPLORE DOMAIN (SEMANTIC RESEARCH & CITATIONS)
// -----------------------------------------------------------------------------

model QuipLoreAuthor {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  works   QuipLoreWork[]
  quotes  QuipLoreQuote[]

  @@index([projectId])
}

model QuipLoreWork {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String?
  title       String
  description String?   @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project StudioProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  QuipLoreAuthor?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sources QuipLoreSource[]
  quotes  QuipLoreQuote[]

  @@index([projectId])
}

model QuipLoreSource {
  id          String   @id @default(cuid())
  projectId   String
  workId      String?
  title       String
  url         String?
  isbn        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work      QuipLoreWork?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  quotes    QuipLoreQuote[]
  citations QuipLoreCitation[]

  @@index([projectId])
}

model QuipLoreQuote {
  id        String                      @id @default(cuid())
  projectId String
  workId    String?
  authorId  String?
  sourceId  String?
  text      String                      @db.Text
  context   String?                     @db.Text
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  project     StudioProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work        QuipLoreWork?            @relation(fields: [workId], references: [id], onDelete: SetNull)
  author      QuipLoreAuthor?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  source      QuipLoreSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  citations   QuipLoreCitation[]
  annotations QuipLoreUserAnnotation[]
  tags        QuipLoreTag[]            @relation("QuoteTags")
  collections QuipLoreCollection[]     @relation("QuoteCollections")

  @@index([projectId])
}

model QuipLoreCitation {
  id        String   @id @default(cuid())
  projectId String
  quoteId   String
  sourceId  String?
  locator   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote   QuipLoreQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  source  QuipLoreSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([quoteId])
}

model QuipLoreUserAnnotation {
  id        String   @id @default(cuid())
  projectId String
  quoteId   String
  note      String   @db.Text
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote   QuipLoreQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([quoteId])
}

model QuipLoreTheme {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags    QuipLoreTag[]

  @@index([projectId])
}

model QuipLoreTag {
  id        String   @id @default(cuid())
  projectId String
  themeId   String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theme   QuipLoreTheme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  quotes  QuipLoreQuote[] @relation("QuoteTags")

  @@unique([projectId, name])
}

model QuipLoreCollection {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes  QuipLoreQuote[] @relation("QuoteCollections")

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// Native App Models (Quipsly Notes MVP)
// -----------------------------------------------------------------------------

model QuipslyNote {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String
  tags       String[] @default([])
  folderName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
}

// Browser episode editing keeps immutable sync/source truth separate from
// lightweight, attributable edit intent.
model StudioEditBaseline {
  id                  String   @id @default(cuid())
  projectId           String
  episodeProductionId String
  stableKey           String
  version             Int      @default(1)
  label               String
  durationSeconds     Float    @default(0)
  sourceFingerprint   String?
  sourceManifestJson  Json     @default("{}")
  syncSummaryJson     Json     @default("{}")
  importReceiptJson   Json     @default("{}")
  importedByUserId    String?
  importedByEmail     String?
  importedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  branches StudioEditBranch[]

  @@unique([episodeProductionId, stableKey, version])
  @@index([projectId, episodeProductionId])
}

model StudioEditBranch {
  id                 String   @id @default(cuid())
  baselineId         String
  slug               String
  name               String
  role               String   @default("episode-edit")
  status             String   @default("active")
  headRevision       Int      @default(0)
  stateJson          Json     @default("{}")
  stateFingerprint   String?
  createdByUserId    String?
  createdByEmail     String?
  createdByActorType String   @default("human")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  baseline    StudioEditBaseline         @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  operations  StudioEditOperation[]
  annotations StudioTimelineAnnotation[]

  @@unique([baselineId, slug])
  @@index([baselineId, status])
}

model StudioEditOperation {
  id                       String    @id @default(cuid())
  branchId                 String
  revision                 Int
  clientRequestId          String
  expectedRevision         Int
  actorUserId              String?
  actorEmail               String?
  actorLabel               String?
  actorType                String    @default("human")
  operationType            String
  sequenceTime             Float?
  endTime                  Float?
  payloadJson              Json      @default("{}")
  beforeJson               Json?
  afterJson                Json?
  sourceTimestampPrecision String    @default("exact")
  sourceCreatedBefore      DateTime?
  createdAt                DateTime  @default(now())

  branch StudioEditBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, revision])
  @@unique([branchId, clientRequestId])
  @@index([branchId, createdAt])
  @@index([actorUserId, createdAt])
}

model StudioTimelineAnnotation {
  id                 String    @id @default(cuid())
  branchId           String
  startSeconds       Float
  endSeconds         Float?
  kind               String    @default("note")
  title              String?
  body               String?
  hookKey            String?
  tagsJson           Json      @default("[]")
  status             String    @default("active")
  createdByUserId    String?
  createdByEmail     String?
  createdByActorType String    @default("human")
  clientRequestId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  branch StudioEditBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, clientRequestId])
  @@index([branchId, startSeconds])
  @@index([branchId, status, createdAt])
}

// --- PHASE 5: NLE Timeline Core --- //

model StudioNLEProject {
  id        String   @id @default(cuid())
  projectId String
  name      String
  fps       Int      @default(60)
  width     Int      @default(1920)
  height    Int      @default(1080)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks StudioNLETrack[]

  // Relates to the core StudioProject
  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StudioNLETrack {
  id           String   @id @default(cuid())
  nleProjectId String
  name         String
  trackType    String // "VIDEO" or "AUDIO"
  orderIndex   Int
  isHidden     Boolean  @default(false)
  isMuted      Boolean  @default(false)
  isSoloed     Boolean  @default(false)
  isLocked     Boolean  @default(false)
  volume       Float    @default(1.0)
  opacity      Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nleProject StudioNLEProject @relation(fields: [nleProjectId], references: [id], onDelete: Cascade)
  clips      StudioNLEClip[]
}

model StudioNLEClip {
  id              String   @id @default(cuid())
  trackId         String
  assetId         String? // Reference to media (null if it's a generated clip like a solid color)
  name            String
  startFrame      Int
  durationFrames  Int
  trimStartFrame  Int      @default(0)
  speedMultiplier Float    @default(1.0)
  colorHex        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  track StudioNLETrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model StudioWorkflowStage {
  id        String   @id @default(cuid())
  projectId String
  name      String
  hexColor  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goals   Goal[]

  @@index([projectId, order])
}

enum InstitutionalWorkflowState {
  DRAFT
  SUBMITTED
  AUDITING
  VERIFIED
  REJECTED
}

enum CanvasFormFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model CanvasForm {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      CanvasFormField[]
  submissions CanvasFormSubmission[]

  createdBy User @relation("CanvasFormCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
}

model CanvasFormField {
  id       String              @id @default(cuid())
  formId   String
  name     String
  label    String
  type     CanvasFormFieldType
  required Boolean             @default(false)
  options  Json? // For SELECT or MULTI_SELECT types (e.g., ["Option A", "Option B"])
  order    Int                 @default(0)

  form CanvasForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, order])
}

model CanvasFormSubmission {
  id            String                     @id @default(cuid())
  formId        String
  submittedById String
  state         InstitutionalWorkflowState @default(SUBMITTED)
  data          Json // The actual submitted field values
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  form        CanvasForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy User       @relation("CanvasFormSubmissionUser", fields: [submittedById], references: [id], onDelete: Restrict)
}
