  designation       String // e.g. "forager", "builder", "publisher"
  status            String   @default("idle")
  currentTask       String?
  assignedProjectId String?
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([designation, status])
}

model AgentTask {
  id          String    @id @default(cuid())
  agentId     String
  instruction String
  outputJson  Json?
  status      String    @default("QUEUED") // QUEUED, IN_PROGRESS, COMPLETED, FAILED
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent AgentNode @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

// -----------------------------------------------------------------------------
