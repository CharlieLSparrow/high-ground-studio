// -----------------------------------------------------------------------------
// SUBSCRIPTION ENGINE (QUIPSLY SAAS)
// -----------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionProvider {
  APP_STORE
  STRIPE
  MANUAL
}

enum SubscriptionProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String
  stableKey        String?  @unique
  stripeProductId  String?  @unique
  stripePriceId    String?  @unique
  appleProductId   String?  @unique
  capabilitiesJson Json?
  purchasable      Boolean  @default(false)
  displayOrder     Int      @default(0)
  price            Int
  currency         String   @default("usd")
  interval         String   @default("month")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String                @id @default(cuid())
  organizationId         String                @unique
  planId                 String
  stripeCustomerId       String?               @unique
  stripeSubscriptionId   String?               @unique
  billingOwnerUserId     String?               @unique
  provider               SubscriptionProvider?
  providerCustomerId     String?
  providerSubscriptionId String?               @unique
  originalTransactionId  String?               @unique
  appAccountToken        String?               @unique
  providerStatus         String?
  status                 SubscriptionStatus    @default(TRIALING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  providerEvents SubscriptionProviderEvent[]

  @@index([organizationId])
  @@index([planId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([billingOwnerUserId, status])
  @@index([provider, providerStatus])
  @@index([providerCustomerId])
}

model SubscriptionProviderEvent {
  id              String                          @id @default(cuid())
  provider        SubscriptionProvider
  externalEventId String
  eventType       String
  status          SubscriptionProviderEventStatus @default(RECEIVED)
  payloadSha256   String
  organizationId  String?
  subscriptionId  String?
  occurredAt      DateTime?
  receivedAt      DateTime                        @default(now())
  processedAt     DateTime?
  errorCode       String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([organizationId, receivedAt])
  @@index([subscriptionId, receivedAt])
  @@index([status, receivedAt])
}

