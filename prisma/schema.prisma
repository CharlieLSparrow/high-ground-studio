  @@index([projectId, assetId, analyzedAt], map: "StudioAudibleEventAnalysis_project_asset_idx")
  @@index([sourceId, analyzedAt], map: "StudioAudibleEventAnalysis_source_idx")
  @@index([detectorConfigurationSha256, analyzedAt], map: "StudioAudibleEventAnalysis_config_idx")
