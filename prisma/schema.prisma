enum StudioAudioMasterReviewDecision {
  APPROVED
  REJECTED
}

enum StudioAudioMasterPromotionOperation {
  PROMOTE
  WITHDRAW
}

// A listening decision is append-only and source/preview bound. Approval does
// not promote, replace, publish, or mutate either media file.
model StudioAudioMasterReviewReceipt {
  id               String                          @id @default(cuid())
  projectId        String
  assetId          String
  masteryJobId     String
  actorUserId      String?
  actorEmail       String
  clientRequestId  String
  decision         StudioAudioMasterReviewDecision
  profileId        String
  sourceSha256     String
  sourceGeneration String
  previewSha256    String
  requestSha256    String
  evidenceJson     Json
  note             String?
  occurredAt       DateTime
  createdAt        DateTime                        @default(now())

  project    StudioProject                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset      StudioMediaAsset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  masteryJob StudioAssetProcessingJob            @relation(fields: [masteryJobId], references: [id], onDelete: Cascade)
  promotions StudioAudioMasterPromotionReceipt[]

  @@unique([projectId, actorEmail, clientRequestId], map: "StudioAudioMasterReview_project_actor_request_key")
  @@index([masteryJobId, createdAt], map: "StudioAudioMasterReview_job_created_idx")
  @@index([projectId, assetId, createdAt], map: "StudioAudioMasterReview_project_asset_created_idx")
}

// Promotion is a separate append-only decision after a playback-bound review.
// It makes the verified derivative a delivery candidate; it never replaces the
// immutable source, changes the episode spine, encodes a delivery file, or
// publishes. Withdrawal preserves the candidate and every prior receipt.
model StudioAudioMasterPromotionReceipt {
  id               String                              @id @default(cuid())
  projectId        String
  assetId          String
  masteryJobId     String
  reviewReceiptId  String?
  actorUserId      String?
  actorEmail       String
  clientRequestId  String
  operation        StudioAudioMasterPromotionOperation
  profileId        String
  sourceSha256     String
  sourceGeneration String
  previewSha256    String
