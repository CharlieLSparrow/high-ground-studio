// -----------------------------------------------------------------------------
// STORY BIBLE
// -----------------------------------------------------------------------------

enum StoryEntityType {
  CHARACTER
  SETTING
  SCENE
  RELATIONSHIP
  TIMELINE_EVENT
  THEME_MOTIF
  COMIC_ACT
  COMIC_PANEL
  BEAT
}

enum StoryBibleActionStatus {
  PENDING
  APPROVED
  REJECTED
  UNDONE
}

enum StoryBibleActionType {
  PROPOSE_ENTITY
  PROPOSE_ENTITY_UPDATE
  PROPOSE_RELATIONSHIP
}

model StoryEntity {
  id         String          @id @default(cuid())
  externalId String?         @unique
  projectId  String
  type       StoryEntityType
  name       String
  aliases    String[]        @default([])
  attributes Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  mentions StoryEntityMention[]

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
}

model StoryEntityMention {
  id         String   @id @default(cuid())
  entityId   String
  documentId String
  blockId    String
  snippet    String
  createdAt  DateTime @default(now())

  entity StoryEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([documentId, blockId])
}

model StoryBibleAction {
  id          String                 @id @default(cuid())
  projectId   String
  documentId  String?
  type        StoryBibleActionType
  status      StoryBibleActionStatus @default(PENDING)
  payloadJson Json                   @default("{}")
  explanation String?
  riskLevel   String                 @default("LOW")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledgers StoryBibleLedger[]

  @@index([projectId, status])
}

model StoryBibleLedger {
  id        String                  @id @default(cuid())
  actionId  String
  oldStatus StoryBibleActionStatus?
  newStatus StoryBibleActionStatus
  comments  String?
  changedBy String? // userId
  createdAt DateTime                @default(now())

  action StoryBibleAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
}

// -----------------------------------------------------------------------------
// ENTITLEMENT LEDGER (Provider Agnostic)
// -----------------------------------------------------------------------------

model EntitlementLedger {
  id             String   @id @default(cuid())
  provider       String // e.g., "patreon", "apple_iap", "stripe", "manual"
  providerEmail  String?
  proposedTier   String
  action         String
  status         String   @default("pending")
  providerStatus String?
  eventId        String?
