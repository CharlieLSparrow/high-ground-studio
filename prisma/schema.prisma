  consentText    String
  policyVersion  String                 @default("2026-07-04")
  canRecordAudio Boolean                @default(false)
  canRecordVideo Boolean                @default(false)
  canTranscribe  Boolean                @default(false)
  consentedAt    DateTime?
  declinedAt     DateTime?
  revokedAt      DateTime?
  metadataJson   Json                   @default("{}")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  room        CallRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant CallParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  user        User?            @relation("RecordingConsentUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([participantId, createdAt])
  @@index([userId, createdAt])
}

model RecordingAsset {
  id                String               @id @default(cuid())
  roomId            String
  participantId     String?
  kind              RecordingAssetKind   @default(LOCAL_AUDIO)
  status            RecordingAssetStatus @default(LOCAL_READY)
  fileName          String?
  contentType       String?
  byteSize          BigInt?
  durationSeconds   Float?
  storageBucket     String?
  storageObjectPath String?
  localManifestJson Json                 @default("{}")
  segmentsJson      Json                 @default("[]")
  checksum          String?
  errorMessage      String?
  recordedStartedAt DateTime?
  recordedStoppedAt DateTime?
  uploadedAt        DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  room                          CallRoom                        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant                   CallParticipant?                @relation(fields: [participantId], references: [id], onDelete: SetNull)
  uploadChunks                  UploadChunk[]
  transcriptJobs                TranscriptJob[]
  transcriptVerifications       TranscriptSegmentVerification[]
  transcriptSpeakerAttributions TranscriptSpeakerAttribution[]
  transcriptEvaluationWindows   TranscriptEvaluationWindow[]
  providerRecordingCommands     ProviderRecordingCommand[]
  providerRecordingEvents       ProviderRecordingEventReceipt[]
  sourceExpectation             CallExpectedSource?
  alignmentJobsAsSpine          SessionAudioAlignmentJob[]      @relation("SessionAudioAlignmentSpine")
  alignmentJobsAsTarget         SessionAudioAlignmentJob[]      @relation("SessionAudioAlignmentTarget")
  audioAuditionJobs             SessionAudioAuditionJob[]

  @@index([roomId, status])
  @@index([participantId, createdAt])
  @@index([kind, status, createdAt])
}

/// Exact-source waveform/drift evidence for two retained Session recordings.
/// This is intentionally not a StudioAssetProcessingJob: a coaching Session
/// must not invent an Episode or StudioMediaAsset identity merely to use the
/// shared media analyzer. Results are proposals only and never move source
/// timing without a separate reviewed placement decision.
model SessionAudioAlignmentJob {
  id                     String    @id
  roomId                 String
  spineRecordingAssetId  String
  targetRecordingAssetId String
  requestedByUserId      String
  requestedByEmail       String
  status                 String    @default("queued")
  inputJson              Json
  resultJson             Json?
  error                  String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  room      CallRoom                               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  spine     RecordingAsset                         @relation("SessionAudioAlignmentSpine", fields: [spineRecordingAssetId], references: [id], onDelete: Restrict)
  target    RecordingAsset                         @relation("SessionAudioAlignmentTarget", fields: [targetRecordingAssetId], references: [id], onDelete: Restrict)
  requester User                                   @relation("SessionAudioAlignmentRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decisions SessionAudioAlignmentDecisionReceipt[]

  @@index([roomId, status, createdAt])
  @@index([targetRecordingAssetId, createdAt])
  @@index([spineRecordingAssetId, targetRecordingAssetId, createdAt])
  @@index([status, createdAt])
}

/// A compact, immutable audio-only review derivative for one exact released
/// Session source. It exists so transcript review never needs to download a
/// multi-gigabyte camera master. The retained RecordingAsset remains source
/// truth and every worker result is re-bound to its generation and SHA-256.
model SessionAudioAuditionJob {
  id                String    @id
  roomId            String
  recordingAssetId  String
  requestedByUserId String
  requestedByEmail  String
  status            String    @default("queued")
  inputJson         Json
  resultJson        Json?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  room           CallRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recordingAsset RecordingAsset @relation(fields: [recordingAssetId], references: [id], onDelete: Restrict)
  requester      User           @relation("SessionAudioAuditionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([roomId, status, createdAt])
  @@index([recordingAssetId, createdAt])
  @@index([status, createdAt])
}

enum SessionAudioAlignmentDecisionOperation {
  APPROVE
  REVOKE
}

/// Append-only placement decisions over one immutable Session alignment result.
/// Approval records a reversible editorial offset; revocation never deletes the
/// original evidence or the decision it supersedes.
model SessionAudioAlignmentDecisionReceipt {
  id               String                                 @id @default(cuid())
  requestId        String                                 @unique @db.Uuid
  roomId           String
  alignmentJobId   String
  actorUserId      String
  operation        SessionAudioAlignmentDecisionOperation
  revision         Int
  expectedRevision Int
  requestSha256    String
  resultSha256     String
  placementJson    Json
  reason           String?
  createdAt        DateTime                               @default(now())

  room         CallRoom                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  alignmentJob SessionAudioAlignmentJob @relation(fields: [alignmentJobId], references: [id], onDelete: Restrict)
  actor        User                     @relation("SessionAudioAlignmentDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([alignmentJobId, revision])
  @@index([roomId, createdAt])
  @@index([actorUserId, createdAt])
}

/// The explicit recording plan for one Session. This is separate from
/// RecordingAsset because an expected source must remain visible even when the
/// intended device never started or never reached the server.
model CallExpectedSource {
  id                  String                   @id @default(cuid())
  roomId              String
  participantId       String?
  createdByUserId     String?
  label               String
  sourceKind          CallExpectedSourceKind
  retentionRole       CallExpectedSourceRole   @default(REQUIRED_MASTER)
  status              CallExpectedSourceStatus @default(ACTIVE)
  expectedClientKind  String?
  expectedDeviceLabel String?
  recordingAssetId    String?                  @unique
  captureId           String?                  @db.Uuid
  revision            Int                      @default(1)
  latestReason        String?
  metadataJson        Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  room           CallRoom                     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant    CallParticipant?             @relation(fields: [participantId], references: [id], onDelete: SetNull)
  createdByUser  User?                        @relation("CallExpectedSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recordingAsset RecordingAsset?              @relation(fields: [recordingAssetId], references: [id], onDelete: SetNull)
  revisions      CallExpectedSourceRevision[]

  @@index([roomId, status, retentionRole])
  @@index([participantId, status])
  @@index([roomId, sourceKind, expectedClientKind])
  @@index([captureId])
}

/// Append-only evidence for every recording-plan decision. The mutable row is
/// a current projection; these revisions preserve idempotency, authority,
/// before/after state, and the reason for waiving or canceling a planned source.
model CallExpectedSourceRevision {
  id            String                   @id @default(cuid())
  requestId     String                   @unique @db.Uuid
  requestSha256 String
  expectationId String
  roomId        String
  actorUserId   String
  action        CallExpectedSourceAction
  revision      Int
  beforeJson    Json                     @default("{}")
  afterJson     Json
  reason        String?
  createdAt     DateTime                 @default(now())

  expectation CallExpectedSource @relation(fields: [expectationId], references: [id], onDelete: Cascade)
  room        CallRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor       User               @relation("CallExpectedSourceRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([expectationId, revision])
  @@index([roomId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([expectationId, createdAt])
}

// Durable intent and provider acknowledgement for one explicit provider
// recording action. The request UUID makes a repeated tap/retry idempotent;
// the expected object path lets reconciliation recover a START whose response
// was lost without blindly creating a second provider recording.
model ProviderRecordingCommand {
  id                        String                         @id @default(cuid())
  requestId                 String                         @unique @db.Uuid
  roomId                    String
  actorUserId               String
  action                    ProviderRecordingCommandAction
  status                    ProviderRecordingCommandStatus @default(QUEUED)
  provider                  String                         @default("livekit")
  providerRoomId            String
  captureGroupId            String                         @db.Uuid
  recordingAssetId          String?
  providerEgressId          String?
  expectedStorageBucket     String?
  expectedStorageObjectPath String?
  consentVersion            String?
  consentSnapshotJson       Json                           @default("{}")
  requestJson               Json                           @default("{}")
  providerResponseJson      Json                           @default("{}")
  attemptCount              Int                            @default(0)
  leaseToken                String?                        @db.Uuid
  leaseExpiresAt            DateTime?
  lastAttemptAt             DateTime?
  dispatchedAt              DateTime?
  appliedAt                 DateTime?
  reconciledAt              DateTime?
  heldAt                    DateTime?
  failedAt                  DateTime?
  errorCode                 String?
  errorMessage              String?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  room           CallRoom                        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recordingAsset RecordingAsset?                 @relation(fields: [recordingAssetId], references: [id], onDelete: SetNull)
  events         ProviderRecordingEventReceipt[]

  @@index([roomId, createdAt])
  @@index([roomId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([recordingAssetId, createdAt])
  @@index([providerEgressId, createdAt])
  @@index([expectedStorageBucket, expectedStorageObjectPath])
}

// Authenticated LiveKit webhook events are append-only evidence. Event IDs are
// provider-unique, so webhook retries converge before any room or asset state
// changes. The raw payload is retained for audit/recovery, not treated as the
// source-media or transcript authority.
model ProviderRecordingEventReceipt {
  id                String    @id @default(cuid())
  providerEventId   String    @unique
  provider          String    @default("livekit")
  eventType         String
  roomId            String
  commandId         String?
  recordingAssetId  String?
  providerEgressId  String?
  providerCreatedAt DateTime?
  payloadJson       Json
  applied           Boolean   @default(false)
  applyMessage      String?
  receivedAt        DateTime  @default(now())
  appliedAt         DateTime?

  room           CallRoom                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  command        ProviderRecordingCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)
  recordingAsset RecordingAsset?           @relation(fields: [recordingAssetId], references: [id], onDelete: SetNull)

  @@index([roomId, receivedAt])
  @@index([providerEgressId, receivedAt])
  @@index([commandId, receivedAt])
  @@index([recordingAssetId, receivedAt])
}

model UploadChunk {
  id                String            @id @default(cuid())
  assetId           String
  chunkIndex        Int
  status            UploadChunkStatus @default(QUEUED)
  byteStart         BigInt?
  byteEnd           BigInt?
  byteSize          BigInt?
  checksum          String?
  storageObjectPath String?
  uploadedAt        DateTime?
  verifiedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  asset RecordingAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, chunkIndex])
  @@index([status, createdAt])
}

model TranscriptJob {
  id                       String              @id @default(cuid())
  roomId                   String?
  assetId                  String?
  studioMediaAssetId       String?
  studioProjectId          String?
  episodeProductionId      String?
  status                   TranscriptJobStatus @default(QUEUED)
  provider                 String              @default("pending")
  language                 String?
  requestedBy              String?
  startedAt                DateTime?
  completedAt              DateTime?
  errorMessage             String?
  processingManifestObject String?
  processingResultObject   String?
  sourceGeneration         String?
  sourceSha256             String?
  providerRequestId        String?
  providerResponseObject   String?
  workerBuildId            String?
  resultJson               Json                @default("{}")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  room                  CallRoom?                              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asset                 RecordingAsset?                        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  studioMediaAsset      StudioMediaAsset?                      @relation(fields: [studioMediaAssetId], references: [id], onDelete: Restrict)
  studioProject         StudioProject?                         @relation(fields: [studioProjectId], references: [id], onDelete: Restrict)
  episodeProduction     StudioEpisodeProduction?               @relation(fields: [episodeProductionId], references: [id], onDelete: Restrict)
  segments              TranscriptSegment[]
  words                 TranscriptWord[]
  verifications         TranscriptSegmentVerification[]
  speakerAttributions   TranscriptSpeakerAttribution[]
  evaluationWindows     TranscriptEvaluationWindow[]
  corrections           TranscriptCorrection[]
  terminologyCandidates StudioTranscriptTerminologyCandidate[]

  @@index([roomId, status, createdAt])
  @@index([assetId, status, createdAt])
  @@index([studioMediaAssetId, status, createdAt])
  @@index([studioProjectId, status, createdAt])
  @@index([episodeProductionId, status, createdAt])
  @@index([status, createdAt])
}

model TranscriptSegment {
  id              String   @id @default(cuid())
  transcriptJobId String
  speakerLabel    String?
  speakerUserId   String?
  startSeconds    Float
  endSeconds      Float
  text            String
  confidence      Float?
  metadataJson    Json     @default("{}")
  createdAt       DateTime @default(now())

  transcriptJob TranscriptJob                   @relation(fields: [transcriptJobId], references: [id], onDelete: Cascade)
  corrections   TranscriptCorrection[]
  words         TranscriptWord[]
  verifications TranscriptSegmentVerification[]

  @@index([transcriptJobId, startSeconds])
  @@index([speakerLabel])
}

// Provider words are immutable, generation-bound timing evidence. Editor
// selections and corrections anchor to these rows instead of mutable text
// offsets; human-reviewed corrections remain overlays on TranscriptSegment.
model TranscriptWord {
  id                String   @id @default(cuid())
  transcriptJobId   String
  segmentId         String
  providerWordIndex Int
  startSeconds      Float
  endSeconds        Float
  word              String
  punctuatedWord    String
  confidence        Float?
  speakerLabel      String?
  channel           Int?
  metadataJson      Json     @default("{}")
  createdAt         DateTime @default(now())

  transcriptJob TranscriptJob     @relation(fields: [transcriptJobId], references: [id], onDelete: Cascade)
  segment       TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([transcriptJobId, providerWordIndex])
  @@index([transcriptJobId, startSeconds])
  @@index([segmentId, providerWordIndex])
}

// Provider transcript segments remain immutable evidence. Corrections are
// reviewed overlays pinned to the provider text and timing that a person heard.
// Human corrections may be accepted at creation; AI-origin proposals must stay
// proposed until an authorized reviewer explicitly decides them.
model TranscriptCorrection {
  id                     String    @id @default(cuid())
  roomId                 String?
  transcriptJobId        String
  segmentId              String
  createdByUserId        String
  createdByEmailSnapshot String?
  clientRequestId        String
  origin                 String    @default("human")
  status                 String    @default("proposed")
  baseTextSha256         String
  expectedText           String    @db.Text
  expectedSpeakerLabel   String?
  startSecondsSnapshot   Float
  endSecondsSnapshot     Float
  correctedText          String?   @db.Text
  correctedSpeakerLabel  String?
  reason                 String?   @db.Text
  provenanceJson         Json      @default("{}")
  reviewedByUserId       String?
  reviewedAt             DateTime?
  reviewNote             String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  room                  CallRoom?                              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  transcriptJob         TranscriptJob                          @relation(fields: [transcriptJobId], references: [id], onDelete: Cascade)
  segment               TranscriptSegment                      @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  createdBy             User                                   @relation("TranscriptCorrectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy            User?                                  @relation("TranscriptCorrectionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  revisions             TranscriptCorrectionRevision[]
  terminologyCandidates StudioTranscriptTerminologyCandidate[]

  @@unique([createdByUserId, clientRequestId])
  @@index([roomId, status, createdAt])
  @@index([transcriptJobId, segmentId, status, updatedAt])
  @@index([reviewedByUserId, reviewedAt])
}

model TranscriptCorrectionRevision {
  id           String   @id @default(cuid())
  correctionId String
  revision     Int
  operation    String
  actorUserId  String?
  snapshotJson Json
  createdAt    DateTime @default(now())

  correction TranscriptCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  actor      User?                @relation("TranscriptCorrectionRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([correctionId, revision])
  @@index([actorUserId, createdAt])
}

// Project vocabulary is intentionally separate from provider transcript
// evidence. The current row is a fast projection; every mutation also writes
// an immutable revision, and each queued provider job retains its own compiled
// snapshot so later vocabulary edits cannot rewrite history.
model StudioTranscriptTerminologyTerm {
  id                     String   @id @default(cuid())
  projectId              String
  canonicalText          String
  normalizedText         String
  aliasesJson            Json     @default("[]")
  category               String   @default("general")
  pronunciationHint      String?
  contextHint            String?
  priority               Int      @default(50)
  status                 String   @default("active")
  currentRevision        Int      @default(1)
  createdByUserId        String?
  createdByEmailSnapshot String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project      StudioProject                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?                                  @relation("StudioTranscriptTerminologyTermCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revisions    StudioTranscriptTerminologyRevision[]
  acceptedFrom StudioTranscriptTerminologyCandidate[] @relation("StudioTranscriptTerminologyAcceptedTerm")

  @@unique([projectId, normalizedText])
  @@index([projectId, status, priority, updatedAt])
  @@index([createdByUserId, createdAt])
}

model StudioTranscriptTerminologyRevision {
  id                 String   @id @default(cuid())
  termId             String
  revision           Int
  operation          String
  actorUserId        String?
  actorEmailSnapshot String?
  snapshotJson       Json
  createdAt          DateTime @default(now())

  term  StudioTranscriptTerminologyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  actor User?                           @relation("StudioTranscriptTerminologyRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([termId, revision])
  @@index([actorUserId, createdAt])
}

// Accepted transcript corrections may suggest reusable terms, but they never
// mutate the vocabulary automatically. Review preserves the exact correction
// and proposed spelling that informed the decision.
model StudioTranscriptTerminologyCandidate {
  id                     String    @id @default(cuid())
  projectId              String
  sourceCorrectionId     String?
  sourceTranscriptJobId  String?
  proposedCanonicalText  String
  normalizedText         String
  aliasesJson            Json      @default("[]")
  category               String    @default("general")
  pronunciationHint      String?
  contextHint            String?
  priority               Int       @default(50)
  status                 String    @default("proposed")
  evidenceJson           Json      @default("{}")
  createdByUserId        String?
  createdByEmailSnapshot String?
  decidedByUserId        String?
  decidedByEmailSnapshot String?
  decisionNote           String?
  acceptedTermId         String?
  decidedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project          StudioProject                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCorrection TranscriptCorrection?            @relation(fields: [sourceCorrectionId], references: [id], onDelete: SetNull)
  sourceTranscript TranscriptJob?                   @relation(fields: [sourceTranscriptJobId], references: [id], onDelete: SetNull)
  createdBy        User?                            @relation("StudioTranscriptTerminologyCandidateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  decidedBy        User?                            @relation("StudioTranscriptTerminologyCandidateDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  acceptedTerm     StudioTranscriptTerminologyTerm? @relation("StudioTranscriptTerminologyAcceptedTerm", fields: [acceptedTermId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceCorrectionId])
  @@index([projectId, status, createdAt])
  @@index([sourceTranscriptJobId, status])
  @@index([decidedByUserId, decidedAt])
  @@index([acceptedTermId])
}

// Append-only proof that a person listened to an immutable provider segment
// and confirmed it needed no correction. A changed segment remains represented
// by TranscriptCorrection; this receipt closes the equally important reviewed-
// as-is state without inventing a no-op correction.
model TranscriptSegmentVerification {
  id                      String   @id @default(cuid())
  roomId                  String?
  transcriptJobId         String
  segmentId               String
  recordingAssetId        String?
  studioMediaAssetId      String?
  reviewerUserId          String
  reviewerEmailSnapshot   String?
  clientRequestId         String
  reviewKind              String   @default("confirmed-as-is")
  providerTextSha256      String
  providerSpeakerLabel    String?
  startSecondsSnapshot    Float
  endSecondsSnapshot      Float
  playbackSourceId        String
  playbackPositionSeconds Float
  reviewNote              String?  @db.Text
  createdAt               DateTime @default(now())

  room             CallRoom?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  transcriptJob    TranscriptJob     @relation(fields: [transcriptJobId], references: [id], onDelete: Restrict)
  segment          TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  recordingAsset   RecordingAsset?   @relation(fields: [recordingAssetId], references: [id], onDelete: Restrict)
  studioMediaAsset StudioMediaAsset? @relation(fields: [studioMediaAssetId], references: [id], onDelete: Restrict)
  reviewer         User              @relation("TranscriptSegmentVerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([reviewerUserId, clientRequestId], map: "TranscriptSegVerify_reviewer_request_key")
  @@index([roomId, createdAt], map: "TranscriptSegVerify_room_created_idx")
  @@index([transcriptJobId, segmentId, createdAt], map: "TranscriptSegVerify_job_segment_created_idx")
  @@index([recordingAssetId, createdAt], map: "TranscriptSegVerify_asset_created_idx")
  @@index([studioMediaAssetId, createdAt], map: "TranscriptSegVerify_studio_asset_created_idx")
}

// A playback-reviewed identity overlay for one provider diarization cluster.
// This is intentionally separate from TranscriptCorrection: identifying a
// speaker across turns does not claim that every provider word was reviewed.
// Historical rows remain as superseded audit evidence while a partial unique
// index in the migration permits only one active map per job/provider label.
model TranscriptSpeakerAttribution {
  id                         String    @id @default(cuid())
  roomId                     String
  transcriptJobId            String
  recordingAssetId           String
  providerSpeakerLabel       String
  participantId              String?
  participantUserIdSnapshot  String?
  participantDisplaySnapshot String
  participantEmailSnapshot   String?
  reviewedByUserId           String
  reviewerEmailSnapshot      String?
  clientRequestId            String
  status                     String    @default("active")
  providerSnapshotSha256     String
  sampleSegmentIdsJson       Json
  sampleEvidenceJson         Json
  playbackSourceId           String
  reviewNote                 String?   @db.Text
  reviewedAt                 DateTime
  supersededAt               DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  room           CallRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  transcriptJob  TranscriptJob    @relation(fields: [transcriptJobId], references: [id], onDelete: Restrict)
  recordingAsset RecordingAsset   @relation(fields: [recordingAssetId], references: [id], onDelete: Restrict)
  participant    CallParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  reviewedBy     User             @relation("TranscriptSpeakerAttributionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([reviewedByUserId, clientRequestId], map: "TranscriptSpeakerAttr_reviewer_request_key")
  @@index([roomId, createdAt], map: "TranscriptSpeakerAttr_room_created_idx")
  @@index([transcriptJobId, providerSpeakerLabel, status, updatedAt], map: "TranscriptSpeakerAttr_job_label_status_idx")
  @@index([participantId, createdAt], map: "TranscriptSpeakerAttr_participant_created_idx")
  @@index([recordingAssetId, createdAt], map: "TranscriptSpeakerAttr_asset_created_idx")
}

// An append-only, playback-reviewed reference window for private transcript
// accuracy evaluation. It freezes source, consent, provider, review-receipt,
// and human-reference evidence without changing provider transcript rows.
// Alternative provider candidates are separate evidence and never rewrite this
// approved reference.
model TranscriptEvaluationWindow {
  id                         String   @id @default(cuid())
  roomId                     String
  transcriptJobId            String
  recordingAssetId           String
  approvedByUserId           String
  approvedByEmailSnapshot    String?
  clientRequestId            String
  windowKeySha256            String   @unique(map: "TranscriptEvalWindow_key_sha_key")
  workload                   String
  conditionsJson             Json
  sourceStartSeconds         Float
  sourceEndSeconds           Float
  sourceDurationSeconds      Float
  sourceSha256               String
  sourceGeneration           String?
  playbackSourceId           String
  consentVersionSha256       String
  referenceRevisionId        String
  referenceContentSha256     String
  referenceWordsJson         Json
  sourceSegmentIdsJson       Json
  sourceReviewReceiptsJson   Json
  sourcePlaybackEvidenceJson Json
  providerSnapshotJson       Json
  reviewNote                 String?  @db.Text
  approvedAt                 DateTime
  createdAt                  DateTime @default(now())

  room           CallRoom                        @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "TranscriptEvalWindow_room_fkey")
  transcriptJob  TranscriptJob                   @relation(fields: [transcriptJobId], references: [id], onDelete: Restrict, map: "TranscriptEvalWindow_job_fkey")
  recordingAsset RecordingAsset                  @relation(fields: [recordingAssetId], references: [id], onDelete: Restrict, map: "TranscriptEvalWindow_asset_fkey")
  approvedBy     User                            @relation("TranscriptEvaluationWindowApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict, map: "TranscriptEvalWindow_approver_fkey")
  candidates     TranscriptEvaluationCandidate[]
  runWindows     TranscriptEvaluationRunWindow[]

  @@unique([approvedByUserId, clientRequestId], map: "TranscriptEvalWindow_approver_request_key")
  @@index([roomId, approvedAt], map: "TranscriptEvalWindow_room_approved_idx")
  @@index([transcriptJobId, approvedAt], map: "TranscriptEvalWindow_job_approved_idx")
  @@index([recordingAssetId, approvedAt], map: "TranscriptEvalWindow_asset_approved_idx")
  @@index([workload, approvedAt], map: "TranscriptEvalWindow_workload_approved_idx")
}

// A create-once snapshot of the data-handling policy in force when a private
// transcript candidate was produced. The hash covers the complete policy JSON;
// a later policy change creates a new receipt instead of rewriting history.
model TranscriptProviderPolicyReceipt {
  id                      String   @id @default(cuid())
  receiptSha256           String   @unique(map: "TranscriptProviderPolicy_sha_key")
  providerKey             String
  capturedByUserId        String
  capturedByEmailSnapshot String?
  policyJson              Json
  capturedAt              DateTime
  createdAt               DateTime @default(now())

  capturedBy User                            @relation("TranscriptProviderPolicyCapturer", fields: [capturedByUserId], references: [id], onDelete: Restrict, map: "TranscriptProviderPolicy_actor_fkey")
  candidates TranscriptEvaluationCandidate[]

  @@index([providerKey, capturedAt], map: "TranscriptProviderPolicy_provider_idx")
}

// One immutable provider attempt against one immutable, human-approved
// evaluation window. runKey binds retries and cross-window runs without
// pretending that two attempts are the same evidence. Raw provider output and
// normalized words stay private; ordinary Session projections expose metrics.
model TranscriptEvaluationCandidate {
  id                       String   @id @default(cuid())
  windowId                 String
  policyReceiptId          String
  submittedByUserId        String
  submittedByEmailSnapshot String?
  clientRequestId          String
  runKey                   String
  candidateKeySha256       String   @unique(map: "TranscriptEvalCandidate_key_sha_key")
  windowKeySha256Snapshot  String
  sourceSha256Snapshot     String
  referenceContentSha256   String
  providerKey              String
  providerName             String
  model                    String
  adapterVersion           String
  requestConfigSha256      String
  requestConfigJson        Json
  speakerAttribution       String
  timingGranularity        String
  outcome                  String
  providerRequestId        String?
  providerReceiptSha256    String?
  rawResponseSha256        String
  rawResponseJson          Json
  normalizedWordsJson      Json
  metricsJson              Json?
  elapsedMilliseconds      Int
  estimatedCostUsd         Float?
  errorCode                String?
  retryable                Boolean?
  completedAt              DateTime
  createdAt                DateTime @default(now())

  window                TranscriptEvaluationWindow                  @relation(fields: [windowId], references: [id], onDelete: Restrict, map: "TranscriptEvalCandidate_window_fkey")
  policy                TranscriptProviderPolicyReceipt             @relation(fields: [policyReceiptId], references: [id], onDelete: Restrict, map: "TranscriptEvalCandidate_policy_fkey")
  submittedBy           User                                        @relation("TranscriptEvaluationCandidateSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict, map: "TranscriptEvalCandidate_actor_fkey")
  corrections           TranscriptEvaluationCorrectionObservation[]
  baselineRunWindows    TranscriptEvaluationRunWindow[]             @relation("TranscriptEvaluationRunBaselineCandidate")
  terminologyRunWindows TranscriptEvaluationRunWindow[]             @relation("TranscriptEvaluationRunTerminologyCandidate")

  @@unique([submittedByUserId, clientRequestId], map: "TranscriptEvalCandidate_actor_request_key")
  @@unique([windowId, runKey], map: "TranscriptEvalCandidate_window_run_key")
  @@index([windowId, createdAt], map: "TranscriptEvalCandidate_window_created_idx")
  @@index([providerKey, model, createdAt], map: "TranscriptEvalCandidate_provider_model_idx")
}

// Durable operator intent for one byte-matched terminology experiment. Nest
// owns the observable control plane; provider credentials remain in the worker
// environment and are never persisted here or accepted by the web route.
model TranscriptEvaluationRun {
  id                   String                        @id @default(cuid())
  requestId            String                        @db.Uuid
  requestSha256        String
  roomId               String
  requestedByUserId    String
  runKey               String                        @unique(map: "TranscriptEvalRun_run_key")
  comparisonKey        String                        @unique(map: "TranscriptEvalRun_comparison_key")
  experimentKind       String                        @default("terminology")
  providerKey          String
  providerName         String
  model                String
  adapterVersion       String
  language             String?
  corpusRevisionSha256 String
  status               TranscriptEvaluationRunStatus @default(QUEUED)
  requestConfigJson    Json                          @default("{}")
  resultJson           Json                          @default("{}")
  attemptCount         Int                           @default(0)
  maxAttempts          Int                           @default(3)
  leaseToken           String?                       @db.Uuid
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  lastHeartbeatAt      DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  room        CallRoom                        @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "TranscriptEvalRun_room_fkey")
  requestedBy User                            @relation("TranscriptEvaluationRunRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, map: "TranscriptEvalRun_requester_fkey")
  windows     TranscriptEvaluationRunWindow[]

  @@unique([requestedByUserId, requestId], map: "TranscriptEvalRun_requester_request_key")
  @@index([roomId, createdAt], map: "TranscriptEvalRun_room_created_idx")
  @@index([status, leaseExpiresAt, createdAt], map: "TranscriptEvalRun_claim_idx")
  @@index([requestedByUserId, createdAt], map: "TranscriptEvalRun_requester_created_idx")
}

// One selected immutable reference window inside a run. The two candidate keys
// are fixed before execution, making partial completion and crash replay
// explicit rather than inferred from an operator's local files.
model TranscriptEvaluationRunWindow {
  id                     String                              @id @default(cuid())
  runId                  String
  windowId               String
  ordinal                Int
  status                 TranscriptEvaluationRunWindowStatus @default(QUEUED)
  baselineRunKey         String                              @unique(map: "TranscriptEvalRunWindow_baseline_key")
  terminologyRunKey      String                              @unique(map: "TranscriptEvalRunWindow_term_key")
  baselineCandidateId    String?
  terminologyCandidateId String?
  derivativeSha256       String?
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  run                  TranscriptEvaluationRun        @relation(fields: [runId], references: [id], onDelete: Cascade, map: "TranscriptEvalRunWindow_run_fkey")
  window               TranscriptEvaluationWindow     @relation(fields: [windowId], references: [id], onDelete: Restrict, map: "TranscriptEvalRunWindow_window_fkey")
  baselineCandidate    TranscriptEvaluationCandidate? @relation("TranscriptEvaluationRunBaselineCandidate", fields: [baselineCandidateId], references: [id], onDelete: Restrict, map: "TranscriptEvalRunWindow_baseline_candidate_fkey")
  terminologyCandidate TranscriptEvaluationCandidate? @relation("TranscriptEvaluationRunTerminologyCandidate", fields: [terminologyCandidateId], references: [id], onDelete: Restrict, map: "TranscriptEvalRunWindow_term_candidate_fkey")

  @@unique([runId, windowId], map: "TranscriptEvalRunWindow_run_window_key")
  @@unique([runId, ordinal], map: "TranscriptEvalRunWindow_run_ordinal_key")
  @@index([windowId, createdAt], map: "TranscriptEvalRunWindow_window_created_idx")
  @@index([runId, status, ordinal], map: "TranscriptEvalRunWindow_status_idx")
}

// Human correction effort is measured after candidate creation and therefore
// has its own append-only receipt. It never mutates candidate text or metrics.
model TranscriptEvaluationCorrectionObservation {
  id                     String   @id @default(cuid())
  candidateId            String
  reviewerUserId         String
  reviewerEmailSnapshot  String?
  clientRequestId        String
  candidateKeySha256     String
  referenceContentSha256 String
  elapsedMilliseconds    Int
  operationCount         Int
  observationJson        Json
  observedAt             DateTime
  createdAt              DateTime @default(now())

  candidate TranscriptEvaluationCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, map: "TranscriptEvalCorrection_candidate_fkey")
  reviewer  User                          @relation("TranscriptEvaluationCorrectionReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict, map: "TranscriptEvalCorrection_reviewer_fkey")

  @@unique([reviewerUserId, clientRequestId], map: "TranscriptEvalCorrection_reviewer_request_key")
  @@index([candidateId, observedAt], map: "TranscriptEvalCorrection_candidate_idx")
}

model CoachingNote {
  id           String                 @id @default(cuid())
  roomId       String?
  bookingId    String?
  engagementId String?
  authorUserId String?
  kind         CoachingNoteKind       @default(SESSION_NOTE)
  visibility   CoachingNoteVisibility @default(AUTHOR_PRIVATE)
  title        String?
  body         String
  sourceJson   Json                   @default("{}")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  room        CallRoom?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  booking     CoachingBooking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  engagement  CoachingEngagement?    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  authorUser  User?                  @relation("CoachingNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  actionItems ActionItem[]
  tagLinks    CoachingNoteTagLink[]
  revisions   CoachingNoteRevision[]

  @@index([roomId, createdAt])
  @@index([roomId, visibility, updatedAt])
  @@index([bookingId, createdAt])
  @@index([engagementId, visibility, updatedAt])
  @@index([engagementId, authorUserId, updatedAt])
  @@index([authorUserId, createdAt])
  @@index([kind, createdAt])
}

model CoachingNoteRevision {
  id           String   @id @default(cuid())
  noteId       String
  revision     Int
  operation    String
  actorUserId  String?
  snapshotJson Json
  createdAt    DateTime @default(now())

  note  CoachingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  actor User?        @relation("CoachingNoteRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([noteId, revision])
  @@index([actorUserId, createdAt])
}

// A Session output is a reviewed, recipient-bound snapshot assembled from
// canonical records. Releasing it changes in-app visibility only; delivery
// receipts record what Quipsly actually did without implying email or message
// delivery.
model SessionOutput {
  id                 String              @id
  roomId             String
  createdByUserId    String
  recipientUserId    String
  kind               SessionOutputKind   @default(CLIENT_FOLLOW_UP)
  status             SessionOutputStatus @default(DRAFT)
  title              String
  intro              String?
  nextSessionFocus   String?
  bodyJson           Json                @default("{}")
  sourceManifestJson Json                @default("{}")
  contentSha256      String
  revision           Int                 @default(1)
  releasedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  room       CallRoom                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("SessionOutputCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipient  User                    @relation("SessionOutputRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  revisions  SessionOutputRevision[]
  deliveries DeliveryEvent[]

  @@index([roomId, kind, status, updatedAt])
  @@index([recipientUserId, status, releasedAt])
  @@index([createdByUserId, status, updatedAt])
}

model SessionOutputRevision {
  id           String   @id @db.Uuid
  outputId     String
  revision     Int
  operation    String
  actorUserId  String
  snapshotJson Json
  createdAt    DateTime @default(now())

  output SessionOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  actor  User          @relation("SessionOutputRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([outputId, revision])
  @@index([actorUserId, createdAt])
}

model DeliveryEvent {
  id              String            @id @db.Uuid
  outputId        String
  roomId          String
  actorUserId     String
  recipientUserId String
  kind            DeliveryEventKind
  destination     String            @default("quipsly-session")
  status          String            @default("CONFIRMED")
  contentSha256   String
  clientRequestId String            @db.Uuid
  metadataJson    Json              @default("{}")
  occurredAt      DateTime
  createdAt       DateTime          @default(now())

  output    SessionOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  room      CallRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     User          @relation("DeliveryEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  recipient User          @relation("DeliveryEventRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, clientRequestId])
  @@index([outputId, kind, occurredAt])
  @@index([roomId, kind, occurredAt])
  @@index([recipientUserId, kind, occurredAt])
}

model ActionItem {
  id             String           @id @default(cuid())
  roomId         String?
  bookingId      String?
  noteId         String?
  assignedUserId String?
  projectId      String?
  engagementId   String?
  title          String
  detail         String?
  status         ActionItemStatus @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  sourceJson     Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  room                 CallRoom?                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  booking              CoachingBooking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  note                 CoachingNote?               @relation(fields: [noteId], references: [id], onDelete: SetNull)
  assignedUser         User?                       @relation("ActionItemAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  project              StudioProject?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  engagement           CoachingEngagement?         @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  goalLinks            GoalTaskLink[]
  planBlocks           WorkPlanBlock[]
  tagLinks             ActionItemTagLink[]
  evidenceReceipts     ActionItemEvidenceReceipt[]
  recurrenceOccurrence TaskOccurrence?
  reminder             TaskReminder?

  @@index([roomId, status])
  @@index([bookingId, status])
  @@index([assignedUserId, status])
  @@index([projectId, status, updatedAt])
  @@index([engagementId, status, updatedAt])
  @@index([dueAt])
}

// Reviewed observations append here instead of mutating canonical task state.
// A receipt can return to immutable source playback while the ActionItem keeps
// its independent title, status, owner, dates, recurrence, reminder, and tags.
model ActionItemEvidenceReceipt {
  id           String   @id
  actionItemId String
  actorUserId  String?
  kind         String
  note         String?
  evidenceJson Json     @default("{}")
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ActionItemEvidenceActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actionItemId, occurredAt])
  @@index([actorUserId, createdAt])
}

// A reminder is canonical user intent, not proof that any device displayed an
// alert. Device permission, scheduling, and delivery remain local projections.
model TaskReminder {
  id           String             @id
  actionItemId String             @unique
  ownerUserId  String
  remindAt     DateTime
  status       TaskReminderStatus @default(ACTIVE)
  sourceJson   Json               @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  actionItem ActionItem             @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  owner      User                   @relation("TaskReminderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  revisions  TaskReminderRevision[]

  @@index([ownerUserId, status, remindAt])
  @@index([status, remindAt])
}

// Current reminder state stays compact while every explicit create, move,
// cancel, and reactivate decision remains independently inspectable.
model TaskReminderRevision {
  id               String                @id
  reminderId       String
  actorUserId      String
  operation        TaskReminderOperation
  previousRemindAt DateTime?
  remindAt         DateTime?
  previousStatus   TaskReminderStatus?
  status           TaskReminderStatus
  sourceJson       Json                  @default("{}")
  createdAt        DateTime              @default(now())

  reminder TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  actor    User         @relation("TaskReminderRevisionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([reminderId, createdAt])
  @@index([actorUserId, createdAt])
}

// A series stores the human wall-clock promise. Each occurrence stores the
// exact instant and canonical ActionItem created from that promise. Keeping
// both prevents UTC arithmetic from moving a 9:00 task across DST.
model TaskRecurrenceSeries {
  id               String                  @id @default(cuid())
  ownerUserId      String
  projectId        String?
  title            String
  detail           String?
  cadence          TaskRecurrenceCadence
  frequency        TaskRecurrenceFrequency
  interval         Int                     @default(1)
  timezone         String
  localTimeMinutes Int
  anchorLocalDate  String
  anchorDayOfMonth Int
  status           TaskRecurrenceStatus    @default(ACTIVE)
  endedAt          DateTime?
  sourceJson       Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  owner       User             @relation("TaskRecurrenceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  project     StudioProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  occurrences TaskOccurrence[]

  @@index([ownerUserId, status, updatedAt])
  @@index([projectId, status])
}

model TaskOccurrence {
  id                 String               @id @default(cuid())
  seriesId           String
  actionItemId       String?              @unique
  occurrenceKey      String
  scheduledLocalDate String
  scheduledFor       DateTime
  status             TaskOccurrenceStatus @default(MATERIALIZED)
  sourceJson         Json                 @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  series     TaskRecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  actionItem ActionItem?          @relation(fields: [actionItemId], references: [id], onDelete: SetNull)

  @@unique([seriesId, occurrenceKey])
  @@index([seriesId, scheduledFor])
  @@index([status, scheduledFor])
}

// Goal is durable direction, not a decorated note. Session context may
// project into it, but its identity and lifecycle survive the source session.
model Goal {
  id           String     @id @default(cuid())
  ownerUserId  String
  roomId       String?
  bookingId    String?
  projectId    String?
  engagementId String?
  parentGoalId String?
  title        String
  description  String?
  status       GoalStatus @default(ACTIVE)
  targetAt     DateTime?
  achievedAt   DateTime?
  sourceJson   Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stageId      String?

  owner            User                    @relation("GoalOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  room             CallRoom?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  booking          CoachingBooking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  project          StudioProject?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  engagement       CoachingEngagement?     @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  parent           Goal?                   @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children         Goal[]                  @relation("GoalHierarchy")
  taskLinks        GoalTaskLink[]
  progressReceipts GoalProgressReceipt[]
  planBlocks       WorkPlanBlock[]
  tagLinks         GoalTagLink[]
  chatMessages     StudioNestChatMessage[]
  stage            StudioWorkflowStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, status, updatedAt])
  @@index([roomId, status])
  @@index([bookingId, status])
  @@index([projectId, status])
  @@index([engagementId, status, updatedAt])
  @@index([parentGoalId])
}

model GoalTaskLink {
  goalId          String
  actionItemId    String
  relationship    GoalTaskRelationship @default(CONTRIBUTES)
  createdByUserId String?
  sourceJson      Json                 @default("{}")
  createdAt       DateTime             @default(now())

  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("GoalTaskLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([goalId, actionItemId])
  @@index([actionItemId, relationship])
  @@index([createdByUserId, createdAt])
}

model GoalProgressReceipt {
  id              String   @id @default(cuid())
  goalId          String
  actorUserId     String?
  kind            String
  progressPercent Int?
  note            String?
  evidenceJson    Json     @default("{}")
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor User? @relation("GoalProgressActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([goalId, occurredAt])
  @@index([actorUserId, createdAt])
}

// A personal focus block says when one actor intends to work. It is not the
// task deadline, the goal target, a coaching appointment, or provider evidence.
model WorkPlanBlock {
  id            String              @id @default(cuid())
  ownerUserId   String
  actionItemId  String?
  goalId        String?
  startsAt      DateTime
  endsAt        DateTime
  timezone      String
  status        WorkPlanBlockStatus @default(PLANNED)
  completedAt   DateTime?
  // Explicitly reported work, not inferred from the planned window. Historical
  // completed blocks may remain null so review surfaces can say "not recorded".
  actualMinutes Int?
  sourceJson    Json                @default("{}")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  owner      User        @relation("WorkPlanBlockOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  actionItem ActionItem? @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, startsAt])
  @@index([actionItemId, startsAt])
  @@index([goalId, startsAt])
}

model CompanySupportRequest {
  id                     String            @id @default(cuid())
  name                   String
  email                  String
  phone                  String?
  preferredContactMethod ContactPreference
  supportType            String
  note                   String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  userId                 String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([supportType, createdAt])
  @@index([userId, createdAt])
}

model WorldHubProviderConnection {
  id                String    @id @default(cuid())
  providerKey       String    @unique
  providerKind      String
  displayName       String
  status            String    @default("planned")
  accountId         String?
  accountName       String?
  avatarUrl         String?
  accountLabel      String?
  capabilitiesJson  Json
  requiredEnvJson   Json
  configuredEnvJson Json
  missingEnvJson    Json
  setupUrl          String?
  setupNotes        String?
  healthStatus      String    @default("not_checked")
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events          WorldHubProviderEvent[]
  syncJobs        WorldHubProviderSyncJob[]
  offers          WorldHubOffer[]
  orders          WorldHubOrder[]
  fulfillmentJobs WorldHubFulfillmentJob[]

  @@index([providerKind, status])
  @@index([status, updatedAt])
}

model WorldHubProviderEvent {
  id                 String    @id @default(cuid())
  connectionId       String
  eventType          String
  externalEventId    String?
  idempotencyKey     String?
  verificationStatus String    @default("unchecked")
  processingStatus   String    @default("received")
  payloadHash        String?
  payloadSummaryJson Json
  errorMessage       String?
  occurredAt         DateTime?
  receivedAt         DateTime  @default(now())
  processedAt        DateTime?
  retryCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connection         WorldHubProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entitlementLedgers EntitlementLedger[]

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, receivedAt])
  @@index([processingStatus, receivedAt])
}

model WorldHubProviderSyncJob {
  id               String    @id @default(cuid())
  connectionId     String?
  providerKey      String
  jobType          String
  subjectType      String
  subjectId        String?
  status           String    @default("queued")
  payloadJson      Json
  resultJson       Json?
  errorMessage     String?
  requestedByEmail String?
