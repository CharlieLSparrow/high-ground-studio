model StudioStoryboardFrame {
  id                String   @id @default(cuid())
  storyboardId      String
  sortOrder         Int      @default(0)
  frameNumber       String
  imageUrl          String?
  action            String   @db.Text
  dialogue          String?  @db.Text
  cameraInfo        String   @default("Static")
  shotSize          String   @default("Medium Shot")
  lens              String?
  cameraMovement    String?
  mediaClipId       String?
  estimatedDuration Int?
  vfxNotes          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  storyboard      StudioStoryboard       @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  scrollPanelRefs StudioScrollPanelRef[]

  @@index([storyboardId, sortOrder])
}

// -----------------------------------------------------------------------------
// NEST CHAT
// -----------------------------------------------------------------------------

model StudioNestChatThread {
  id        String   @id @default(cuid())
  projectId String
  key       String   @default("default")
  title     String   @default("Nest Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  StudioProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages StudioNestChatMessage[]

  @@unique([projectId, key])
  @@index([projectId, updatedAt])
}

model StudioNestChatMessage {
  id           String   @id @default(cuid())
  projectId    String
  threadId     String
  authorEmail  String?
  authorName   String?
  body         String   @db.Text
  gifUrl       String?
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project StudioProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread  StudioNestChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([threadId, createdAt])
}

// -----------------------------------------------------------------------------
// QUIPSLY ASSISTANT
// -----------------------------------------------------------------------------

model StudioAssistantSession {
  id         String   @id @default(cuid())
  projectId  String
  documentId String?
  title      String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages StudioAssistantMessage[]
  actions  StudioAssistantAction[]

  @@index([projectId, status])
}

model StudioAssistantMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  content     String
  contextJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session StudioAssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model StudioAssistantLedger {
  id             String   @id @default(cuid())
  actionId       String
  previousStatus String?
  newStatus      String
  notes          String?
  createdAt      DateTime @default(now())

  action StudioAssistantAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

model StudioAssistantAction {
  id          String   @id @default(cuid())
  sessionId   String
  kind        String
  label       String
  explanation String?
  riskLevel   String
  payloadJson Json
  status      String   @default("proposed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session StudioAssistantSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ledgers StudioAssistantLedger[]

  @@index([sessionId, createdAt])
}

// -----------------------------------------------------------------------------
// SCROLL-NATIVE EXPERIENCES (BETA)
// -----------------------------------------------------------------------------

model ScrollInteraction {
  id              String   @id @default(cuid())
  experienceId    String // Maps to StudioStoryboard.id or StudioDocument.id
  panelId         String? // Maps to StudioStoryboardFrame.id or StudioDocumentBlock.id
  userId          String? // Nullable for guest/client review links
  interactionType String // 'COMMENT', 'RATING', 'FAVORITE', 'SELECTION', 'COMPLETION'
  payloadJson     Json // e.g. { rating: 5 }, { text: "Fix this color" }
  createdAt       DateTime @default(now())

  @@index([experienceId, panelId])
  @@index([interactionType])
}

model StudioScrollExperience {
  id           String   @id @default(cuid())
  projectId    String
  storyboardId String?
  slug         String
  title        String
  layout       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    StudioProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboard StudioStoryboard?     @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  sections   StudioScrollSection[]

  @@index([projectId])
  @@index([storyboardId])
}

model StudioScrollSection {
  id           String   @id @default(cuid())
  experienceId String
  sortOrder    Int
  label        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience StudioScrollExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  panelRefs  StudioScrollPanelRef[]

  @@index([experienceId, sortOrder])
}

model StudioScrollPanelRef {
  id         String   @id @default(cuid())
  sectionId  String
  frameId    String? // Links to StudioStoryboardFrame if it exists
  externalId String? // E.g., 'panel-001' from JSON if no strict relation
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section StudioScrollSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  frame   StudioStoryboardFrame? @relation(fields: [frameId], references: [id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@index([frameId])
}

// -----------------------------------------------------------------------------
// QUIPLORE DOMAIN (SEMANTIC RESEARCH & CITATIONS)
// -----------------------------------------------------------------------------

model QuipLoreAuthor {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  works   QuipLoreWork[]
  quotes  QuipLoreQuote[]

  @@index([projectId])
}

model QuipLoreWork {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String?
  title       String
  description String?   @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project StudioProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  QuipLoreAuthor?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sources QuipLoreSource[]
  quotes  QuipLoreQuote[]

  @@index([projectId])
}

model QuipLoreSource {
  id          String   @id @default(cuid())
  projectId   String
  workId      String?
  title       String
  url         String?
  isbn        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work      QuipLoreWork?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  quotes    QuipLoreQuote[]
  citations QuipLoreCitation[]

  @@index([projectId])
}

model QuipLoreQuote {
  id        String                      @id @default(cuid())
  projectId String
  workId    String?
  authorId  String?
  sourceId  String?
  text      String                      @db.Text
  context   String?                     @db.Text
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  project     StudioProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work        QuipLoreWork?            @relation(fields: [workId], references: [id], onDelete: SetNull)
  author      QuipLoreAuthor?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  source      QuipLoreSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  citations   QuipLoreCitation[]
  annotations QuipLoreUserAnnotation[]
  tags        QuipLoreTag[]            @relation("QuoteTags")
  collections QuipLoreCollection[]     @relation("QuoteCollections")

  @@index([projectId])
}

model QuipLoreCitation {
  id        String   @id @default(cuid())
  projectId String
  quoteId   String
  sourceId  String?
  locator   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote   QuipLoreQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  source  QuipLoreSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([quoteId])
}

model QuipLoreUserAnnotation {
  id        String   @id @default(cuid())
  projectId String
  quoteId   String
  note      String   @db.Text
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote   QuipLoreQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([quoteId])
}

model QuipLoreTheme {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags    QuipLoreTag[]

  @@index([projectId])
}

model QuipLoreTag {
  id        String   @id @default(cuid())
  projectId String
  themeId   String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theme   QuipLoreTheme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  quotes  QuipLoreQuote[] @relation("QuoteTags")

  @@unique([projectId, name])
}

model QuipLoreCollection {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project StudioProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes  QuipLoreQuote[] @relation("QuoteCollections")

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// Native App Models (Quipsly Notes MVP)
// -----------------------------------------------------------------------------

model QuipslyNote {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String
  tags       String[] @default([])
  folderName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
}

// Browser episode editing keeps immutable sync/source truth separate from
// lightweight, attributable edit intent.
model StudioEditBaseline {
  id                  String   @id @default(cuid())
  projectId           String
  episodeProductionId String
  stableKey           String
  version             Int      @default(1)
  label               String
  durationSeconds     Float    @default(0)
  sourceFingerprint   String?
  sourceManifestJson  Json     @default("{}")
  syncSummaryJson     Json     @default("{}")
  importReceiptJson   Json     @default("{}")
  importedByUserId    String?
  importedByEmail     String?
  importedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  branches StudioEditBranch[]

  @@unique([episodeProductionId, stableKey, version])
  @@index([projectId, episodeProductionId])
}

model StudioEditBranch {
  id                 String   @id @default(cuid())
  baselineId         String
  slug               String
  name               String
  role               String   @default("episode-edit")
  status             String   @default("active")
  headRevision       Int      @default(0)
  stateJson          Json     @default("{}")
  stateFingerprint   String?
  createdByUserId    String?
  createdByEmail     String?
  createdByActorType String   @default("human")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  baseline    StudioEditBaseline         @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  operations  StudioEditOperation[]
  annotations StudioTimelineAnnotation[]

  @@unique([baselineId, slug])
  @@index([baselineId, status])
}

model StudioEditOperation {
  id                       String    @id @default(cuid())
  branchId                 String
  revision                 Int
  clientRequestId          String
  expectedRevision         Int
  actorUserId              String?
  actorEmail               String?
  actorLabel               String?
  actorType                String    @default("human")
  operationType            String
  sequenceTime             Float?
  endTime                  Float?
  payloadJson              Json      @default("{}")
  beforeJson               Json?
  afterJson                Json?
  sourceTimestampPrecision String    @default("exact")
  sourceCreatedBefore      DateTime?
  createdAt                DateTime  @default(now())

  branch StudioEditBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, revision])
  @@unique([branchId, clientRequestId])
  @@index([branchId, createdAt])
  @@index([actorUserId, createdAt])
}

model StudioTimelineAnnotation {
  id                 String    @id @default(cuid())
  branchId           String
  startSeconds       Float
  endSeconds         Float?
  kind               String    @default("note")
  title              String?
  body               String?
  hookKey            String?
  tagsJson           Json      @default("[]")
  status             String    @default("active")
  createdByUserId    String?
  createdByEmail     String?
  createdByActorType String    @default("human")
  clientRequestId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  branch StudioEditBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, clientRequestId])
  @@index([branchId, startSeconds])
  @@index([branchId, status, createdAt])
}
