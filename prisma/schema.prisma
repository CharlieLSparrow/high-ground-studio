  sourceSha256     String
  sourceGeneration String
  startSeconds     Float
  endSeconds       Float
  requestSha256    String
  candidateJson    Json
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  project   StudioProject                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     StudioMediaAsset                      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source    StudioVideoSource                     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  reviews   StudioDialogueRepairReviewReceipt[]
  auditions StudioDialogueRepairAuditionReceipt[]

  @@unique([projectId, createdByEmail, clientRequestId], map: "StudioDialogueRepairCandidate_project_actor_request_key")
  @@index([projectId, assetId, occurredAt], map: "StudioDialogueRepairCandidate_project_asset_occurred_idx")
  @@index([sourceId, occurredAt], map: "StudioDialogueRepairCandidate_source_occurred_idx")
}

// A post-render matched A/B judgment binds both listened contexts to the exact
// source, candidate, processing job, and verified preview bytes. It is
