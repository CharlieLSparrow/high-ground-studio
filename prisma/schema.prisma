// Durable overlays around immutable source material. The source bytes/text stay
// untouched; selectors retain both positions and quote context so anchors can be
// verified, exported, and repaired without silently moving a person's note.
model StudioSourceAnnotation {
  id                     String    @id @default(cuid())
  projectId              String
  sourceUnitId           String
  documentId             String?
  blockId                String?
  createdByUserId        String?
  createdByEmailSnapshot String?
  kind                   String    @default("note")
  status                 String    @default("active")
  visibility             String    @default("private")
  body                   String    @db.Text
  selectorKind           String
  startOffset            Int?
  endOffset              Int?
  exactText              String?   @db.Text
  prefixText             String?   @db.Text
  suffixText             String?   @db.Text
  startSeconds           Float?
  endSeconds             Float?
  sourceFingerprint      String?
  clientRequestId        String?
  provenanceJson         Json      @default("{}")
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project    StudioProject                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUnit StudioSourceUnit                 @relation(fields: [sourceUnitId], references: [id], onDelete: Restrict)
  document   StudioDocument?                  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  block      StudioDocumentBlock?             @relation(fields: [blockId], references: [id], onDelete: SetNull)
  createdBy  User?                            @relation("StudioSourceAnnotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tags       StudioSourceAnnotationTag[]
  revisions  StudioSourceAnnotationRevision[]
  uses       StudioSourceAnnotationUse[]

  @@unique([createdByUserId, clientRequestId])
  @@index([projectId, visibility, status, updatedAt])
  @@index([sourceUnitId, status, updatedAt])
  @@index([createdByUserId, visibility, updatedAt])
  @@index([documentId, blockId])
}

