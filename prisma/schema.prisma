}

// Candidates are immutable source-clock evidence. Current review state is
// projected from append-only receipts; detector or UI state never rewrites the
// candidate that a person actually heard.
model StudioDialogueRepairCandidate {
  id               String   @id
  projectId        String
  assetId          String
  sourceId         String
  createdByUserId  String?
  createdByEmail   String
  clientRequestId  String
