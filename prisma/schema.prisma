enum StoryEntityType {
  CHARACTER
  SETTING
  SCENE
  RELATIONSHIP
  TIMELINE_EVENT
  THEME_MOTIF
  COMIC_ACT
  COMIC_PANEL
  BEAT
}

enum StoryBibleActionStatus {
  PENDING
  APPROVED
  REJECTED
  UNDONE
}

enum StoryBibleActionType {
  PROPOSE_ENTITY
  PROPOSE_ENTITY_UPDATE
  PROPOSE_RELATIONSHIP
}

model StoryEntity {
  id         String          @id @default(cuid())
  externalId String?         @unique
  projectId  String
  type       StoryEntityType
  name       String
  aliases    String[]        @default([])
  attributes Json            @default("{}")
  createdAt  DateTime        @default(now())
