enum StudioEpisodeAudioTrackDecisionOperation {
  SET
  WITHDRAW
}

enum StudioEpisodeAudioTrackDecisionKind {
  TRACK_ROLE
  PARTICIPANT
  PROGRAM_CLOCK
  MIX_DISPOSITION
}

// Episode audio identity and mix-intent decisions append here. Current state is
// projected from this ledger; changing a role, participant, clock, or inclusion
// never rewrites retained media, an older receipt, or the Episode timeline.
// The program fingerprint makes decisions visibly stale when the attached
// source set changes instead of silently applying them to a different program.
model StudioEpisodeAudioTrackDecisionReceipt {
  id                       String                                   @id @default(cuid())
  projectId                String
  episodeProductionId      String
  assetId                  String
  sourceId                 String
  actorUserId              String?
  actorEmail               String
  clientRequestId          String
  operation                StudioEpisodeAudioTrackDecisionOperation
  decisionKind             StudioEpisodeAudioTrackDecisionKind
  decisionValue            String
  decisionLabel            String?
  targetReceiptId          String?
  programFingerprintSha256 String
  sourceSha256             String
  sourceGeneration         String
  sourceSizeBytes          BigInt
  requestSha256            String
  evidenceJson             Json                                     @default("{}")
  reason                   String?
  occurredAt               DateTime
  createdAt                DateTime                                 @default(now())

  project            StudioProject                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeProduction  StudioEpisodeProduction                  @relation(fields: [episodeProductionId], references: [id], onDelete: Cascade)
  asset              StudioMediaAsset                         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  source             StudioVideoSource                        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  targetReceipt      StudioEpisodeAudioTrackDecisionReceipt?  @relation("StudioEpisodeAudioDecisionWithdrawal", fields: [targetReceiptId], references: [id], onDelete: Restrict)
  withdrawalReceipts StudioEpisodeAudioTrackDecisionReceipt[] @relation("StudioEpisodeAudioDecisionWithdrawal")

  @@unique([projectId, actorEmail, clientRequestId], map: "StudioEpisodeAudioDecision_project_actor_request_key")
  @@index([episodeProductionId, decisionKind, occurredAt], map: "StudioEpisodeAudioDecision_episode_kind_time_idx")
  @@index([assetId, sourceId, decisionKind, occurredAt], map: "StudioEpisodeAudioDecision_track_kind_time_idx")
  @@index([targetReceiptId], map: "StudioEpisodeAudioDecision_target_idx")
  @@index([programFingerprintSha256], map: "StudioEpisodeAudioDecision_program_fingerprint_idx")
}

enum StudioEpisodeAudioReviewDecision {
