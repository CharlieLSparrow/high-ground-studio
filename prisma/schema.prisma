  stableId         String
  order            Int
  title            String?
  body             String
  sourceLabel      String?
  sourcePath       String?
  externalId       String?
  projectionStatus StudioProjectionStatus @default(private)
  isPrivate        Boolean                @default(true)
  archivedAt       DateTime?
  archivedByLabel  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  document             StudioDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taggedSpans          StudioTaggedSpan[]
  knowledgeNodes       StudioKnowledgeNode[]
  sourceAnnotations    StudioSourceAnnotation[]
  sourceAnnotationUses StudioSourceAnnotationUse[]

  @@unique([documentId, stableId])
  @@unique([documentId, order])
  @@index([documentId, order])
  @@index([documentId, archivedAt, order])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// StudioViewDefinition — persisted named views for a project workspace.
// Stores tag/category filters and display settings so users can save custom
// lens configurations (Book Mode, Show Mode, Quote Database, etc.) that
// survive across sessions without being embedded in client state.
// ---------------------------------------------------------------------------
model StudioViewDefinition {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  type            String   @default("review")
  filters         Json     @default("{}")
  displaySettings Json     @default("{}")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model StudioTag {
  id              String                  @id @default(cuid())
  projectId       String
  slug            String
  label           String
  description     String?
  category        StudioTagCategory       @default(meaning)
  nodeType        StudioKnowledgeNodeType @default(source_note)
  isPrivate       Boolean                 @default(true)
  isActive        Boolean                 @default(true)
  archivedAt      DateTime?
  mergedIntoTagId String?
  mergedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  hexColor        String?
  iconName        String?
  uiCategory      StudioTagUICategory?

  project               StudioProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taggedSpans           StudioTaggedSpan[]
  knowledgeNodes        StudioKnowledgeNode[]
  mediaClips            MediaClip[]
  sourceAnnotations     StudioSourceAnnotationTag[]
  coachingNotes         CoachingNoteTagLink[]
  documents             StudioDocumentTagLink[]
  actionItems           ActionItemTagLink[]
  goals                 GoalTagLink[]
  callRooms             CallRoomTagLink[]
  storyCards            StudioStoryCardTagLink[]
  aliases               StudioTagAlias[]
  revisions             StudioTagRevision[]
  mergedInto            StudioTag?                  @relation("StudioTagMergeRedirect", fields: [mergedIntoTagId], references: [id], onDelete: SetNull)
  mergedTags            StudioTag[]                 @relation("StudioTagMergeRedirect")
  mergeReceiptsAsSource StudioTagMergeReceipt[]     @relation("StudioTagMergeSource")
  mergeReceiptsAsTarget StudioTagMergeReceipt[]     @relation("StudioTagMergeTarget")
  promotedCandidates    StudioTagCandidate[]        @relation("StudioTagCandidatePromotion")

  @@unique([projectId, slug])
  @@index([projectId, category])
  @@index([projectId, isActive])
  @@index([mergedIntoTagId])
}

// Imported keywords remain review candidates with exact source evidence until
// a Nest editor deliberately promotes one into canonical human vocabulary.
model StudioTagCandidate {
  id               String                   @id @default(cuid())
  projectId        String
  slug             String
  label            String
  status           StudioTagCandidateStatus @default(PENDING)
  promotedTagId    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  project     StudioProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promotedTag StudioTag?                   @relation("StudioTagCandidatePromotion", fields: [promotedTagId], references: [id], onDelete: SetNull)
  evidence    StudioTagCandidateEvidence[]
  revisions   StudioTagCandidateRevision[]

  @@unique([projectId, slug])
  @@index([projectId, status, updatedAt])
  @@index([promotedTagId])
}

model StudioTagCandidateEvidence {
  id             String   @id @default(cuid())
  candidateId    String
  fingerprint    String
  sourceKind     String
  sourceIdentity String
  labelSnapshot  String
  provenanceJson Json     @default("{}")
  importedAt     DateTime @default(now())

  candidate StudioTagCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, fingerprint])
  @@index([sourceKind, importedAt])
}

// Review decisions are append-only even though the candidate row remains the
// fast current-state projection.
model StudioTagCandidateRevision {
  id           String   @id @default(cuid())
  candidateId  String
  revision     Int
  operation    String
  actorUserId  String?
  snapshotJson Json
  createdAt    DateTime @default(now())

  candidate StudioTagCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, revision])
  @@index([actorUserId, createdAt])
}

// Human vocabulary can change without breaking older Capture input, saved
// searches, or provenance. Aliases always resolve to one canonical tag inside
// the same Nest; mutation services reject cross-table slug ambiguity.
model StudioTagAlias {
  id              String   @id @default(cuid())
  projectId       String
  tagId           String
  slug            String
  label           String
  provenanceJson  Json     @default("{}")
  createdByUserId String?
  createdAt       DateTime @default(now())

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     StudioTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([tagId, createdAt])
}

// Append-only rename/archive/restore evidence. The current StudioTag remains
// the fast read model while revisions preserve the human decision boundary.
model StudioTagRevision {
  id           String   @id @default(cuid())
  tagId        String
  revision     Int
  operation    String
  actorUserId  String?
  snapshotJson Json
  createdAt    DateTime @default(now())

  tag StudioTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, revision])
  @@index([actorUserId, createdAt])
}

// Exact association snapshots make a global taxonomy merge inspectable and
// technically reversible without deleting either tag identity.
model StudioTagMergeReceipt {
  id           String   @id @default(cuid())
  projectId    String
  sourceTagId  String
  targetTagId  String
  actorUserId  String?
  impactHash   String
  snapshotJson Json
  createdAt    DateTime @default(now())

  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTag StudioTag     @relation("StudioTagMergeSource", fields: [sourceTagId], references: [id], onDelete: Restrict)
  targetTag StudioTag     @relation("StudioTagMergeTarget", fields: [targetTagId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([sourceTagId, createdAt])
  @@index([targetTagId, createdAt])
}

// Work and Session tags are explicit per-entity joins. The linked StudioTag
// supplies canonical project identity; mutation services reject cross-project
// links. Keeping separate joins makes ownership, access, and deletion behavior
// inspectable without an orphan-prone polymorphic target column.
model ActionItemTagLink {
  actionItemId    String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  tag        StudioTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ActionItemTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([actionItemId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

model CoachingNoteTagLink {
  noteId          String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  note      CoachingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag       StudioTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("CoachingNoteTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([noteId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

// Document-level classification is distinct from excerpt-level evidence.
// StudioTaggedSpan remains the anchored passage overlay; this explicit join
// classifies the durable document identity without manufacturing a text range.
model StudioDocumentTagLink {
  documentId      String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  document  StudioDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag       StudioTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("StudioDocumentTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([documentId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

model GoalTagLink {
  goalId          String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag       StudioTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("GoalTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([goalId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

model CallRoomTagLink {
  roomId          String
  tagId           String
  createdByUserId String?
  sourceJson      Json     @default("{}")
  createdAt       DateTime @default(now())

  room      CallRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tag       StudioTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CallRoomTagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([roomId, tagId])
  @@index([tagId, createdAt])
  @@index([createdByUserId, createdAt])
}

model StudioTaggedSpan {
  id                    String                 @id @default(cuid())
  documentId            String
  blockId               String
  tagId                 String
  startOffset           Int
  endOffset             Int
  selectedText          String
  noteBody              String?                @db.Text
  documentStableId      String
  documentTitleSnapshot String
  blockStableId         String
  blockTitleSnapshot    String?
  sourceLabel           String?
  sourcePath            String?
  sourceExternalId      String?
  projectionStatus      StudioProjectionStatus @default(private)
  isPrivate             Boolean                @default(true)
  createdByLabel        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  document      StudioDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  block         StudioDocumentBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag           StudioTag            @relation(fields: [tagId], references: [id], onDelete: Restrict)
  knowledgeNode StudioKnowledgeNode?

  @@unique([blockId, tagId, startOffset, endOffset])
  @@index([documentId, blockId])
  @@index([tagId])
  @@index([projectionStatus, createdAt])
  @@index([documentStableId, blockStableId])
}

model StudioKnowledgeNode {
  id                    String                  @id @default(cuid())
  externalId            String?                 @unique
  projectId             String
  documentId            String
  blockId               String
  taggedSpanId          String                  @unique
  tagId                 String
  tagLabel              String
  tagCategory           StudioTagCategory
  nodeType              StudioKnowledgeNodeType @default(source_note)
  sourceText            String
  title                 String
  body                  String
  projectionStatus      StudioProjectionStatus  @default(projection_not_approved)
  reviewStatus          String                  @default("draft")
  isPrivate             Boolean                 @default(true)
  documentStableId      String
  documentTitleSnapshot String
  blockStableId         String
  blockTitleSnapshot    String?
  spanStartOffset       Int
  spanEndOffset         Int
  sourceLabel           String?
  sourcePath            String?
  createdByLabel        String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  project    StudioProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   StudioDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  block      StudioDocumentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  taggedSpan StudioTaggedSpan    @relation(fields: [taggedSpanId], references: [id], onDelete: Cascade)
  tag        StudioTag           @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@index([projectId, projectionStatus])
  @@index([tagId])
  @@index([documentId, blockId])
  @@index([reviewStatus, createdAt])
}

// -----------------------------------------------------------------------------
// USER ENGAGEMENT MODELS (Massive Swings Pipeline)
// -----------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippets  Snippet[]
  bookmarks Bookmark[]

  @@unique([userId, slug])
  @@index([userId, isPublic])
}

model Snippet {
  id                 String   @id @default(cuid())
  userId             String
  collectionId       String?
  sourceUrl          String?
  sourceTitle        String?
  highlightedText    String
  note               String?
  metadataJson       Json?
  captureFingerprint String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection      Collection?                          @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  researchFilings StudioPersonalSourceFiling[]
  captureReceipts StudioPersonalSourceCaptureReceipt[]

  @@unique([userId, captureFingerprint])
  @@index([userId, createdAt])
  @@index([collectionId])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  collectionId String?
  url          String
  title        String
  metadataJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection      Collection?                          @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  researchFilings StudioPersonalSourceFiling[]
  captureReceipts StudioPersonalSourceCaptureReceipt[]

  @@unique([userId, url])
  @@index([userId, createdAt])
  @@index([collectionId])
}

enum QuipslyNodeType {
  PERSON
  QUOTE
  THEME
  SOURCE_WORK
  EVIDENCE
  LORELIST
}

enum QuipslyEdgeType {
  QUOTED_BY
  APPEARS_IN
  SUPPORTED_BY
  HAS_THEME
  CONTAINS
  RELATED_TO
  VARIANT_OF
}

model QuipslyNode {
  id          String          @id @default(cuid())
  slug        String          @unique
  nodeType    QuipslyNodeType
  status      String          @default("draft")
  payloadJson Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  outgoingEdges QuipLoreEdge[] @relation("EdgeSource")
  incomingEdges QuipLoreEdge[] @relation("EdgeTarget")

  @@index([nodeType, status])
  @@index([status, updatedAt])
}

model QuipLoreEdge {
  id           String          @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  edgeType     QuipslyEdgeType
  weight       Int             @default(0)
  metadataJson Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sourceNode QuipslyNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode QuipslyNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, edgeType])
  @@index([targetNodeId, edgeType])
}

model QuipStreamSession {
  id           String   @id @default(cuid())
  mode         String
  startedAt    DateTime @default(now())
  entrySurface String
  anonymous    Boolean  @default(true)
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  events QuipStreamEvent[]

  @@index([userId, startedAt])
}

model QuipStreamEvent {
  id           String   @id @default(cuid())
  sessionId    String
  type         String
  quoteId      String?
  mode         String
  occurredAt   DateTime @default(now())
  dwellMs      Int?
  metadataJson Json?
  createdAt    DateTime @default(now())

  session QuipStreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([quoteId, type])
}

// PhD Telemetry Tracking
// Tracks viewership drop-off over time for each parsed video
model RetentionTelemetry {
  id            String   @id @default(cuid())
  videoId       String
  segmentIndex  Int
  timestamp     Int
  retentionRate Float
  cohortId      String?
  createdAt     DateTime @default(now())

  @@index([videoId])
}

// Professional Podcast Hosting & Demographics
model PodcastEpisode {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  audioUrl        String
  audioSizeBytes  Int
  durationSeconds Int
  episodeType     String   @default("full") // full, bonus, trailer
  season          Int?
  episodeNumber   Int?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  downloads PodcastDownloadLog[]
}

model PodcastDownloadLog {
  id        String   @id @default(cuid())
  episodeId String
  userAgent String
  ipHash    String
  country   String   @default("US")
  city      String?
  timestamp DateTime @default(now())

  episode PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([timestamp])
}

// Social Media Command Center
model SocialAccount {
  id           String   @id @default(cuid())
  platform     String // youtube, instagram, tiktok, linkedin
  handle       String
  accessToken  String
  refreshToken String?
  userId       String
  createdAt    DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@unique([platform, handle])
}

model SocialPost {
  id            String    @id @default(cuid())
  accountId     String
  content       String
  mediaUrl      String?
  scheduledFor  DateTime?
  publishedAt   DateTime?
  status        String    @default("draft") // draft, scheduled, published, failed
  analyticsJson Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status, scheduledFor])
}

model StudioMediaAsset {
  id            String  @id @default(cuid())
  filename      String
  url           String
  mimeType      String?
  sizeBytes     BigInt?
  isProxy       Boolean @default(false)
  rawAssetId    String? // If this is a proxy, points to the original raw StudioMediaAsset
  cloudProvider String  @default("gcs")
  isGlobal      Boolean @default(false)

  // New Video Metadata
  duration     Float?
  resolution   String?
  fps          Float?
  thumbnailUrl String?
  mediaBinId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects                      StudioProject[]
  mediaBin                      MediaBin?                                   @relation(fields: [mediaBinId], references: [id], onDelete: SetNull)
  clips                         MediaClip[]
  mediaTags                     StudioMediaTag[]
  assetAttachments              StudioAssetAttachment[]
  variants                      StudioAssetVariant[]
  processingJobs                StudioAssetProcessingJob[]
  audioMasterReviews            StudioAudioMasterReviewReceipt[]
  audioMasterPromotions         StudioAudioMasterPromotionReceipt[]
  audioDeliveryReviews          StudioAudioDeliveryReviewReceipt[]
  episodeProgramDeliveryReviews StudioEpisodeProgramDeliveryReviewReceipt[]
  episodeAudioDecisions         StudioEpisodeAudioTrackDecisionReceipt[]
  dialogueRepairCandidates      StudioDialogueRepairCandidate[]
  dialogueRepairReviews         StudioDialogueRepairReviewReceipt[]
  dialogueRepairAuditions       StudioDialogueRepairAuditionReceipt[]
  audibleEventAnalyses          StudioAudibleEventAnalysisReceipt[]
  audibleEventReviews           StudioAudibleEventReviewReceipt[]
  audibleEventTruthReceipts     StudioAudibleEventTruthReceipt[]
  sourceUnits                   StudioSourceUnit[]
  workflowJobs                  StudioWorkflowJob[]
  transcriptJobs                TranscriptJob[]
  transcriptVerifications       TranscriptSegmentVerification[]
  mediaSourceRevisions          StudioMediaSourceRevision[]
  sourceCollectionItems         StudioSourceCollectionItem[]

  @@index([createdAt])
  @@index([mediaBinId])
  @@index([isGlobal])
}

model MediaBin {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssets StudioMediaAsset[]

  @@index([projectId])
}

model StudioMediaTag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  color       String   @default("#8c6b4a")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mediaAssets StudioMediaAsset[]
  mediaClips  MediaClip[]

  @@index([slug])
}

model MediaClip {
  id           String   @id @default(cuid())
  mediaAssetId String
  title        String
  description  String?
  inTimecode   Float
  outTimecode  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaAsset StudioMediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaTags  StudioMediaTag[]
  tags       StudioTag[]

  @@index([mediaAssetId])
}

// Agent Control Center
model AgentNode {
  id                  String                     @id @default(cuid())
  hostName            String                     @unique
  ipAddress           String
  status              String                     @default("offline")
  capabilities        Json
  lastHeartbeatAt     DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  agentTasks          AgentTask[]
  mediaSourceReplicas StudioMediaSourceReplica[] @relation("StudioMediaSourceReplicaCustodian")
  mediaDerivatives    StudioMediaDerivative[]    @relation("StudioMediaDerivativeCustodian")
}

model QuipslyAgent {
