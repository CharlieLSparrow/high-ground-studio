model SocialPost {
  id            String    @id @default(cuid())
  accountId     String
  content       String
  mediaUrl      String?
  scheduledFor  DateTime?
  publishedAt   DateTime?
  status        String    @default("draft") // draft, scheduled, published, failed
  analyticsJson Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status, scheduledFor])
}

model StudioMediaAsset {
  id            String  @id @default(cuid())
  filename      String
  url           String
  mimeType      String?
  sizeBytes     BigInt?
  isProxy       Boolean @default(false)
  rawAssetId    String? // If this is a proxy, points to the original raw StudioMediaAsset
  cloudProvider String  @default("gcs")
  isGlobal      Boolean @default(false)

  // New Video Metadata
  duration     Float?
  resolution   String?
  fps          Float?
  thumbnailUrl String?
  mediaBinId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects                StudioProject[]
  mediaBin                MediaBin?                        @relation(fields: [mediaBinId], references: [id], onDelete: SetNull)
  clips                   MediaClip[]
  mediaTags               StudioMediaTag[]
  assetAttachments        StudioAssetAttachment[]
  variants                StudioAssetVariant[]
  processingJobs          StudioAssetProcessingJob[]
  audioMasterReviews      StudioAudioMasterReviewReceipt[]
  sourceUnits             StudioSourceUnit[]
  workflowJobs            StudioWorkflowJob[]
  transcriptJobs          TranscriptJob[]
  transcriptVerifications TranscriptSegmentVerification[]

  @@index([createdAt])
  @@index([mediaBinId])
  @@index([isGlobal])
}

model MediaBin {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     StudioProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssets StudioMediaAsset[]

  @@index([projectId])
}

model StudioMediaTag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  color       String   @default("#8c6b4a")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mediaAssets StudioMediaAsset[]
  mediaClips  MediaClip[]

  @@index([slug])
}

model MediaClip {
  id           String   @id @default(cuid())
  mediaAssetId String
  title        String
  description  String?
  inTimecode   Float
  outTimecode  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaAsset StudioMediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaTags  StudioMediaTag[]
  tags       StudioTag[]

  @@index([mediaAssetId])
}

// Agent Control Center
model AgentNode {
  id              String      @id @default(cuid())
  hostName        String      @unique
  ipAddress       String
