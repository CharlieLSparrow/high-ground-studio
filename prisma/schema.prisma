model CalendarCollection {
  id                 String                       @id @default(cuid())
  connectionId       String?
  workspaceId        String?
  nestId             String?
  ownerUserId        String?
  purpose            CalendarCollectionPurpose
  displayName        String
  timezone           String                       @default("UTC")
  providerCalendarId String?
  visibility         CalendarCollectionVisibility @default(PRIVATE)
  isDefault          Boolean                      @default(false)
  status             CalendarCollectionStatus     @default(ACTIVE)
  liveUpdatesEnabled Boolean                      @default(false)
  metadataJson       Json                         @default("{}")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  connection           CalendarConnection?           @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  workspace            StudioWorkspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nest                 StudioProject?                @relation(fields: [nestId], references: [id], onDelete: Cascade)
  owner                User?                         @relation("CalendarCollectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  projections          CalendarProjection[]
  cursor               CalendarSyncCursor?
  receipts             CalendarSyncReceipt[]
  feeds                CalendarFeed[]
  notificationChannels CalendarNotificationChannel[]
  reconciliationWakes  CalendarReconciliationWake[]

  @@unique([connectionId, providerCalendarId])
  @@index([workspaceId, purpose, status])
  @@index([nestId, purpose, status])
  @@index([ownerUserId, purpose, status])
  @@index([connectionId, status])
  @@index([purpose, isDefault])
}

model CalendarNotificationChannel {
