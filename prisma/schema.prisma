  clientUser       User?            @relation("BookingHoldClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  convertedBooking CoachingBooking? @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)

  @@index([offeringId, status, expiresAt])
  @@index([coachProfileId, scheduledStart])
  @@index([clientUserId, createdAt])
  @@index([status, expiresAt])
