require "fileutils"
require "digest"
require "json"
require "open3"
require "tmpdir"
require "time"

default_platform(:ios)

CAPTURE_ROOT = File.expand_path("..", __dir__)
REPO_ROOT = File.expand_path("../../..", CAPTURE_ROOT)
PROJECT_PATH = File.join(CAPTURE_ROOT, "HighGroundCapture.xcodeproj")
SCHEME = "HighGroundCapture"
EXPORT_OPTIONS = File.join(CAPTURE_ROOT, "fastlane", "ExportOptions.plist")
ARTIFACT_VERIFIER = File.join(CAPTURE_ROOT, "scripts", "verify-release-artifact.sh")
SOURCE_VERIFIER = File.join(CAPTURE_ROOT, "scripts", "verify-release-source.sh")
APPLE_APP_ID = "6780995957"
APP_IDENTIFIER = "com.highgroundodyssey.HighGroundCapture"
UI_TEST_PLANNER = File.join(REPO_ROOT, "scripts", "release", "quipsly-capture-ui-test-plan.mjs")
DEFAULT_FULL_UI_TEST_SHARDS = 4
IPAD_UI_TEST_SELECTORS = [
  "HighGroundCaptureUITests/CaptureExperienceUITests/testRegularWidthIPadUsesANativeWorkspaceSidebar",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testPrivateVoiceNoteOpensCaptureWithoutMeetingPaperworkOnRegularWidthIPad",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testConsentNeededNextEpisodeOpensRecorderWithoutCrashingOnRegularWidthIPad",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testClientCoachingFormDraftSurvivesRelaunchOnRegularWidthIPad",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testRecorderLeadsWithAStandardCallGreenRoomOnRegularWidthIPad",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testVoiceWritingRecordsAndStopsThroughTheSourceFirstPathOnRegularWidthIPad",
  "HighGroundCaptureUITests/CaptureExperienceUITests/testAudioInterruptionPausesAndRequiresExplicitResumeOnRegularWidthIPad",
].freeze

def capture_ui_execution_groups(selectors, default_device:)
  ipad_selectors, iphone_selectors = selectors.partition { |selector| IPAD_UI_TEST_SELECTORS.include?(selector) }
  groups = []
  groups << { slug: "iphone", device: default_device, selectors: iphone_selectors } unless iphone_selectors.empty?
  groups << {
    slug: "ipad",
    device: ENV.fetch("QUIPSLY_CAPTURE_UI_TEST_IPAD_DEVICE", "iPad Air 13-inch (M3)"),
    selectors: ipad_selectors,
  } unless ipad_selectors.empty?
  groups
end

def capture_simulator_destination(device_name)
  stdout, stderr, status = Open3.capture3(
    "xcrun",
    "simctl",
    "list",
    "devices",
    "available",
    "--json",
  )
  UI.user_error!("Could not enumerate available simulators: #{stderr.strip}") unless status.success?

  candidates = JSON.parse(stdout).fetch("devices").flat_map do |runtime, devices|
    devices.filter_map do |device|
      next unless device.fetch("name") == device_name && device.fetch("isAvailable", true)

      {
        runtime: runtime,
        runtime_version: runtime.scan(/\d+/).map(&:to_i),
        udid: device.fetch("udid"),
      }
    end
  end
  UI.user_error!("No available simulator exactly matches '#{device_name}'.") if candidates.empty?

  selected = candidates.max_by { |candidate| candidate.fetch(:runtime_version) }
  {
    udid: selected.fetch(:udid),
    destination: "platform=iOS Simulator,id=#{selected.fetch(:udid)}",
  }
rescue JSON::ParserError, KeyError => error
  UI.user_error!("Available simulator inventory is invalid: #{error.message}")
end

def capture_ui_test_plan(suite:, shard:, shards:)
  stdout, stderr, status = Open3.capture3(
    "node",
    UI_TEST_PLANNER,
    "--suite=#{suite}",
    "--shard=#{shard}",
    "--shards=#{shards}",
  )
  UI.user_error!("Capture UI test planner failed: #{stderr.strip}") unless status.success?
  plan = JSON.parse(stdout)
  UI.user_error!("Capture UI test planner returned no selectors.") if plan.fetch("selectors", []).empty?
  plan
rescue JSON::ParserError => error
  UI.user_error!("Capture UI test planner returned invalid JSON: #{error.message}")
end

def write_ui_test_evidence_manifest(path, manifest)
  temporary_path = "#{path}.tmp-#{Process.pid}"
  File.write(temporary_path, JSON.pretty_generate(manifest) + "\n")
  File.chmod(0o600, temporary_path)
  FileUtils.mv(temporary_path, path)
ensure
  FileUtils.rm_f(temporary_path) if defined?(temporary_path)
end

def capture_ui_xcresult_summary(path)
  stdout, stderr, status = Open3.capture3(
    "xcrun",
    "xcresulttool",
    "get",
    "test-results",
    "summary",
    "--path",
    path,
    "--format",
    "json",
  )
  UI.user_error!("Could not inspect Capture UI result bundle: #{stderr.strip}") unless status.success?
  summary = JSON.parse(stdout)
  {
    result: summary.fetch("result"),
    totalTestCount: Integer(summary.fetch("totalTestCount")),
    passedTests: Integer(summary.fetch("passedTests")),
    failedTests: Integer(summary.fetch("failedTests")),
    skippedTests: Integer(summary.fetch("skippedTests")),
    expectedFailures: Integer(summary.fetch("expectedFailures")),
  }
rescue JSON::ParserError, KeyError, ArgumentError => error
  UI.user_error!("Capture UI result summary is invalid: #{error.message}")
end

def verify_capture_ui_xcresult(path, expected_test_count = nil)
  summary = capture_ui_xcresult_summary(path)
  UI.user_error!("Capture UI result bundle did not pass.") unless summary[:result] == "Passed"
  UI.user_error!("Capture UI result bundle contains failed, skipped, or expected-failure tests.") unless
    summary[:failedTests].zero? && summary[:skippedTests].zero? && summary[:expectedFailures].zero?
  if expected_test_count
    UI.user_error!("Capture UI result bundle test count does not match its planned selectors.") unless
      summary[:totalTestCount] == expected_test_count && summary[:passedTests] == expected_test_count
  end
  summary
end

def verify_ui_test_evidence_path(path, expected_source_revision: nil, require_full: true, allow_legacy: false)
  expanded_path = File.expand_path(path.to_s)
  if File.directory?(expanded_path) && File.file?(File.join(expanded_path, "Info.plist"))
    UI.user_error!(
      "Legacy direct result bundles cannot authorize sealed upload because they do not prove source or complete selector coverage. Re-run candidate qualification.",
    ) unless allow_legacy
    verify_capture_ui_xcresult(expanded_path)
    return expanded_path
  end

  UI.user_error!("Qualified UI evidence manifest is unavailable: #{expanded_path}") unless File.file?(expanded_path)
  manifest = JSON.parse(File.read(expanded_path))
  UI.user_error!("Unsupported UI evidence schema.") unless manifest["schema"] == "quipsly-capture-ui-test-evidence-v1"
  if expected_source_revision && manifest["sourceRevision"] != expected_source_revision
    UI.user_error!("UI evidence source does not match the qualified candidate.")
  end
  suite = manifest.fetch("suite")
  UI.user_error!("UI evidence suite must be critical or full.") unless ["critical", "full"].include?(suite)
  UI.user_error!("Complete UI evidence must record the full suite.") if require_full && suite != "full"
  shards = manifest.fetch("shards", [])
  UI.user_error!("UI evidence shard count is inconsistent.") unless shards.length == manifest["shardCount"]
  shard_numbers = shards.map { |shard| Integer(shard.fetch("shard")) }
  UI.user_error!("UI evidence contains duplicate shard identities.") unless shard_numbers.uniq.length == shard_numbers.length
  selected_tests = shards.flat_map { |shard| shard.fetch("selectors", []) }
  UI.user_error!("UI evidence contains duplicate or omitted selectors.") unless
    selected_tests.length == manifest["selectedTestCount"] && selected_tests.uniq.length == selected_tests.length
  configured_shard_count = Integer(manifest.fetch("configuredShardCount"))
  retry_limit = Integer(manifest.fetch("testRetryLimit"))
  UI.user_error!("Capture UI retry limit must be zero or one.") unless (0..1).cover?(retry_limit)
  expected_plans = if suite == "full"
    (1..configured_shard_count).map do |shard_number|
      capture_ui_test_plan(suite: "full", shard: shard_number, shards: configured_shard_count)
    end
  else
    UI.user_error!("Critical UI evidence must contain exactly one shard.") unless configured_shard_count == 1 && shards.length == 1
    [capture_ui_test_plan(suite: "critical", shard: 1, shards: 1)]
  end
  expected_shard_numbers = expected_plans.map { |plan| Integer(plan.fetch("shard")) }
  UI.user_error!("UI evidence contains an invalid shard identity.") unless
    (shard_numbers - expected_shard_numbers).empty?
  if require_full
    UI.user_error!("Complete UI evidence omitted one or more configured shards.") unless
      shard_numbers.sort == expected_shard_numbers.sort
    UI.user_error!("Complete UI evidence did not cover every discovered deterministic test.") unless
      manifest["selectedTestCount"] == manifest["discoveredTestCount"]
  end
  recorded_plans = expected_plans.select do |plan|
    shard_numbers.include?(Integer(plan.fetch("shard")))
  end
  expected_tests = recorded_plans.flat_map { |plan| plan.fetch("selectors") }
  UI.user_error!("UI evidence does not match the current source-derived plan.") unless
    manifest["discoveredTestCount"] == expected_plans.fetch(0).fetch("discoveredTestCount") &&
      selected_tests.sort == expected_tests.sort
  shards.each do |shard|
    expected_plan = recorded_plans.find do |plan|
      Integer(plan.fetch("shard")) == Integer(shard.fetch("shard"))
    end
    UI.user_error!("UI shard selectors do not match their source-derived partition.") unless
      shard.fetch("selectors").sort == expected_plan.fetch("selectors").sort
    UI.user_error!("Capture UI shard retry policy is inconsistent.") unless shard.fetch("testRetryLimit") == retry_limit
    executions = shard["executions"]
    if executions
      execution_selectors = executions.flat_map { |execution| execution.fetch("selectors") }
      UI.user_error!("UI shard #{shard.fetch("shard")} execution coverage is inconsistent.") unless
        execution_selectors.sort == shard.fetch("selectors").sort &&
          execution_selectors.uniq.length == execution_selectors.length
      executions.each do |execution|
        result_bundle_path = File.expand_path(execution.fetch("resultBundlePath"), File.dirname(expanded_path))
        UI.user_error!("UI shard #{shard.fetch("shard")} execution result bundle is unavailable.") unless
          File.directory?(result_bundle_path) && File.file?(File.join(result_bundle_path, "Info.plist"))
        summary = verify_capture_ui_xcresult(result_bundle_path, execution.fetch("selectors").length)
        UI.user_error!("UI shard #{shard.fetch("shard")} execution result summary changed.") unless
          execution.fetch("resultSummary") == summary.transform_keys(&:to_s)
      end
    else
      result_bundle_path = File.expand_path(shard.fetch("resultBundlePath"), File.dirname(expanded_path))
      UI.user_error!("UI shard #{shard.fetch("shard")} result bundle is unavailable.") unless
        File.directory?(result_bundle_path) && File.file?(File.join(result_bundle_path, "Info.plist"))
      summary = verify_capture_ui_xcresult(result_bundle_path, shard.fetch("selectors").length)
      recorded_summary = shard.fetch("resultSummary")
      UI.user_error!("UI shard #{shard.fetch("shard")} recorded result summary changed.") unless
        recorded_summary == summary.transform_keys(&:to_s)
    end
  end
  expanded_path
rescue JSON::ParserError, KeyError, ArgumentError, TypeError => error
  UI.user_error!("Qualified UI evidence manifest is invalid: #{error.message}")
end

def release_paths(options)
  version = get_version_number(xcodeproj: PROJECT_PATH, target: SCHEME)
  build = get_build_number(xcodeproj: PROJECT_PATH)
  base_root = File.expand_path(options[:output_directory] || ENV.fetch("QUIPSLY_CAPTURE_RELEASE_DIR", "/tmp/quipsly-capture-release"))
  source_revision = ENV["QUIPSLY_CAPTURE_SOURCE_REVISION"].to_s
  release_run_id = ENV["QUIPSLY_CAPTURE_RELEASE_RUN_ID"].to_s
  root = source_revision.empty? ? base_root : File.join(base_root, source_revision[0, 12])
  root = File.join(root, release_run_id) unless release_run_id.empty?
  stem = "QuipslyCapture-#{version}.#{build}"

  {
    version: version,
    build: build,
    output_directory: root,
    archive_path: File.join(root, "#{stem}.xcarchive"),
    export_directory: File.join(root, "app-store-export"),
    output_name: "#{stem}.ipa",
    ipa_path: File.join(root, "#{stem}.ipa"),
  }
end

def release_receipt_path(paths)
  File.join(
    paths[:output_directory],
    "QuipslyCapture-#{paths[:version]}.#{paths[:build]}-release-receipt.json",
  )
end

def capture_derived_data_path(default_root, lane_name, source_label: "", run_id: "")
  configured_root = ENV["QUIPSLY_CAPTURE_DERIVED_DATA_DIR"].to_s.strip
  if configured_root.empty?
    return File.expand_path(File.join(default_root, "DerivedData", lane_name))
  end

  path_segments = [configured_root]
  path_segments << source_label unless source_label.to_s.empty?
  path_segments << run_id unless run_id.to_s.empty?
  path_segments << lane_name
  File.expand_path(File.join(*path_segments))
end

def write_release_receipt(receipt_path, receipt)
  temporary_path = "#{receipt_path}.tmp-#{Process.pid}"
  File.write(temporary_path, JSON.pretty_generate(receipt) + "\n")
  File.chmod(0o600, temporary_path)
  FileUtils.mv(temporary_path, receipt_path)
ensure
  FileUtils.rm_f(temporary_path) if defined?(temporary_path)
end

def update_release_receipt(paths)
  receipt_path = release_receipt_path(paths)
  receipt = JSON.parse(File.read(receipt_path))
  yield(receipt)
  write_release_receipt(receipt_path, receipt)
  receipt_path
end

def write_unqualified_release_receipt(paths, source_revision:, source_isolation:, release_run_id:, built_at: Time.now.utc.iso8601)
  receipt_path = release_receipt_path(paths)
  write_release_receipt(
    receipt_path,
    {
      schema: "quipsly-capture-release-receipt-v1",
      builtAt: built_at,
      sourceRevision: source_revision,
      sourceIsolation: source_isolation,
      releaseRunID: release_run_id,
      version: paths[:version],
      build: paths[:build],
      archivePath: paths[:archive_path],
      ipaPath: paths[:ipa_path],
      ipaBytes: File.size(paths[:ipa_path]),
      ipaSHA256: Digest::SHA256.file(paths[:ipa_path]).hexdigest,
      candidateQualified: false,
      deterministicUITestPerformed: false,
      uiTestEvidencePath: nil,
      uploadAttempted: false,
      uploadPerformed: false,
      uploadOutcome: "not-attempted",
      buildProcessingWaitReturned: false,
      testerAssignmentPerformed: false,
      physicalTestFlightInstallReadbackPerformed: false,
    },
  )
  receipt_path
end

def recover_candidate_receipt(archive_path, ipa_path, source_revision)
  UI.user_error!("Set archive_path to an existing Capture xcarchive.") if archive_path.to_s.empty?
  UI.user_error!("Set ipa_path to its existing Capture IPA.") if ipa_path.to_s.empty?
  UI.user_error!("Set candidate_revision to the exact archived source commit.") if source_revision.to_s.empty?
  UI.user_error!("Candidate source revision is invalid.") unless source_revision.match?(/\A[0-9a-f]{40}\z/)
  UI.user_error!("Candidate source commit is unavailable in this repository.") unless
    system("git", "-C", REPO_ROOT, "cat-file", "-e", "#{source_revision}^{commit}", out: File::NULL, err: File::NULL)
  UI.user_error!("Recovery tooling must descend from the candidate source commit.") unless
    system("git", "-C", REPO_ROOT, "merge-base", "--is-ancestor", source_revision, "HEAD", out: File::NULL, err: File::NULL)

  expanded_archive_path = File.realpath(File.expand_path(archive_path))
  expanded_ipa_path = File.realpath(File.expand_path(ipa_path))
  output_directory = File.dirname(expanded_archive_path)
  UI.user_error!("Recovered archive and IPA must be colocated.") unless File.dirname(expanded_ipa_path) == output_directory
  UI.user_error!("Recovered artifact directory is not scoped to the candidate source.") unless
    File.basename(File.dirname(output_directory)) == source_revision[0, 12]

  archive_match = File.basename(expanded_archive_path).match(
    /\AQuipslyCapture-(\d+(?:\.\d+){1,2})\.(\d+)\.xcarchive\z/,
  )
  UI.user_error!("Recovered archive name does not encode a valid version and build.") if archive_match.nil?
  version = archive_match[1]
  build = archive_match[2]
  stem = "QuipslyCapture-#{version}.#{build}"
  UI.user_error!("Recovered IPA name does not match its archive.") unless File.basename(expanded_ipa_path) == "#{stem}.ipa"

  paths = {
    version: version,
    build: build,
    output_directory: output_directory,
    archive_path: expanded_archive_path,
    ipa_path: expanded_ipa_path,
  }
  receipt_path = release_receipt_path(paths)
  UI.user_error!("Refusing to replace an existing release receipt: #{receipt_path}") if File.exist?(receipt_path)
  sh(ARTIFACT_VERIFIER, paths[:archive_path], paths[:ipa_path])
  write_unqualified_release_receipt(
    paths,
    source_revision: source_revision,
    source_isolation: "detached-worktree",
    release_run_id: File.basename(output_directory),
    built_at: File.mtime(expanded_archive_path).utc.iso8601,
  )
  UI.success("Recovered a verified, unqualified receipt without rebuilding the candidate.")
  UI.success("Release receipt: #{receipt_path}")
  receipt_path
rescue Errno::ENOENT => error
  UI.user_error!("Recovered artifact is unavailable: #{error.message}")
end

def seal_candidate_receipt(receipt_path, evidence_path)
  UI.user_error!("Set receipt_path to an unqualified Capture release receipt.") if receipt_path.to_s.empty?
  UI.user_error!("Set evidence_path to the exact full UI evidence manifest.") if evidence_path.to_s.empty?
  expanded_receipt_path = File.realpath(File.expand_path(receipt_path))
  UI.user_error!("Release receipt is not a regular file: #{expanded_receipt_path}") unless File.file?(expanded_receipt_path)
  UI.user_error!("Release receipt must not be group- or world-readable.") unless
    (File.stat(expanded_receipt_path).mode & 0o077).zero?

  receipt = JSON.parse(File.read(expanded_receipt_path))
  UI.user_error!("Unsupported release receipt schema.") unless receipt["schema"] == "quipsly-capture-release-receipt-v1"
  UI.user_error!("Candidate receipt is already qualified.") unless receipt["candidateQualified"] == false
  UI.user_error!("Candidate receipt already claims deterministic UI proof.") unless receipt["deterministicUITestPerformed"] == false
  UI.user_error!("Candidate source was not isolated.") unless receipt["sourceIsolation"] == "detached-worktree"
  UI.user_error!("A receipt with any upload attempt cannot be sealed.") unless
    receipt["uploadAttempted"] == false && receipt["uploadOutcome"] == "not-attempted"

  source_revision = receipt["sourceRevision"].to_s
  UI.user_error!("Candidate source revision is invalid.") unless source_revision.match?(/\A[0-9a-f]{40}\z/)
  UI.user_error!("Candidate source commit is unavailable in this repository.") unless
    system("git", "-C", REPO_ROOT, "cat-file", "-e", "#{source_revision}^{commit}", out: File::NULL, err: File::NULL)
  UI.user_error!("Sealing tooling must descend from the candidate source commit.") unless
    system("git", "-C", REPO_ROOT, "merge-base", "--is-ancestor", source_revision, "HEAD", out: File::NULL, err: File::NULL)

  output_directory = File.dirname(expanded_receipt_path)
  version = receipt["version"].to_s
  build = receipt["build"].to_s
  UI.user_error!("Candidate version is invalid.") unless version.match?(/\A[0-9]+(?:\.[0-9]+){1,2}\z/)
  UI.user_error!("Candidate build is invalid.") unless build.match?(/\A[0-9]+\z/)
  stem = "QuipslyCapture-#{version}.#{build}"
  paths = {
    version: version,
    build: build,
    output_directory: output_directory,
    archive_path: File.expand_path(receipt["archivePath"].to_s),
    ipa_path: File.expand_path(receipt["ipaPath"].to_s),
  }
  UI.user_error!("Release receipt is not colocated with its archive and IPA.") unless
    File.dirname(paths[:archive_path]) == output_directory && File.dirname(paths[:ipa_path]) == output_directory
  UI.user_error!("Release receipt name does not match its version and build.") unless
    File.basename(expanded_receipt_path) == "#{stem}-release-receipt.json"
  UI.user_error!("Candidate archive name does not match its receipt.") unless File.basename(paths[:archive_path]) == "#{stem}.xcarchive"
  UI.user_error!("Candidate IPA name does not match its receipt.") unless File.basename(paths[:ipa_path]) == "#{stem}.ipa"
  UI.user_error!("Candidate archive is unavailable.") unless File.directory?(paths[:archive_path])
  UI.user_error!("Candidate IPA is unavailable.") unless File.file?(paths[:ipa_path])
  UI.user_error!("Candidate IPA byte count changed.") unless File.size(paths[:ipa_path]) == receipt["ipaBytes"]
  UI.user_error!("Candidate IPA digest changed.") unless Digest::SHA256.file(paths[:ipa_path]).hexdigest == receipt["ipaSHA256"]

  verified_evidence_path = verify_ui_test_evidence_path(
    evidence_path,
    expected_source_revision: source_revision,
  )
  sh(ARTIFACT_VERIFIER, paths[:archive_path], paths[:ipa_path])

  receipt["candidateQualified"] = true
  receipt["candidateQualifiedAt"] = Time.now.utc.iso8601
  receipt["deterministicUITestPerformed"] = true
  receipt["uiTestEvidencePath"] = verified_evidence_path
  write_release_receipt(expanded_receipt_path, receipt)
  UI.success("Existing exact-source UI and signed-artifact proof sealed one candidate without rerunning either lane.")
  UI.success("Qualified release receipt: #{expanded_receipt_path}")
  expanded_receipt_path
rescue JSON::ParserError => error
  UI.user_error!("Release receipt is invalid JSON: #{error.message}")
end

def qualified_release_paths(receipt_path)
  UI.user_error!("Set receipt_path to a qualified Capture release receipt.") if receipt_path.to_s.empty?
  expanded_receipt_path = File.realpath(File.expand_path(receipt_path))
  UI.user_error!("Qualified receipt is not a regular file: #{expanded_receipt_path}") unless File.file?(expanded_receipt_path)
  UI.user_error!("Qualified receipt must not be group- or world-readable.") unless (File.stat(expanded_receipt_path).mode & 0o077).zero?

  receipt = JSON.parse(File.read(expanded_receipt_path))
  UI.user_error!("Unsupported qualified receipt schema.") unless receipt["schema"] == "quipsly-capture-release-receipt-v1"
  UI.user_error!("Candidate qualification is not recorded.") unless receipt["candidateQualified"] == true
  UI.user_error!("Deterministic UI qualification is not recorded.") unless receipt["deterministicUITestPerformed"] == true
  UI.user_error!("Candidate source was not isolated.") unless receipt["sourceIsolation"] == "detached-worktree"
  UI.user_error!("Candidate upload was already attempted; use App Store Connect readback.") unless
    receipt["uploadAttempted"] == false && receipt["uploadOutcome"] == "not-attempted"

  source_revision = receipt["sourceRevision"].to_s
  UI.user_error!("Qualified source revision is invalid.") unless source_revision.match?(/\A[0-9a-f]{40}\z/)
  UI.user_error!("Qualified source commit is unavailable in this repository.") unless
    system("git", "-C", REPO_ROOT, "cat-file", "-e", "#{source_revision}^{commit}", out: File::NULL, err: File::NULL)
  UI.user_error!("Upload tooling must descend from the qualified source commit.") unless
    system("git", "-C", REPO_ROOT, "merge-base", "--is-ancestor", source_revision, "HEAD", out: File::NULL, err: File::NULL)

  output_directory = File.dirname(expanded_receipt_path)
  version = receipt["version"].to_s
  build = receipt["build"].to_s
  UI.user_error!("Qualified receipt version is invalid.") unless version.match?(/\A[0-9]+(?:\.[0-9]+){1,2}\z/)
  UI.user_error!("Qualified receipt build is invalid.") unless build.match?(/\A[0-9]+\z/)
  stem = "QuipslyCapture-#{version}.#{build}"
  paths = {
    version: version,
    build: build,
    output_directory: output_directory,
    archive_path: File.expand_path(receipt["archivePath"].to_s),
    ipa_path: File.expand_path(receipt["ipaPath"].to_s),
  }
  UI.user_error!("Qualified receipt is not colocated with its archive and IPA.") unless
    File.dirname(paths[:archive_path]) == output_directory && File.dirname(paths[:ipa_path]) == output_directory
  UI.user_error!("Qualified receipt name does not match its version and build.") unless
    File.basename(expanded_receipt_path) == "#{stem}-release-receipt.json"
  UI.user_error!("Qualified archive name does not match its receipt.") unless File.basename(paths[:archive_path]) == "#{stem}.xcarchive"
  UI.user_error!("Qualified IPA name does not match its receipt.") unless File.basename(paths[:ipa_path]) == "#{stem}.ipa"
  UI.user_error!("Qualified archive is unavailable.") unless File.directory?(paths[:archive_path])
  UI.user_error!("Qualified IPA is unavailable.") unless File.file?(paths[:ipa_path])
  UI.user_error!("Qualified IPA byte count changed.") unless File.size(paths[:ipa_path]) == receipt["ipaBytes"]
  UI.user_error!("Qualified IPA digest changed.") unless Digest::SHA256.file(paths[:ipa_path]).hexdigest == receipt["ipaSHA256"]

  verify_ui_test_evidence_path(
    receipt["uiTestEvidencePath"],
    expected_source_revision: source_revision,
  )
  sh(ARTIFACT_VERIFIER, paths[:archive_path], paths[:ipa_path])
  UI.success("Qualified candidate receipt and packaged artifact passed upload reuse verification.")
  paths
end

def upload_capture_candidate(paths, options)
  api_key_path = options[:api_key_path] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  UI.user_error!("Set APP_STORE_CONNECT_API_KEY_PATH to a Fastlane App Store Connect API key JSON file.") if api_key_path.to_s.empty?
  expanded_api_key_path = File.expand_path(api_key_path)
  UI.user_error!("App Store Connect API key is not a regular file.") unless File.file?(expanded_api_key_path)
  UI.user_error!("App Store Connect API key must not be group- or world-readable.") unless
    (File.stat(expanded_api_key_path).mode & 0o077).zero?

  # Fastlane 2.236.1 interpolates parts of its transporter command through a
  # shell string. Retain canonical evidence on the configured volume, while
  # uploading a byte-identical copy from a path that cannot split on spaces.
  upload_staging_root = Dir.mktmpdir("quipsly-capture-upload-", "/private/tmp")
  upload_ipa_path = File.join(upload_staging_root, File.basename(paths[:ipa_path]))
  FileUtils.cp(paths[:ipa_path], upload_ipa_path)
  UI.user_error!("TestFlight staging changed the verified IPA bytes.") unless
    Digest::SHA256.file(upload_ipa_path).hexdigest == Digest::SHA256.file(paths[:ipa_path]).hexdigest

  previous_tmpdir = ENV["TMPDIR"]
  ENV["TMPDIR"] = "/private/tmp"
  begin
    update_release_receipt(paths) do |receipt|
      receipt["uploadAttempted"] = true
      receipt["uploadAttemptedAt"] = Time.now.utc.iso8601
      receipt["uploadOutcome"] = "unknown-until-app-store-connect-readback"
    end
    upload_to_testflight(
      api_key_path: expanded_api_key_path,
      ipa: upload_ipa_path,
      apple_id: APPLE_APP_ID,
      app_identifier: APP_IDENTIFIER,
      changelog: options[:changelog] || ENV["QUIPSLY_CAPTURE_WHAT_TO_TEST"],
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
    )
  ensure
    if previous_tmpdir.nil?
      ENV.delete("TMPDIR")
    else
      ENV["TMPDIR"] = previous_tmpdir
    end
    FileUtils.rm_rf(upload_staging_root)
  end
  receipt_path = update_release_receipt(paths) do |receipt|
    receipt["uploadAttempted"] = true
    receipt["uploadPerformed"] = true
    receipt["uploadReturnedAt"] = Time.now.utc.iso8601
    receipt["uploadOutcome"] = "returned-successfully"
    receipt["buildProcessingWaitReturned"] = true
    receipt["externalDistributionRequested"] = false
    receipt["externalNotificationRequested"] = false
    receipt["testerAssignmentPerformed"] = false
    receipt["physicalTestFlightInstallReadbackPerformed"] = false
  end
  UI.success("TestFlight upload and processing wait returned successfully.")
  UI.important("Tester assignment and a physical TestFlight install still require independent readback.")
  UI.success("Updated release receipt: #{receipt_path}")
  receipt_path
end

platform :ios do
  before_all do
    ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer"
  end

  desc "Validate source-level privacy and Capture release invariants"
  lane :verify do
    # Pass the verifier as an argv element instead of a shell command string.
    # Release worktrees and external artifact volumes may legitimately contain
    # spaces; string-form `sh` truncates such paths before process launch.
    sh("bash", SOURCE_VERIFIER)
  end

  desc "Independently verify a Capture UI evidence manifest or legacy result bundle"
  lane :verify_ui_evidence do |options|
    evidence_path = options[:path] || ENV["QUIPSLY_CAPTURE_UI_TEST_EVIDENCE"]
    UI.user_error!("Provide path:<manifest-or-xcresult>.") if evidence_path.to_s.empty?
    expected_source_revision = options[:source_revision] || ENV["QUIPSLY_CAPTURE_UI_TEST_SOURCE_REVISION"]
    verified_path = verify_ui_test_evidence_path(
      evidence_path,
      expected_source_revision: expected_source_revision,
      require_full: false,
      allow_legacy: true,
    )
    UI.success("Capture UI evidence independently verified: #{verified_path}")
    verified_path
  end

  desc "Run a bounded critical or complete sharded deterministic Capture UI suite"
  lane :ui_test do |options|
    source_revision = sh("git", "-C", REPO_ROOT, "rev-parse", "HEAD", log: false).strip
    capture_status = sh(
      "git",
      "-C",
      REPO_ROOT,
      "status",
      "--porcelain",
      "--",
      "apps/mobile-capture/HighGroundCapture",
      log: false,
    ).strip
    source_label = "#{source_revision[0, 12]}#{capture_status.empty? ? "" : "-dirty"}"
    test_run_id = ENV["QUIPSLY_CAPTURE_UI_TEST_RUN_ID"].to_s
    test_run_id = ENV["QUIPSLY_CAPTURE_RELEASE_RUN_ID"].to_s if test_run_id.empty?
    test_run_id = "#{Time.now.utc.strftime("%Y%m%dT%H%M%SZ")}-#{Process.pid}" if test_run_id.empty?
    explicit_output_directory = options[:output_directory]
    output_base_root = ENV["QUIPSLY_CAPTURE_UI_TEST_DIR"].to_s.strip
    output_base_root = "/tmp/quipsly-capture-ui-tests" if output_base_root.empty?
    output_root = if explicit_output_directory
      File.expand_path(explicit_output_directory)
    else
      File.expand_path(File.join(output_base_root, source_label, test_run_id))
    end
    derived_data_path = capture_derived_data_path(
      output_root,
      "ui-tests",
      source_label: source_label,
      run_id: test_run_id,
    )
    FileUtils.mkdir_p(output_root)
    FileUtils.mkdir_p(derived_data_path)
    UI.message("Capture UI evidence: #{output_root}")
    UI.message("Capture UI DerivedData: #{derived_data_path}")

    suite = (options[:suite] || ENV.fetch("QUIPSLY_CAPTURE_UI_TEST_SUITE", "critical")).to_s
    shard_count = suite == "full" ? Integer(options[:shards] || ENV.fetch("QUIPSLY_CAPTURE_UI_TEST_SHARDS", DEFAULT_FULL_UI_TEST_SHARDS)) : 1
    retry_limit = Integer(options[:test_retry_limit] || ENV.fetch("QUIPSLY_CAPTURE_UI_TEST_RETRY_LIMIT", "1"))
    UI.user_error!("Capture UI test retry limit must be zero or one.") unless (0..1).cover?(retry_limit)
    requested_shard = options[:shard] || ENV["QUIPSLY_CAPTURE_UI_TEST_SHARD"]
    shard_numbers = requested_shard.to_s.empty? ? (1..shard_count).to_a : [Integer(requested_shard)]
    evidence_shards = []

    shard_numbers.each do |shard_number|
      plan = capture_ui_test_plan(suite: suite, shard: shard_number, shards: shard_count)
      shard_root = File.join(output_root, "shard-#{shard_number}-of-#{shard_count}")
      FileUtils.mkdir_p(shard_root)
      UI.message(
        "Capture UI #{suite} shard #{shard_number}/#{shard_count}: " \
        "#{plan.fetch("selectedTestCount")} tests, estimated weight #{plan.fetch("estimatedWeight")}",
      )
      execution_groups = capture_ui_execution_groups(
        plan.fetch("selectors"),
        default_device: options[:device] || ENV.fetch("QUIPSLY_CAPTURE_UI_TEST_DEVICE", "iPhone 17 Pro"),
      )
      execution_records = execution_groups.map do |execution|
        execution_root = File.join(shard_root, execution.fetch(:slug))
        FileUtils.mkdir_p(execution_root)
        UI.message(
          "Capture UI #{suite} shard #{shard_number}/#{shard_count} #{execution.fetch(:slug)}: " \
          "#{execution.fetch(:selectors).length} tests on #{execution.fetch(:device)}",
        )
        run_options = {
          project: PROJECT_PATH,
          scheme: SCHEME,
          only_testing: execution.fetch(:selectors),
          parallel_testing: false,
          # Full qualification runs for close to an hour. Reset each dedicated
          # device before its execution so simulator state cannot leak between
          # otherwise independent evidence bundles.
          reset_simulator: suite == "full",
          reinstall_app: true,
          app_identifier: APP_IDENTIFIER,
          result_bundle: true,
          output_directory: execution_root,
          derived_data_path: derived_data_path,
          buildlog_path: execution_root,
          fail_build: true,
          number_of_retries: retry_limit,
        }
        if execution.fetch(:slug) == "ipad"
          simulator = capture_simulator_destination(execution.fetch(:device))
          run_options[:destination] = simulator.fetch(:destination)
          run_options[:skip_detect_devices] = true
          # Scan 2.236.1 assumes its name-based device inventory exists when
          # reinstall_app is enabled, even with an explicit destination. The
          # exact simulator is erased below, and xcodebuild installs the test
          # host itself, so avoid that broken and redundant pre-uninstall.
          run_options[:reinstall_app] = false
          if suite == "full"
            system("xcrun", "simctl", "shutdown", simulator.fetch(:udid), out: File::NULL, err: File::NULL)
            sh("xcrun", "simctl", "erase", simulator.fetch(:udid))
          end
        else
          run_options[:devices] = [execution.fetch(:device)]
        end
        run_tests(**run_options)
        result_bundles = Dir[File.join(execution_root, "*.xcresult")].select { |path| File.directory?(path) }
        UI.user_error!(
          "Expected exactly one UI result bundle in #{execution_root}; found #{result_bundles.length}.",
        ) unless result_bundles.length == 1
        result_bundle_path = File.expand_path(result_bundles.fetch(0))
        result_summary = verify_capture_ui_xcresult(result_bundle_path, execution.fetch(:selectors).length)
        {
          device: execution.fetch(:device),
          selectors: execution.fetch(:selectors),
          resultBundlePath: result_bundle_path,
          resultSummary: result_summary.transform_keys(&:to_s),
        }
      end
      evidence_shards << {
        shard: shard_number,
        selectors: plan.fetch("selectors"),
        executions: execution_records,
        testRetryLimit: retry_limit,
      }
    end

    plans = shard_numbers.map { |number| capture_ui_test_plan(suite: suite, shard: number, shards: shard_count) }
    manifest_path = File.join(output_root, "quipsly-capture-ui-test-evidence.json")
    write_ui_test_evidence_manifest(
      manifest_path,
      {
        schema: "quipsly-capture-ui-test-evidence-v1",
        createdAt: Time.now.utc.iso8601,
        sourceRevision: source_revision,
        sourceLabel: source_label,
        suite: suite,
        shardCount: shard_numbers.length,
        configuredShardCount: shard_count,
        testRetryLimit: retry_limit,
        discoveredTestCount: plans.fetch(0).fetch("discoveredTestCount"),
        selectedTestCount: plans.sum { |plan| plan.fetch("selectedTestCount") },
        shards: evidence_shards,
      },
    )
    verify_ui_test_evidence_path(
      manifest_path,
      expected_source_revision: source_revision,
      require_full: suite == "full" && requested_shard.to_s.empty?,
    )
    UI.success("Deterministic Capture UI evidence manifest: #{manifest_path}")
    manifest_path
  end

  desc "Build, export, and inspect the exact committed Capture version"
  lane :release do |options|
    verify
    capture_status = sh(
      "git",
      "-C",
      REPO_ROOT,
      "status",
      "--porcelain",
      "--",
      "apps/mobile-capture/HighGroundCapture",
      log: false,
    ).strip
    UI.user_error!("Commit the Capture release slice before archiving:\n#{capture_status}") unless capture_status.empty?

    source_revision = sh("git", "-C", REPO_ROOT, "rev-parse", "HEAD", log: false).strip
    expected_revision = ENV["QUIPSLY_CAPTURE_SOURCE_REVISION"].to_s
    if !expected_revision.empty? && expected_revision != source_revision
      UI.user_error!(
        "Release worktree is at #{source_revision}, not requested revision #{expected_revision}.",
      )
    end
    ENV["QUIPSLY_CAPTURE_SOURCE_REVISION"] = source_revision
    paths = release_paths(options)
    source_label = ENV["QUIPSLY_CAPTURE_SOURCE_REVISION"].to_s[0, 12]
    release_run_id = ENV["QUIPSLY_CAPTURE_RELEASE_RUN_ID"].to_s
    derived_data_path = capture_derived_data_path(
      paths[:output_directory],
      "archive",
      source_label: source_label,
      run_id: release_run_id,
    )
    FileUtils.mkdir_p(paths[:output_directory])
    FileUtils.mkdir_p(derived_data_path)
    UI.message("Capture archive DerivedData: #{derived_data_path}")

    build_app(
      project: PROJECT_PATH,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      archive_path: paths[:archive_path],
      output_directory: paths[:output_directory],
      derived_data_path: derived_data_path,
      output_name: paths[:output_name],
      xcargs: "-allowProvisioningUpdates",
      skip_package_ipa: true,
    )

    FileUtils.mkdir_p(paths[:export_directory])
    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath",
      paths[:archive_path],
      "-exportPath",
      paths[:export_directory],
      "-exportOptionsPlist",
      EXPORT_OPTIONS,
      "-allowProvisioningUpdates",
    )
    exported_ipa = Dir[File.join(paths[:export_directory], "*.ipa")].first
    UI.user_error!("Xcode export did not produce an IPA in #{paths[:export_directory]}") if exported_ipa.to_s.empty?
    FileUtils.mv(exported_ipa, paths[:ipa_path])

    receipt_path = write_unqualified_release_receipt(
      paths,
      source_revision: source_revision,
      source_isolation: ENV["QUIPSLY_CAPTURE_RELEASE_ISOLATED"] == "1" ? "detached-worktree" : "current-worktree",
      release_run_id: ENV["QUIPSLY_CAPTURE_RELEASE_RUN_ID"],
    )
    sh(ARTIFACT_VERIFIER, paths[:archive_path], paths[:ipa_path])
    UI.success("Verified Quipsly Capture #{paths[:version]} (#{paths[:build]}) at #{paths[:ipa_path]}")
    UI.success("Release receipt: #{receipt_path}")
  end

  desc "Run deterministic UI tests, build, export, and verify without uploading"
  lane :candidate do |options|
    unless ENV["QUIPSLY_CAPTURE_RELEASE_ISOLATED"] == "1"
      UI.user_error!(
        "Candidate qualification must use scripts/release/quipsly-capture-release-from-commit.sh from an exact committed revision.",
      )
    end

    ui_test_evidence_path = ui_test(device: options[:device], suite: "full")
    release(options)
    paths = release_paths(options)
    receipt_path = update_release_receipt(paths) do |receipt|
      receipt["candidateQualified"] = true
      receipt["candidateQualifiedAt"] = Time.now.utc.iso8601
      receipt["deterministicUITestPerformed"] = true
      receipt["uiTestEvidencePath"] = File.expand_path(ui_test_evidence_path)
    end
    UI.success("Quipsly Capture candidate qualification completed without upload.")
    UI.success("Qualified release receipt: #{receipt_path}")
    receipt_path
  end

  desc "Qualify and upload to TestFlight without silently changing the committed build number"
  lane :beta do |options|
    candidate(options)
    paths = release_paths(options)
    upload_capture_candidate(paths, options)
  end

  desc "Seal separately completed exact-source UI and signed-artifact proof as one candidate"
  lane :seal_candidate do |options|
    unless ENV["QUIPSLY_CAPTURE_RELEASE_ISOLATED"] == "1"
      UI.user_error!(
        "Candidate sealing must use scripts/release/quipsly-capture-release-from-commit.sh from an exact committed tooling revision.",
      )
    end
    receipt_path = options[:receipt_path] || ENV["QUIPSLY_CAPTURE_RELEASE_RECEIPT"]
    evidence_path = options[:evidence_path] || ENV["QUIPSLY_CAPTURE_UI_TEST_EVIDENCE"]
    seal_candidate_receipt(receipt_path, evidence_path)
  end

  desc "Recover an unqualified receipt for intact exact-source artifacts after a verifier-only failure"
  lane :recover_candidate do |options|
    unless ENV["QUIPSLY_CAPTURE_RELEASE_ISOLATED"] == "1"
      UI.user_error!(
        "Candidate recovery must use scripts/release/quipsly-capture-release-from-commit.sh from an exact committed tooling revision.",
      )
    end
    archive_path = options[:archive_path] || ENV["QUIPSLY_CAPTURE_RELEASE_ARCHIVE"]
    ipa_path = options[:ipa_path] || ENV["QUIPSLY_CAPTURE_RELEASE_IPA"]
    source_revision = options[:candidate_revision] || ENV["QUIPSLY_CAPTURE_CANDIDATE_REVISION"]
    recover_candidate_receipt(archive_path, ipa_path, source_revision)
  end

  desc "Reverify and upload a sealed qualified candidate without rebuilding it"
  lane :upload_qualified do |options|
    unless ENV["QUIPSLY_CAPTURE_RELEASE_ISOLATED"] == "1"
      UI.user_error!(
        "Qualified upload must use scripts/release/quipsly-capture-release-from-commit.sh from an exact committed revision.",
      )
    end

    receipt_path = options[:receipt_path] || ENV["QUIPSLY_CAPTURE_QUALIFIED_RECEIPT"]
    paths = qualified_release_paths(receipt_path)
    upload_capture_candidate(paths, options)
  end
end
