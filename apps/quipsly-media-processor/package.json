{
  "name": "quipsly-media-processor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:@google-cloud/storage",
    "start": "node dist/index.js",
    "start:local-episode": "node --experimental-transform-types --import ../../scripts/register-ts-extension-loader.mjs src/local-episode-worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@high-ground/quipsly-media-processing": "workspace:*",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "@types/pg": "^8.20.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.27.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
