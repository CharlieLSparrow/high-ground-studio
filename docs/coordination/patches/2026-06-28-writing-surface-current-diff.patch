+          title: index === 0 ? source.label : null,
+          body,
+          sourceLabel,
+        })),
+      },
+    },
+  });
+
+  revalidatePath(`/nests/${projectSlug}`);
+  revalidatePath(`/create`);
+  redirect(`/create?project=${encodeURIComponent(project.slug)}&document=${encodeURIComponent(document.id)}`);
